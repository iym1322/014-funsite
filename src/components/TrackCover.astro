---
// 曲の画像を表示するコンポーネント。
// public/images/works/<image>.(jpg|jpeg|png|webp) が存在すればそれを表示し、
// 無ければプレースホルダー(グラデーション+音符アイコン)を表示する。
// ビルド時にNode の fs でファイルの有無を確認しているため、実在しない画像パスを
// <img src> に書いてしまうことがない。
import fs from "node:fs";
import path from "node:path";

interface Props {
  image?: string;
  title: string;
  aspect?: "square" | "wide";
}

const { image, title, aspect = "square" } = Astro.props;

const extensions = ["jpg", "jpeg", "png", "webp"];
const worksDir = path.join(process.cwd(), "public", "images", "works");

// 空白・記号・大文字小文字・全角半角の違いを吸収して比較する。
// 例: `Hollow Hunger.jpg` とタイトル `Hollow Hunger`、
//     `オトモダチフィルム.jpg` とタイトル `オトモダチフィルム`。
function normalizeName(value: string) {
  return value
    .normalize("NFKC")
    .toLocaleLowerCase("ja")
    .replace(/[^\p{L}\p{N}]/gu, "");
}

let resolvedSrc: string | null = null;
if (image) {
  for (const ext of extensions) {
    const candidate = path.join(worksDir, `${image}.${ext}`);
    if (fs.existsSync(candidate)) {
      resolvedSrc = `/images/works/${image}.${ext}`;
      break;
    }
  }
}

// imageフィールドに対応するファイルがない場合は、画像のファイル名と
// 楽曲・作品タイトルが一致するものを自動的に使用する。
if (!resolvedSrc && fs.existsSync(worksDir)) {
  const normalizedTitle = normalizeName(title);
  const matchingFile = fs.readdirSync(worksDir).find((file) => {
    const extension = path.extname(file).slice(1).toLowerCase();
    if (!extensions.includes(extension)) return false;
    return normalizeName(path.parse(file).name) === normalizedTitle;
  });

  if (matchingFile) {
    resolvedSrc = `/images/works/${encodeURIComponent(matchingFile)}`;
  }
}
---

{resolvedSrc ? (
  <img class={`cover ${aspect}`} src={resolvedSrc} alt={title} loading="lazy" />
) : (
  <div class={`cover placeholder ${aspect}`} aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5" />
      <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </div>
)}

<style>
  .cover {
    display: block;
    width: 100%;
    object-fit: cover;
    background: linear-gradient(135deg, #e5ded3, #cfc3af);
    border-radius: 8px;
  }

  .cover.square {
    aspect-ratio: 1 / 1;
  }

  .cover.wide {
    aspect-ratio: 16 / 9;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-surface);
  }

  .placeholder svg {
    width: 30%;
    height: 30%;
    opacity: 0.7;
  }
</style>
