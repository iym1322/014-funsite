---
// サイト共通ヘッダー。実在するページのみをナビゲーションに載せる
// (未実装ページへのリンク切れを避けるため、ページ追加のたびにここも更新する)。
const navItems = [
  { href: "/", label: "トップ" },
  { href: "/profile", label: "プロフィール" },
  { href: "/works", label: "ディスコグラフィー" },
  { href: "/favorites", label: "推し曲コーナー" },
  { href: "/moments", label: "オーイシ名場面" },
  { href: "/setlists", label: "あなたのセットリスト" },
  { href: "/live-reports", label: "イベントレポート" },
  { href: "/ranking", label: "勝手にランキング" },
  { href: "/quiz", label: "オーイシ検定" },
  { href: "/minigames", label: "ミニゲーム" },
  { href: "/calendar", label: "カレンダー" },
];
---

<header class="site-header">
  <div class="container">
    <nav>
      <a class="site-title" href="/">
        <span class="brand">014 BASE</span>
        <span class="brand-sub">オーイシマサヨシ非公式ファンサイト</span>
      </a>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href}>
              {item.label}
              {item.badge && <span class="nav-badge">{item.badge}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
