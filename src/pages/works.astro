---
// ディスコグラフィー一覧ページ(カードグリッド表示)。
// 個別ページ(slug)を持つ曲のみを表示し、検索・絞り込み・並べ替え・ページネーション
// (表示件数はデフォルト24件/ページ、選択式で変更可能。件数に応じてカード=画像サイズも
// 連動して変える。Vanilla JS)に対応している。
import Layout from "../layouts/Layout.astro";
import TrackCover from "../components/TrackCover.astro";
import { tracks, groups, types, getAlbumCoverImages } from "../data/discography";

const showcased = tracks.filter((t) => t.slug);
const sorted = [...showcased].sort((a, b) => b.sortDate.localeCompare(a.sortDate));
---

<Layout title="ディスコグラフィー | 014 BASE">
  <h1>ディスコグラフィー</h1>
  <p class="note">
    曲名と画像を並べたカード形式で一覧できます。現在<strong>{showcased.length}曲</strong>を掲載中
    (画像が未設定の曲はプレースホルダーで表示されます)。まだ個別ページを作成していない曲は
    順次追加予定です。
  </p>

  <div class="controls">
    <input type="search" id="search" placeholder="曲名・作品名で検索" aria-label="検索" />

    <select id="filter-group" aria-label="名義で絞り込み">
      <option value="">名義: すべて</option>
      {groups.map((g) => <option value={g}>{g}</option>)}
    </select>

    <select id="filter-type" aria-label="種別で絞り込み">
      <option value="">種別: すべて</option>
      {types.map((t) => <option value={t}>{t}</option>)}
    </select>

    <label class="checkbox">
      <input type="checkbox" id="filter-tiein" />
      タイアップのみ
    </label>

    <select id="sort" aria-label="並べ替え">
      <option value="date-desc">リリース日(新しい順)</option>
      <option value="date-asc">リリース日(古い順)</option>
      <option value="title-asc">曲名順</option>
      <option value="group-asc">名義順</option>
    </select>

    <select id="page-size" aria-label="1ページの表示件数">
      <option value="12">12件/ページ(画像大)</option>
      <option value="24" selected>24件/ページ(標準)</option>
      <option value="48">48件/ページ(画像小)</option>
      <option value="96">96件/ページ(画像最小)</option>
      <option value="all">すべて表示</option>
    </select>
  </div>

  <p id="result-count" class="result-count"></p>

  <div class="grid" id="track-grid">
    {sorted.map((track) => {
      const searchText = [track.title, track.group, track.tieIn]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();
      return (
        <a
          class="card"
          href={`/works/${track.slug}`}
          data-date={track.sortDate}
          data-title={track.title}
          data-sort-title={track.yomi ?? track.title}
          data-group={track.group}
          data-type={track.type}
          data-tiein={track.tieIn ? "1" : "0"}
          data-search={searchText}
        >
          <TrackCover image={track.image} fallbackImages={getAlbumCoverImages(track)} title={track.title} />
          <div class="card-body">
            <p class="card-title">{track.title}</p>
            <p class="card-meta">{track.group} ・ {track.date}</p>
          </div>
        </a>
      );
    })}
  </div>

  <nav class="pagination" id="pagination" aria-label="ページ送り"></nav>

  <section>
    <h2>参照元・出典</h2>
    <ul>
      <li><a href="https://www.014014.jp/discography" target="_blank" rel="noopener noreferrer">大石昌良 / オーイシマサヨシ 公式サイト ディスコグラフィー</a></li>
      <li><a href="https://www.jvcmusic.co.jp/-/Profile/A026071.html" target="_blank" rel="noopener noreferrer">大石昌良 | プロフィール | ビクターエンタテインメント</a></li>
    </ul>
  </section>
</Layout>

<script>
  const grid = document.getElementById("track-grid") as HTMLDivElement;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>(".card"));
  const resultCount = document.getElementById("result-count") as HTMLParagraphElement;
  const pagination = document.getElementById("pagination") as HTMLElement;

  const searchInput = document.getElementById("search") as HTMLInputElement;
  const groupSelect = document.getElementById("filter-group") as HTMLSelectElement;
  const typeSelect = document.getElementById("filter-type") as HTMLSelectElement;
  const tieinCheckbox = document.getElementById("filter-tiein") as HTMLInputElement;
  const sortSelect = document.getElementById("sort") as HTMLSelectElement;
  const pageSizeSelect = document.getElementById("page-size") as HTMLSelectElement;

  // 表示件数が多いほどカード(画像)を小さくして、1ページに収まる情報量を調整する。
  const CARD_MIN_WIDTH: Record<string, string> = {
    "12": "15rem",
    "24": "11rem",
    "48": "8.5rem",
    "96": "7rem",
    all: "6.5rem",
  };

  let currentPage = 1;

  function getPageSize(): number {
    const value = pageSizeSelect.value;
    // Infinityだと (currentPage - 1) * pageSize が 0 * Infinity = NaN になるため、
    // 「すべて表示」は十分大きな有限値で代用する。
    return value === "all" ? Number.MAX_SAFE_INTEGER : Number(value);
  }

  function applyCardSize() {
    grid.style.setProperty("--card-min-width", CARD_MIN_WIDTH[pageSizeSelect.value] ?? "11rem");
  }

  function applyFiltersAndSort(resetPage = true) {
    if (resetPage) currentPage = 1;

    const query = searchInput.value.trim().toLowerCase();
    const group = groupSelect.value;
    const type = typeSelect.value;
    const tieinOnly = tieinCheckbox.checked;

    const matching: HTMLAnchorElement[] = [];
    for (const card of cards) {
      const matchesQuery = !query || card.dataset.search!.includes(query);
      const matchesGroup = !group || card.dataset.group === group;
      const matchesType = !type || card.dataset.type === type;
      const matchesTieIn = !tieinOnly || card.dataset.tiein === "1";
      const visible = matchesQuery && matchesGroup && matchesType && matchesTieIn;
      card.style.display = "none";
      if (visible) matching.push(card);
    }

    const sortValue = sortSelect.value;
    matching.sort((a, b) => {
      if (sortValue === "date-asc") return a.dataset.date!.localeCompare(b.dataset.date!);
      if (sortValue === "date-desc") return b.dataset.date!.localeCompare(a.dataset.date!);
      if (sortValue === "title-asc") return a.dataset.sortTitle!.localeCompare(b.dataset.sortTitle!, "ja");
      if (sortValue === "group-asc") return a.dataset.group!.localeCompare(b.dataset.group!, "ja");
      return 0;
    });
    for (const card of matching) grid.appendChild(card);

    const pageSize = getPageSize();
    const pageCount = Math.max(1, Math.ceil(matching.length / pageSize));
    if (currentPage > pageCount) currentPage = pageCount;

    const start = (currentPage - 1) * pageSize;
    const pageItems = matching.slice(start, start + pageSize);
    for (const card of pageItems) card.style.display = "";

    const rangeStart = matching.length === 0 ? 0 : start + 1;
    const rangeEnd = Math.min(start + pageSize, matching.length);
    resultCount.textContent = `${matching.length}件中 ${rangeStart}-${rangeEnd}件を表示`;

    renderPagination(pageCount);
  }

  function renderPagination(pageCount: number) {
    pagination.innerHTML = "";
    if (pageCount <= 1) return;

    const makeButton = (label: string, page: number, disabled = false, current = false) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = label;
      btn.disabled = disabled;
      btn.setAttribute("aria-current", current ? "page" : "false");
      btn.addEventListener("click", () => {
        currentPage = page;
        applyFiltersAndSort(false);
        grid.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      return btn;
    };

    pagination.appendChild(makeButton("← 前へ", currentPage - 1, currentPage === 1));
    for (let p = 1; p <= pageCount; p++) {
      pagination.appendChild(makeButton(String(p), p, false, p === currentPage));
    }
    pagination.appendChild(makeButton("次へ →", currentPage + 1, currentPage === pageCount));
  }

  for (const el of [searchInput, groupSelect, typeSelect, tieinCheckbox, sortSelect]) {
    el.addEventListener("input", () => applyFiltersAndSort(true));
    el.addEventListener("change", () => applyFiltersAndSort(true));
  }

  pageSizeSelect.addEventListener("change", () => {
    applyCardSize();
    applyFiltersAndSort(true);
  });

  applyCardSize();
  applyFiltersAndSort(true);
</script>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin: 1.5rem 0 0.5rem;
  }

  .controls input[type="search"] {
    flex: 1 1 12rem;
  }

  .controls input,
  .controls select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: inherit;
  }

  .checkbox {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .result-count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min-width, 11rem), 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
  }

  .card-body {
    padding-top: 0.6rem;
  }

  .card-title {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .card-meta {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .card:hover .card-title {
    color: var(--color-accent);
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .pagination button {
    min-width: 2.2rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .pagination button:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .pagination button:disabled {
    color: var(--color-text-muted);
    cursor: default;
    opacity: 0.5;
  }

  .pagination button[aria-current="page"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-surface);
    font-weight: 700;
  }
</style>
