---
// ディスコグラフィーページ(CONTENTS_PLAN.md 2-2「サイトの核となる機能」)。
// 全楽曲データは src/data/discography.ts に一元管理し、このページは
// 一覧表示・検索・絞り込み・並べ替えのUIを提供するだけにしている
// (「データを1箇所で管理→表示側は見るだけ」という方針に沿った設計)。
// 再生回数の自動取得(フェーズ2・YouTube Data API)は未実装。まずはデータ構造と
// 全曲網羅を優先し、リンクは確認できたものだけ掲載している。
import Layout from "../layouts/Layout.astro";
import { tracks, groups, types } from "../data/discography";

const sorted = [...tracks].sort((a, b) => b.sortDate.localeCompare(a.sortDate));
---

<Layout title="ディスコグラフィー | オーイシマサヨシ非公式ファンサイト">
  <h1>ディスコグラフィー</h1>
  <p class="note">
    Sound Schedule時代から現在までの音源・映像作品、他アーティストへの楽曲提供までを
    1つのデータベースとしてまとめています。曲名・作品名で検索したり、名義や種別で
    絞り込んだりできます。個人調査によるものなので抜けや誤りが残っている可能性があり、
    <span class="caution-label">要確認</span>は出典間で表記が揺れる項目です。
    YouTube・配信サービスへのリンクは確認できたものだけ掲載しており、順次追加予定です。
  </p>

  <div class="controls">
    <input type="search" id="search" placeholder="曲名・作品名で検索" aria-label="検索" />

    <select id="filter-group" aria-label="名義で絞り込み">
      <option value="">名義: すべて</option>
      {groups.map((g) => <option value={g}>{g}</option>)}
    </select>

    <select id="filter-type" aria-label="種別で絞り込み">
      <option value="">種別: すべて</option>
      {types.map((t) => <option value={t}>{t}</option>)}
    </select>

    <label class="checkbox">
      <input type="checkbox" id="filter-tiein" />
      タイアップのみ
    </label>

    <select id="sort" aria-label="並べ替え">
      <option value="date-desc">リリース日(新しい順)</option>
      <option value="date-asc">リリース日(古い順)</option>
      <option value="title-asc">曲名順</option>
      <option value="group-asc">名義順</option>
    </select>
  </div>

  <p id="result-count" class="result-count"></p>

  <div class="table-wrap">
    <table id="track-table">
      <thead>
        <tr>
          <th>日付</th>
          <th>曲名</th>
          <th>名義/提供先</th>
          <th>種別</th>
          <th>詳細</th>
          <th>リンク</th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((track) => {
          const displaySubject = track.type === "提供曲" ? track.subject : track.group;
          const detail = track.tieIn ?? track.note ?? track.role ?? "";
          const searchText = [track.title, track.group, track.subject, track.tieIn, track.role]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();
          return (
            <tr
              data-date={track.sortDate}
              data-title={track.title}
              data-group={track.group}
              data-type={track.type}
              data-tiein={track.tieIn ? "1" : "0"}
              data-search={searchText}
            >
              <td>{track.date || "-"}</td>
              <td>
                {track.title}
                {track.caution && <span class="caution-label">要確認</span>}
              </td>
              <td>{displaySubject}</td>
              <td>{track.type}</td>
              <td class="detail">{detail}</td>
              <td class="links">
                {track.youtube && <a href={track.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>}
                {track.appleMusic && <a href={track.appleMusic} target="_blank" rel="noopener noreferrer">Apple Music</a>}
                {track.spotify && <a href={track.spotify} target="_blank" rel="noopener noreferrer">Spotify</a>}
                {!track.youtube && !track.appleMusic && !track.spotify && <span class="no-link">-</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <section>
    <h2>参照元・出典</h2>
    <ul>
      <li><a href="https://www.014014.jp/discography" target="_blank" rel="noopener noreferrer">大石昌良 / オーイシマサヨシ 公式サイト ディスコグラフィー</a></li>
      <li><a href="https://www.jvcmusic.co.jp/-/Profile/A026071.html" target="_blank" rel="noopener noreferrer">大石昌良 | プロフィール | ビクターエンタテインメント</a></li>
      <li><a href="https://ja.wikipedia.org/wiki/大石昌良" target="_blank" rel="noopener noreferrer">大石昌良 - Wikipedia</a></li>
      <li><a href="https://ja.wikipedia.org/wiki/Sound_Schedule" target="_blank" rel="noopener noreferrer">Sound Schedule - Wikipedia</a></li>
      <li><a href="https://ja.wikipedia.org/wiki/OxT" target="_blank" rel="noopener noreferrer">OxT - Wikipedia</a></li>
    </ul>
  </section>
</Layout>

<script>
  // 曲データベースの検索・絞り込み・並べ替え(フレームワーク未導入のためVanilla JSで実装)。
  const table = document.getElementById("track-table") as HTMLTableElement;
  const tbody = table.querySelector("tbody") as HTMLTableSectionElement;
  const rows = Array.from(tbody.querySelectorAll("tr"));
  const resultCount = document.getElementById("result-count") as HTMLParagraphElement;

  const searchInput = document.getElementById("search") as HTMLInputElement;
  const groupSelect = document.getElementById("filter-group") as HTMLSelectElement;
  const typeSelect = document.getElementById("filter-type") as HTMLSelectElement;
  const tieinCheckbox = document.getElementById("filter-tiein") as HTMLInputElement;
  const sortSelect = document.getElementById("sort") as HTMLSelectElement;

  function applyFiltersAndSort() {
    const query = searchInput.value.trim().toLowerCase();
    const group = groupSelect.value;
    const type = typeSelect.value;
    const tieinOnly = tieinCheckbox.checked;

    let visibleCount = 0;
    for (const row of rows) {
      const matchesQuery = !query || row.dataset.search!.includes(query);
      const matchesGroup = !group || row.dataset.group === group;
      const matchesType = !type || row.dataset.type === type;
      const matchesTieIn = !tieinOnly || row.dataset.tiein === "1";
      const visible = matchesQuery && matchesGroup && matchesType && matchesTieIn;
      row.style.display = visible ? "" : "none";
      if (visible) visibleCount++;
    }

    const sortValue = sortSelect.value;
    const sortedRows = [...rows].sort((a, b) => {
      if (sortValue === "date-asc") return a.dataset.date!.localeCompare(b.dataset.date!);
      if (sortValue === "date-desc") return b.dataset.date!.localeCompare(a.dataset.date!);
      if (sortValue === "title-asc") return a.dataset.title!.localeCompare(b.dataset.title!, "ja");
      if (sortValue === "group-asc") return a.dataset.group!.localeCompare(b.dataset.group!, "ja");
      return 0;
    });
    for (const row of sortedRows) tbody.appendChild(row);

    resultCount.textContent = `${visibleCount} / ${rows.length} 件表示`;
  }

  for (const el of [searchInput, groupSelect, typeSelect, tieinCheckbox, sortSelect]) {
    el.addEventListener("input", applyFiltersAndSort);
    el.addEventListener("change", applyFiltersAndSort);
  }

  applyFiltersAndSort();
</script>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin: 1.5rem 0 0.5rem;
  }

  .controls input[type="search"] {
    flex: 1 1 12rem;
  }

  .controls input,
  .controls select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: inherit;
  }

  .checkbox {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .result-count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th, td {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  td.detail {
    white-space: normal;
    color: var(--color-text-muted);
    min-width: 14rem;
  }

  th {
    background: var(--color-surface);
    position: sticky;
    top: 0;
  }

  .links a {
    margin-right: 0.5rem;
    font-size: 0.85rem;
  }

  .no-link {
    color: var(--color-text-muted);
  }

  .caution-label {
    font-size: 0.75rem;
    color: #a3663f;
    background: #f4e8de;
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    margin-left: 0.4rem;
  }
</style>
