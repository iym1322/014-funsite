  { subject: "配信コンテンツ「PRELUDERS」", title: "ヒーローライセンス", role: "作詞・作曲・編曲" },
  { subject: "アニメ「枕男子」", title: "枕男子", role: "作詞・作曲・編曲" },
  { subject: "アニメ「Re:ゼロから始める異世界生活」", title: "ぼうやの夢よ", role: "作曲・編曲" },
];

const sources = [
  { href: "https://www.014014.jp/discography", label: "大石昌良 / オーイシマサヨシ 公式サイト ディスコグラフィー" },
  { href: "https://www.jvcmusic.co.jp/-/Profile/A026071.html", label: "大石昌良 | プロフィール | ビクターエンタテインメント" },
  { href: "https://ja.wikipedia.org/wiki/大石昌良", label: "大石昌良 - Wikipedia" },
  { href: "https://ja.wikipedia.org/wiki/Sound_Schedule", label: "Sound Schedule - Wikipedia" },
  { href: "https://ja.wikipedia.org/wiki/OxT", label: "OxT - Wikipedia" },
];
---

<Layout title="ディスコグラフィー | オーイシマサヨシ非公式ファンサイト">
  <h1>ディスコグラフィー</h1>
  <p class="note">
    「全作品の網羅」を目指し、Sound Schedule時代から現在までの音源・映像作品、
    他アーティストへの楽曲提供までをまとめています。個人調査によるものなので、
    抜けや誤りが残っている可能性があります。<span class="caution-label">要確認</span>
    の表記があるものはタイアップ先や表記の裏取りが十分にできていない項目です。
    最新・正確な情報は公式サイトをご確認ください。
  </p>

  {discographies.map((group) => (
    <section>
      <h2>{group.name}</h2>
      <p class="group-desc">{group.desc}</p>

      {group.albums.length > 0 && (
        <>
          <h3>アルバム</h3>
          <ul class="release-list">
            {group.albums.map((album) => (
              <li>
                <span class="date">{album.date}</span>
                <span class="title">{album.title}</span>
                {album.caution && <span class="caution-label">要確認</span>}
                {album.note && <span class="tie-in">{album.note}</span>}
              </li>
            ))}
          </ul>
        </>
      )}

      {group.singles.length > 0 && (
        <>
          <h3>シングル</h3>
          <ul class="release-list">
            {group.singles.map((single) => (
              <li>
                <span class="date">{single.date}</span>
                <span class="title">{single.title}</span>
                {single.caution && <span class="caution-label">要確認</span>}
                {single.tieIn && <span class="tie-in">{single.tieIn}</span>}
                {single.note && <span class="tie-in">{single.note}</span>}
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  ))}

  <section>
    <h2>ライブ映像・DVD/Blu-ray</h2>
    {videoWorks.map((group) => (
      <>
        <h3>{group.name}</h3>
        <ul class="release-list">
          {group.items.map((item) => (
            <li>
              <span class="date">{item.date}</span>
              <span class="title">{item.title}</span>
              {item.caution && <span class="caution-label">要確認</span>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section>
    <h2>他アーティストへの楽曲提供</h2>
    <p class="group-desc">作詞・作曲・編曲などで参加した他アーティスト名義の楽曲。</p>
    <ul class="credit-list">
      {artistCredits.map((credit) => (
        <li>
          <span class="subject">{credit.subject}</span>
          <span class="title">{credit.title}</span>
          <span class="role">{credit.role}</span>
        </li>
      ))}
    </ul>

    <h3>アニメ・ゲーム・舞台作品への提供曲</h3>
    <ul class="credit-list">
      {mediaCredits.map((credit) => (
        <li>
          <span class="subject">{credit.subject}</span>
          <span class="title">{credit.title}</span>
          <span class="role">{credit.role}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>参照元・出典</h2>
    <ul>
      {sources.map((source) => (
        <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .group-desc {
    color: var(--color-text-muted);
    margin-top: -0.5rem;
  }

  h3 {
    font-size: 1rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text-muted);
  }

  .release-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .release-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .release-list .date {
    flex: none;
    width: 5rem;
    color: var(--color-accent);
  }

  .release-list .title {
    font-weight: 700;
  }

  .release-list .tie-in {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    width: 100%;
    margin-left: 5rem;
  }

  .caution-label {
    font-size: 0.75rem;
    color: #a3663f;
    background: #f4e8de;
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
  }

  .credit-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .credit-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .credit-list .subject {
    flex: none;
    width: 12rem;
    color: var(--color-accent);
  }

  .credit-list .title {
    font-weight: 700;
  }

  .credit-list .role {
    color: var(--color-text-muted);
    width: 100%;
    margin-left: 12rem;
  }
</style>
