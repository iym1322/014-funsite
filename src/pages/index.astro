---
// トップページ(ワイヤーフレーム段階)。
// CONTENTS_PLAN.md 2-1 の構成案(ヒーロー / プロフィール導線 / 最新ブログ / 主要ナビ)を
// 骨組みとして実装。ブログは別リポジトリ管理のためここには含めない。
// 「最新情報」はgit commitの履歴をビルド時に読み込み、サイトの更新履歴として表示している
// (コミットメッセージの1行目=件名は、サイト閲覧者にも伝わる文面で書くこと)。
import { execSync } from "node:child_process";
import Layout from "../layouts/Layout.astro";
import TrackCover from "../components/TrackCover.astro";
import { tracks, getAlbumCoverImages } from "../data/discography";
import { rankingQuestions, resolveRankingChoices } from "../data/ranking";
import { schedule } from "../data/schedule";
import { resolveTrackCoverSrc } from "../lib/trackCover";

const mainContents = [
  { href: "/profile", label: "プロフィール", desc: "経歴・活動年表など基本情報" },
  {
    href: "/works",
    label: "ディスコグラフィー",
    desc: "楽曲・アルバム一覧",
    note: "※現在も情報を追加中です。まだ一部の作品しか記載できていません",
  },
  { href: "/favorites", label: "推し曲コーナー", desc: "好きな曲を自分の言葉で紹介" },
  { href: "/moments", label: "オーイシ名場面", desc: "YouTube動画の名場面をタイムスタンプ付きで紹介" },
  { href: "/setlists", label: "あなたのセットリスト", desc: "妄想のライブセットリストをコンセプト付きで共有" },
  { href: "/live-reports", label: "イベントレポート", desc: "参戦したライブ・イベントの記録" },
  { href: "/ranking", label: "勝手にランキング", desc: "お題ごとの投票ランキング" },
  { href: "/quiz", label: "オーイシ検定", desc: "オーイシに関する四択クイズ全50問" },
  { href: "/minigames", label: "ミニゲーム", desc: "オーイシマサヨシスロットなど、遊べるミニゲームまとめ" },
  {
    href: "/calendar",
    label: "カレンダー",
    desc: "リリース・ライブ・イベントの予定",
    note: "※現在も情報を追加中です。まだ一部の予定しか記載できていません",
  },
];

type UpdateLogEntry = { date: string; message: string };

function getUpdateLog(limit: number): UpdateLogEntry[] {
  try {
    const output = execSync(`git log -n ${limit + 5} --pretty=format:"%ad|||%s" --date=format:"%Y-%m-%d"`, {
      cwd: process.cwd(),
    }).toString();
    return output
      .split("\n")
      .filter(Boolean)
      .map((line) => {
        const [date, message] = line.split("|||");
        return { date, message };
      })
      .filter((entry) => entry.message !== "Initial commit from Astro")
      .slice(0, limit);
  } catch {
    return [];
  }
}

const updateLog = getUpdateLog(6);

const songs = tracks.filter((track) => track.slug && track.type === "シングル");

// 今日の1曲は名義ごとに1曲ずつ選び、トップページでカルーセル表示する。
// 「その日の日付」はビルド時点ではなく訪問者のブラウザ側で判定したいので、
// ここでは候補プール(名義ごとの曲一覧)だけをビルド時に用意して渡し、
// 実際にどの曲を選ぶかはクライアント側スクリプトで計算する。
const featuredGroups = ["オーイシマサヨシ", "大石昌良", "OxT", "Sound Schedule"] as const;
const featuredPool = featuredGroups
  .map((group) => ({
    group,
    songs: songs
      .filter((t) => t.group === group)
      .map((t) => ({
        slug: t.slug as string,
        title: t.title,
        group: t.group,
        date: t.date,
        description: t.description ?? t.tieIn ?? null,
        coverSrc: resolveTrackCoverSrc(t.image, t.title, getAlbumCoverImages(t)),
        youtube: t.youtube ?? null,
      })),
  }))
  .filter((g) => g.songs.length > 0);
const latestSongs = [...songs]
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate))
  .slice(0, 10);
// 開催中のランキングはお題を1つに固定せず、全お題をゆっくり自動で切り替える
// カルーセル表示にする(お題数が増えたため)。
const rankingSlides = rankingQuestions.map((q) => ({
  id: q.id,
  question: q.question,
  candidates: resolveRankingChoices(q)
    .map((c) => {
      const track = tracks.find((t) => t.slug === c.trackSlug);
      return track ? { slug: c.trackSlug, title: track.title } : null;
    })
    .filter((c): c is { slug: string; title: string } => c !== null),
}));

// 推し曲プレビュー用に、投稿がどの曲についてか解決できるよう曲名の一覧を渡しておく
// (実際の投稿一覧・得票数はSupabaseからブラウザ側で取得する。ビルド時には分からないため)。
const trackTitleLookup = tracks
  .filter((t) => t.slug)
  .map((t) => ({
    slug: t.slug as string,
    title: t.title,
    coverSrc: resolveTrackCoverSrc(t.image, t.title, getAlbumCoverImages(t)),
  }));

const today = new Date().toISOString().slice(0, 10);
const nextEvents = [...schedule]
  .filter((event) => event.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);
const eventTypeLabels = { release: "リリース", live: "ライブ", event: "イベント" };
const formatEventDate = (date: string) => {
  const [year, month, day] = date.split("-");
  return `${year}.${month}.${day}`;
};
---

<Layout title="014 BASE | オーイシマサヨシ非公式ファンサイト">
  <section class="intro">
    <div class="intro-inner">
      <p class="eyebrow">WELCOME TO 014 FAN SITE</p>
      <h1>好きな音楽を、もっと深く。その魅力を、みんなと一緒に。</h1>
      <p class="intro-lead">
        オーイシマサヨシさん・大石昌良さんの音楽を愛する個人が運営する非公式ファンサイトです。
      </p>
      <p class="intro-detail">
        楽曲やライブの記録を丁寧に集め、自分の言葉でその魅力を語りながら、
        訪れた人同士が新しい「好き」に出会える場所を目指しています。
      </p>
      <div class="intro-actions">
        <a class="cta" href="/works">音楽をたどる</a>
        <a class="text-link" href="/profile">プロフィールを見る →</a>
      </div>
    </div>
  </section>

  <section class="featured" id="featured-section">
    <div class="featured-carousel" id="featured-carousel">
      <p class="placeholder">読み込み中...</p>
    </div>
    <button type="button" class="featured-arrow prev" id="featured-prev" aria-label="前の曲" hidden>‹</button>
    <button type="button" class="featured-arrow next" id="featured-next" aria-label="次の曲" hidden>›</button>
    <div class="featured-dots" id="featured-dots" hidden></div>
  </section>

  <script type="application/json" id="featured-pool-data" set:html={JSON.stringify(featuredPool)} />

  <button type="button" class="bgm-launch-button" id="bgm-launch-button" hidden>🎵 今日のBGMを再生</button>
  <div class="bgm-widget" id="bgm-widget" hidden>
    <div class="bgm-video" id="bgm-yt-player"></div>
    <div class="bgm-info">
      <p class="bgm-eyebrow">今日のBGM(今日の1曲・4曲ループ)</p>
      <p class="bgm-title" id="bgm-current-title"></p>
      <div class="bgm-buttons">
        <button type="button" class="bgm-icon-button" id="bgm-toggle-play" aria-label="一時停止">⏸</button>
        <button type="button" class="bgm-icon-button" id="bgm-skip" aria-label="次の曲">⏭</button>
        <button type="button" class="bgm-icon-button bgm-close" id="bgm-close" aria-label="閉じる">×</button>
      </div>
    </div>
  </div>

  <section class="latest-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">NEW RELEASES</p>
        <h2>新着楽曲</h2>
      </div>
      <a href="/works">すべて見る →</a>
    </div>
    <div class="song-rail" aria-label="新着楽曲一覧">
      {latestSongs.map((track) => (
        <a class="song-card" href={`/works/${track.slug}`}>
          <TrackCover image={track.image} fallbackImages={getAlbumCoverImages(track)} title={track.title} />
          <strong>{track.title}</strong>
          <span>{track.group} ・ {track.date}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="community-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">FAN VOICES</p>
        <h2>みんなの推し曲</h2>
      </div>
      <a href="/favorites">投稿を見る →</a>
    </div>
    <div class="favorite-grid" id="favorite-grid">
      <p class="placeholder" id="favorite-grid-loading">読み込み中...</p>
    </div>
  </section>

  <section class="ranking-preview">
    <div class="section-heading">
      <div>
        <p class="section-kicker">NOW VOTING</p>
        <h2>開催中のランキング</h2>
      </div>
      <a href="/ranking">投票ページへ →</a>
    </div>
    <div class="ranking-carousel" id="ranking-carousel">
      {rankingSlides.map((slide, index) => (
        <div class="ranking-panel" data-index={index} hidden={index !== 0}>
          <div class="ranking-question">
            <span>今回のお題</span>
            <h3>{slide.question}</h3>
            <p>投票結果はリアルタイムで反映されます。</p>
          </div>
          <ol class="ranking-list" data-question-id={slide.id}>
            <li class="placeholder">読み込み中...</li>
          </ol>
        </div>
      ))}
    </div>
    {rankingSlides.length > 1 && <div class="ranking-dots" id="ranking-dots"></div>}
  </section>

  <script type="application/json" id="track-title-lookup-data" set:html={JSON.stringify(trackTitleLookup)} />
  <script type="application/json" id="ranking-slides-data" set:html={JSON.stringify(rankingSlides)} />

  <section class="event-preview">
    <div class="section-heading">
      <div>
        <p class="section-kicker">UP NEXT</p>
        <h2>次のイベント</h2>
      </div>
      <a href="/calendar">カレンダーを見る →</a>
    </div>
    {nextEvents.length > 0 ? (
      <div class="event-list">
        {nextEvents.map((event) => (
          <article class="event-card">
            <time datetime={event.date}>{formatEventDate(event.date)}</time>
            <div class="event-copy">
              <span class={`event-type type-${event.type}`}>{eventTypeLabels[event.type]}</span>
              <h3>{event.title}</h3>
              {event.note && <p>{event.note}</p>}
            </div>
            {event.href && <a class="event-link" href={event.href}>詳細を見る →</a>}
          </article>
        ))}
      </div>
    ) : (
      <p class="placeholder">現在、掲載予定のイベントはありません。</p>
    )}
  </section>

  <section class="content-menu">
    <div class="section-heading">
      <div>
        <p class="section-kicker">EXPLORE</p>
        <h2>コンテンツ一覧</h2>
      </div>
    </div>
    <ul class="content-grid">
      {mainContents.map((item, index) => (
        <li>
          <a href={item.href}>
            <span class="content-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.label}<span class="content-arrow" aria-hidden="true">→</span></h3>
            <p>{item.desc}</p>
            {item.note && <p class="content-note">{item.note}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>最新情報</h2>
    {updateLog.length > 0 ? (
      <ul class="update-log">
        {updateLog.map((entry) => (
          <li>
            <span class="date">{entry.date}</span>
            <span class="message">{entry.message}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="placeholder">準備中です。</p>
    )}
  </section>
</Layout>

<script>
  // 「今日の1曲」カルーセル。どの曲を選ぶかは訪問者のブラウザ側の「今日」の日付を
  // 使って計算する(ビルド時点の日付固定だと、再デプロイしない限り切り替わらないため)。
  type FeaturedSong = {
    slug: string;
    title: string;
    group: string;
    date: string;
    description: string | null;
    coverSrc: string | null;
    youtube: string | null;
  };
  type FeaturedGroupPool = { group: string; songs: FeaturedSong[] };

  const featuredPool: FeaturedGroupPool[] = JSON.parse(
    document.getElementById("featured-pool-data")!.textContent!
  );
  const dayNumber = Math.floor(Date.now() / 86_400_000);
  const featuredSongs = featuredPool.map((g) => g.songs[dayNumber % g.songs.length]);

  const carousel = document.getElementById("featured-carousel") as HTMLDivElement;
  const dotsContainer = document.getElementById("featured-dots") as HTMLDivElement;

  function coverEl(song: FeaturedSong): HTMLElement {
    if (song.coverSrc) {
      const img = document.createElement("img");
      img.className = "cover square";
      img.src = song.coverSrc;
      img.alt = song.title;
      img.loading = "lazy";
      return img;
    }
    const placeholder = document.createElement("div");
    placeholder.className = "cover placeholder square";
    placeholder.setAttribute("aria-hidden", "true");
    placeholder.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/></svg>';
    return placeholder;
  }

  function renderSlide(song: FeaturedSong, index: number): HTMLElement {
    const slide = document.createElement("div");
    slide.className = "featured-slide" + (index === 0 ? " active" : "");

    const heroCopy = document.createElement("div");
    heroCopy.className = "hero-copy";

    const eyebrow = document.createElement("p");
    eyebrow.className = "eyebrow";
    eyebrow.textContent = `TODAY'S PICK・${song.group}`;
    heroCopy.appendChild(eyebrow);

    const label = document.createElement("p");
    label.className = "hero-label";
    label.textContent = "今日の1曲";
    heroCopy.appendChild(label);

    const h1 = document.createElement("h1");
    h1.textContent = song.title;
    heroCopy.appendChild(h1);

    const meta = document.createElement("p");
    meta.className = "hero-meta";
    meta.textContent = `${song.group} ・ ${song.date}`;
    heroCopy.appendChild(meta);

    const lead = document.createElement("p");
    lead.className = "lead";
    lead.textContent = song.description ?? "今日はこの曲から、オーイシさんの音楽をたどってみませんか。";
    heroCopy.appendChild(lead);

    const actions = document.createElement("div");
    actions.className = "hero-actions";
    const ctaLink = document.createElement("a");
    ctaLink.className = "cta";
    ctaLink.href = `/works/${song.slug}`;
    ctaLink.textContent = "楽曲ページを見る";
    actions.appendChild(ctaLink);
    const exploreLink = document.createElement("a");
    exploreLink.className = "text-link";
    exploreLink.href = "/works";
    exploreLink.textContent = "楽曲を探す →";
    actions.appendChild(exploreLink);
    heroCopy.appendChild(actions);

    slide.appendChild(heroCopy);

    const coverLink = document.createElement("a");
    coverLink.className = "hero-cover";
    coverLink.href = `/works/${song.slug}`;
    coverLink.setAttribute("aria-label", `${song.title}の楽曲ページを見る`);
    coverLink.appendChild(coverEl(song));
    slide.appendChild(coverLink);

    return slide;
  }

  function showFeaturedSlide(index: number) {
    const slides = carousel.querySelectorAll<HTMLElement>(".featured-slide");
    const dots = dotsContainer.querySelectorAll<HTMLButtonElement>(".dot");
    slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
    dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    featuredIndex = index;
  }

  let featuredIndex = 0;
  let featuredTimer: ReturnType<typeof setInterval> | null = null;

  function restartFeaturedAutoRotate() {
    if (featuredTimer !== null) clearInterval(featuredTimer);
    if (featuredSongs.length > 1) {
      featuredTimer = setInterval(
        () => showFeaturedSlide((featuredIndex + 1) % featuredSongs.length),
        10000
      );
    }
  }

  function goToFeaturedSlide(index: number) {
    showFeaturedSlide(index);
    restartFeaturedAutoRotate();
  }

  carousel.innerHTML = "";
  featuredSongs.forEach((song, i) => carousel.appendChild(renderSlide(song, i)));

  if (featuredSongs.length > 1) {
    dotsContainer.hidden = false;
    featuredSongs.forEach((song, i) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "dot" + (i === 0 ? " active" : "");
      dot.setAttribute("aria-label", `${song.group}を表示`);
      dot.addEventListener("click", () => goToFeaturedSlide(i));
      dotsContainer.appendChild(dot);
    });

    const prevButton = document.getElementById("featured-prev") as HTMLButtonElement;
    const nextButton = document.getElementById("featured-next") as HTMLButtonElement;
    prevButton.hidden = false;
    nextButton.hidden = false;
    prevButton.addEventListener("click", () => {
      goToFeaturedSlide((featuredIndex - 1 + featuredSongs.length) % featuredSongs.length);
    });
    nextButton.addEventListener("click", () => {
      goToFeaturedSlide((featuredIndex + 1) % featuredSongs.length);
    });

    restartFeaturedAutoRotate();
  }

  // 「今日のBGM」: 上の「今日の1曲」カルーセルと同じ4曲(名義ごとの日替わり1曲)を
  // YouTube埋め込みでループ再生する。YouTubeリンクが無い曲はBGM対象から外す。
  function getYouTubeId(url: string | null): string | null {
    if (!url) return null;
    const match = url.match(/(?:v=|youtu\.be\/)([\w-]{11})/);
    return match ? match[1] : null;
  }

  const bgmSongs = featuredSongs
    .map((song) => ({ song, videoId: getYouTubeId(song.youtube) }))
    .filter((entry): entry is { song: FeaturedSong; videoId: string } => entry.videoId !== null);

  const bgmLaunchButton = document.getElementById("bgm-launch-button") as HTMLButtonElement | null;

  if (bgmSongs.length > 0 && bgmLaunchButton) {
    const bgmWidget = document.getElementById("bgm-widget") as HTMLDivElement;
    const bgmTitleEl = document.getElementById("bgm-current-title") as HTMLParagraphElement;
    const bgmTogglePlayButton = document.getElementById("bgm-toggle-play") as HTMLButtonElement;
    const bgmSkipButton = document.getElementById("bgm-skip") as HTMLButtonElement;
    const bgmCloseButton = document.getElementById("bgm-close") as HTMLButtonElement;

    let bgmIndex = 0;
    let bgmPlayer: any = null;
    let bgmApiReady = false;
    let bgmStarted = false;
    let bgmPendingStart = false;

    function updateBgmTitle() {
      const current = bgmSongs[bgmIndex];
      bgmTitleEl.textContent = `${current.song.title}(${current.song.group})`;
    }

    function playBgmIndex(index: number) {
      bgmIndex = ((index % bgmSongs.length) + bgmSongs.length) % bgmSongs.length;
      updateBgmTitle();
      if (bgmPlayer) bgmPlayer.loadVideoById(bgmSongs[bgmIndex].videoId);
    }

    function createBgmPlayer() {
      updateBgmTitle();
      bgmPlayer = new (window as any).YT.Player("bgm-yt-player", {
        videoId: bgmSongs[bgmIndex].videoId,
        playerVars: { autoplay: 1, playsinline: 1 },
        events: {
          onReady: (event: any) => {
            // playerVars.autoplayだけだとブラウザの自動再生ポリシーで再生されない
            // ことがあるため、準備完了時点でも明示的にplayVideo()を呼んでおく。
            event.target.playVideo();
          },
          onStateChange: (event: any) => {
            if (event.data === (window as any).YT.PlayerState.ENDED) {
              playBgmIndex(bgmIndex + 1);
            } else if (event.data === (window as any).YT.PlayerState.PLAYING) {
              bgmTogglePlayButton.textContent = "⏸";
              bgmTogglePlayButton.setAttribute("aria-label", "一時停止");
            } else if (event.data === (window as any).YT.PlayerState.PAUSED) {
              bgmTogglePlayButton.textContent = "▶";
              bgmTogglePlayButton.setAttribute("aria-label", "再生");
            }
          },
        },
      });
    }

    // ボタンを押した瞬間(ユーザー操作の文脈)にYT.Playerの生成まで同期的に行わないと、
    // ブラウザの自動再生ポリシーでミュートなし再生がブロックされることがある。
    // そのため、YouTube IFrame APIはページ読み込み時点で先読みしておき、
    // クリック時は(APIが読み込み済みなら)即座にプレイヤーを生成する。
    function preloadYouTubeApi() {
      const existingCallback = (window as any).onYouTubeIframeAPIReady;
      (window as any).onYouTubeIframeAPIReady = () => {
        bgmApiReady = true;
        if (typeof existingCallback === "function") existingCallback();
        if (bgmPendingStart) createBgmPlayer();
      };
      if ((window as any).YT && (window as any).YT.Player) {
        bgmApiReady = true;
        return;
      }
      const script = document.createElement("script");
      script.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(script);
    }

    preloadYouTubeApi();

    bgmLaunchButton.hidden = false;
    bgmLaunchButton.addEventListener("click", () => {
      bgmLaunchButton.hidden = true;
      bgmWidget.hidden = false;
      if (!bgmStarted) {
        bgmStarted = true;
        if (bgmApiReady) {
          createBgmPlayer();
        } else {
          bgmPendingStart = true;
        }
      }
    });

    bgmTogglePlayButton.addEventListener("click", () => {
      if (!bgmPlayer) return;
      const state = bgmPlayer.getPlayerState();
      if (state === (window as any).YT.PlayerState.PLAYING) {
        bgmPlayer.pauseVideo();
      } else {
        bgmPlayer.playVideo();
      }
    });

    bgmSkipButton.addEventListener("click", () => {
      playBgmIndex(bgmIndex + 1);
      if (bgmPlayer) bgmPlayer.playVideo();
    });

    bgmCloseButton.addEventListener("click", () => {
      if (bgmPlayer) bgmPlayer.pauseVideo();
      bgmWidget.hidden = true;
      bgmLaunchButton.hidden = false;
    });
  }
</script>

<script>
  import { supabase } from "../lib/supabase";

  type TrackTitleLookup = { slug: string; title: string; coverSrc: string | null };
  type FavoritePost = { id: string; track_slug: string; author: string; body: string; likes: number };
  type RankingCandidate = { slug: string; title: string };
  type RankingSlide = { id: string; question: string; candidates: RankingCandidate[] };

  const trackTitleLookup: TrackTitleLookup[] = JSON.parse(
    document.getElementById("track-title-lookup-data")!.textContent!
  );
  const trackMap = new Map(trackTitleLookup.map((t) => [t.slug, t]));

  const rankingSlides: RankingSlide[] = JSON.parse(document.getElementById("ranking-slides-data")!.textContent!);
  const rankingCarousel = document.getElementById("ranking-carousel") as HTMLDivElement;
  const rankingDotsContainer = document.getElementById("ranking-dots") as HTMLDivElement | null;

  function coverEl(): HTMLDivElement {
    const cover = document.createElement("div");
    cover.className = "cover placeholder";
    cover.setAttribute("aria-hidden", "true");
    cover.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/></svg>';
    return cover;
  }

  async function loadFavoritePreview() {
    const grid = document.getElementById("favorite-grid") as HTMLDivElement;
    const { data, error } = await supabase
      .from("favorite_posts")
      .select("*")
      .order("likes", { ascending: false })
      .limit(3);

    if (error || !data || data.length === 0) {
      grid.innerHTML = '<p class="placeholder">まだ投稿がありません。<a href="/favorites">最初の推し曲を投稿してみませんか?</a></p>';
      return;
    }

    grid.innerHTML = "";
    for (const post of data as FavoritePost[]) {
      const track = trackMap.get(post.track_slug);
      const title = track?.title ?? post.track_slug;
      const article = document.createElement("article");
      article.className = "favorite-card";
      const cover = document.createElement("a");
      cover.className = "favorite-cover";
      cover.href = `/works/${post.track_slug}`;
      if (track?.coverSrc) {
        const image = document.createElement("img");
        image.className = "favorite-image";
        image.src = track.coverSrc;
        image.alt = track.title;
        image.loading = "lazy";
        cover.appendChild(image);
      } else {
        cover.appendChild(coverEl());
      }
      article.appendChild(cover);

      const body = document.createElement("div");
      body.innerHTML = `
        <h3><a href="/works/${post.track_slug}"></a></h3>
        <p class="favorite-comment"></p>
        <p class="favorite-meta"></p>
      `;
      (body.querySelector("h3 a") as HTMLElement).textContent = title;
      (body.querySelector(".favorite-comment") as HTMLElement).textContent = post.body;
      (body.querySelector(".favorite-meta") as HTMLElement).textContent = `♡ ${post.likes} ・ ${post.author}`;
      article.appendChild(body);

      grid.appendChild(article);
    }
  }

  async function loadRankingPreview() {
    const { data } = await supabase
      .from("ranking_results")
      .select("*")
      .in("question_id", rankingSlides.map((s) => s.id));

    const byQuestion = new Map<string, Map<string, number>>();
    for (const row of (data ?? []) as { question_id: string; track_slug: string; votes: number }[]) {
      if (!byQuestion.has(row.question_id)) byQuestion.set(row.question_id, new Map());
      byQuestion.get(row.question_id)!.set(row.track_slug, row.votes);
    }

    for (const slide of rankingSlides) {
      const counts = byQuestion.get(slide.id) ?? new Map<string, number>();
      const ranked = slide.candidates
        .map((c) => ({ ...c, votes: counts.get(c.slug) ?? 0 }))
        .sort((a, b) => b.votes - a.votes)
        .slice(0, 3);

      const list = rankingCarousel.querySelector<HTMLOListElement>(`.ranking-list[data-question-id="${slide.id}"]`);
      if (!list) continue;
      list.innerHTML = "";
      ranked.forEach((choice, index) => {
        const li = document.createElement("li");
        const rank = document.createElement("strong");
        rank.textContent = String(index + 1);
        const link = document.createElement("a");
        link.href = `/works/${choice.slug}`;
        link.textContent = choice.title;
        const votes = document.createElement("span");
        votes.textContent = `${choice.votes}票`;
        li.appendChild(rank);
        li.appendChild(link);
        li.appendChild(votes);
        list.appendChild(li);
      });
    }
  }

  // 開催中のランキングは、お題を自動でゆっくり切り替えるカルーセル表示にする
  // (「今日の1曲」より長い間隔でのんびり切り替わればよいという方針)。
  let rankingSlideIndex = 0;
  let rankingTimer: ReturnType<typeof setInterval> | null = null;

  function showRankingSlide(index: number) {
    const panels = rankingCarousel.querySelectorAll<HTMLElement>(".ranking-panel");
    panels.forEach((panel, i) => {
      panel.hidden = i !== index;
    });
    rankingDotsContainer?.querySelectorAll<HTMLButtonElement>(".dot").forEach((dot, i) => {
      dot.classList.toggle("active", i === index);
    });
    rankingSlideIndex = index;
  }

  function restartRankingAutoRotate() {
    if (rankingTimer !== null) clearInterval(rankingTimer);
    if (rankingSlides.length > 1) {
      rankingTimer = setInterval(
        () => showRankingSlide((rankingSlideIndex + 1) % rankingSlides.length),
        18000
      );
    }
  }

  function goToRankingSlide(index: number) {
    showRankingSlide(index);
    restartRankingAutoRotate();
  }

  if (rankingDotsContainer && rankingSlides.length > 1) {
    rankingSlides.forEach((slide, i) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "dot" + (i === 0 ? " active" : "");
      dot.setAttribute("aria-label", `お題「${slide.question}」を表示`);
      dot.addEventListener("click", () => goToRankingSlide(i));
      rankingDotsContainer.appendChild(dot);
    });
    restartRankingAutoRotate();
  }

  loadFavoritePreview();
  loadRankingPreview();
</script>

