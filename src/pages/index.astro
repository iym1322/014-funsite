---
// トップページ(ワイヤーフレーム段階)。
// CONTENTS_PLAN.md 2-1 の構成案(ヒーロー / プロフィール導線 / 最新ブログ / 主要ナビ)を
// 骨組みとして実装。ブログは別リポジトリ管理のためここには含めない。
// 「最新情報」はgit commitの履歴をビルド時に読み込み、サイトの更新履歴として表示している
// (コミットメッセージの1行目=件名は、サイト閲覧者にも伝わる文面で書くこと)。
import { execSync } from "node:child_process";
import Layout from "../layouts/Layout.astro";
import TrackCover from "../components/TrackCover.astro";
import { tracks } from "../data/discography";

const mainContents = [
  { href: "/profile", label: "プロフィール", desc: "経歴・活動年表など基本情報" },
  { href: "/works", label: "ディスコグラフィー", desc: "楽曲・アルバム一覧" },
  { href: "/favorites", label: "推し曲コーナー", desc: "好きな曲を自分の言葉で紹介" },
  { href: "/live-reports", label: "イベントレポート", desc: "参戦したライブ・イベントの記録" },
  { href: "/ranking", label: "勝手にランキング", desc: "お題ごとの投票ランキング" },
  { href: "/calendar", label: "カレンダー", desc: "リリース・ライブ・イベントの予定" },
];

type UpdateLogEntry = { date: string; message: string };

function getUpdateLog(limit: number): UpdateLogEntry[] {
  try {
    const output = execSync(`git log -n ${limit + 5} --pretty=format:"%ad|||%s" --date=format:"%Y-%m-%d"`, {
      cwd: process.cwd(),
    }).toString();
    return output
      .split("\n")
      .filter(Boolean)
      .map((line) => {
        const [date, message] = line.split("|||");
        return { date, message };
      })
      .filter((entry) => entry.message !== "Initial commit from Astro")
      .slice(0, limit);
  } catch {
    return [];
  }
}

const updateLog = getUpdateLog(6);

const songs = tracks.filter((track) => track.slug && track.type === "シングル");
const dayNumber = Math.floor(Date.now() / 86_400_000);
const featuredSong = songs[dayNumber % songs.length];
const latestSongs = [...songs]
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate))
  .slice(0, 10);
---

<Layout title="オーイシマサヨシ非公式ファンサイト">
  <section class="intro">
    <div class="intro-inner">
      <p class="eyebrow">WELCOME TO 014 FAN SITE</p>
      <h1>好きな音楽を、もっと深く。その魅力を、みんなと一緒に。</h1>
      <p class="intro-lead">
        オーイシマサヨシさん・大石昌良さんの音楽を愛する個人が運営する非公式ファンサイトです。
      </p>
      <p class="intro-detail">
        楽曲やライブの記録を丁寧に集め、自分の言葉でその魅力を語りながら、
        訪れた人同士が新しい「好き」に出会える場所を目指しています。
      </p>
      <div class="intro-actions">
        <a class="cta" href="/works">音楽をたどる</a>
        <a class="text-link" href="/profile">プロフィールを見る →</a>
      </div>
    </div>
  </section>

  <section class="featured">
    <div class="hero-copy">
      <p class="eyebrow">TODAY'S PICK</p>
      <p class="hero-label">今日の1曲</p>
      <h1>{featuredSong.title}</h1>
      <p class="hero-meta">{featuredSong.group} ・ {featuredSong.date}</p>
      <p class="lead">
        {featuredSong.description ?? featuredSong.tieIn ?? "今日はこの曲から、オーイシさんの音楽をたどってみませんか。"}
      </p>
      <div class="hero-actions">
        <a class="cta" href={`/works/${featuredSong.slug}`}>楽曲ページを見る</a>
        <a class="text-link" href="/works">楽曲を探す →</a>
      </div>
    </div>
    <a class="hero-cover" href={`/works/${featuredSong.slug}`} aria-label={`${featuredSong.title}の楽曲ページを見る`}>
      <TrackCover image={featuredSong.image} title={featuredSong.title} />
    </a>
  </section>

  <section class="latest-section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">NEW RELEASES</p>
        <h2>新着楽曲</h2>
      </div>
      <a href="/works">すべて見る →</a>
    </div>
    <div class="song-rail" aria-label="新着楽曲一覧">
      {latestSongs.map((track) => (
        <a class="song-card" href={`/works/${track.slug}`}>
          <TrackCover image={track.image} title={track.title} />
          <strong>{track.title}</strong>
          <span>{track.group} ・ {track.date}</span>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>最新情報</h2>
    {updateLog.length > 0 ? (
      <ul class="update-log">
        {updateLog.map((entry) => (
          <li>
            <span class="date">{entry.date}</span>
            <span class="message">{entry.message}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="placeholder">準備中です。</p>
    )}
  </section>

  <section class="content-menu">
    <div class="section-heading">
      <div>
        <p class="section-kicker">EXPLORE</p>
        <h2>コンテンツ一覧</h2>
      </div>
    </div>
    <ul class="content-grid">
      {mainContents.map((item) => (
        <li>
          <a href={item.href}>
            <h3>{item.label}<span aria-hidden="true">→</span></h3>
            <p>{item.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .intro {
    padding: clamp(1.5rem, 4vw, 3rem) 0;
  }

  .intro-inner {
    position: relative;
    padding: clamp(2.25rem, 6vw, 4.5rem);
    border: 1px solid #e8ddd0;
    border-radius: 24px;
    background: linear-gradient(120deg, #fff 0%, #f8f2ea 100%);
    box-shadow: 0 18px 50px rgb(74 55 39 / 7%);
    overflow: hidden;
  }

  .intro-inner::after {
    content: "014";
    position: absolute;
    right: -0.05em;
    bottom: -0.32em;
    color: rgb(138 109 92 / 7%);
    font-size: clamp(9rem, 25vw, 17rem);
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }

  .intro h1 {
    position: relative;
    z-index: 1;
    max-width: 790px;
    font-size: clamp(2.15rem, 5.5vw, 4.25rem);
    letter-spacing: -0.05em;
    margin: 0 0 1.5rem;
  }

  .intro-lead,
  .intro-detail {
    position: relative;
    z-index: 1;
    max-width: 650px;
    color: var(--color-text-muted);
    line-height: 2;
  }

  .intro-lead {
    color: var(--color-text);
    font-size: 1.08rem;
    font-weight: 700;
    margin: 0 0 0.65rem;
  }

  .intro-detail {
    margin: 0 0 2rem;
  }

  .intro-actions {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: 24px;
    background: linear-gradient(135deg, #f1e8dc 0%, #fbf8f3 55%, #e4d4c2 100%);
    overflow: hidden;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin: 0 0 0.75rem;
  }

  .hero-label {
    margin: 0 0 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .featured h1 {
    font-size: clamp(2rem, 5vw, 3.75rem);
    letter-spacing: -0.04em;
    margin: 0 0 0.5rem;
  }

  .hero-meta {
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
  }

  .lead {
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .cta {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    text-decoration: none;
  }

  .text-link {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .hero-cover {
    display: block;
    width: min(100%, 280px);
    justify-self: center;
    color: inherit;
    text-decoration: none;
    transform: rotate(2deg);
    filter: drop-shadow(0 22px 24px rgb(74 55 39 / 18%));
    transition: transform 180ms ease;
  }

  .hero-cover:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-heading h2,
  .section-kicker {
    margin: 0;
  }

  .section-kicker {
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .section-heading a {
    flex: none;
    text-decoration: none;
  }

  .song-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(170px, 21%);
    gap: 1rem;
    overflow-x: auto;
    padding: 0.25rem 0 1rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .song-card {
    min-width: 0;
    color: var(--color-text);
    text-decoration: none;
    scroll-snap-align: start;
  }

  .song-card strong,
  .song-card span {
    display: block;
  }

  .song-card strong {
    margin-top: 0.75rem;
    line-height: 1.5;
  }

  .song-card span {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .placeholder {
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .update-log {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .update-log li {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .update-log li:last-child {
    border-bottom: none;
  }

  .update-log .date {
    flex: none;
    width: 6rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .update-log .message {
    font-size: 0.95rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .content-grid a {
    display: block;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .content-grid a:hover {
    transform: translateY(-3px);
    border-color: #cdb9a5;
    box-shadow: 0 10px 24px rgb(74 55 39 / 8%);
  }

  .content-grid h3 {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.5rem;
  }

  .content-grid p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .featured {
      grid-template-columns: 1fr;
      padding: 2rem;
    }

    .hero-cover {
      grid-row: 1;
      width: min(62vw, 240px);
      margin: 0 auto;
    }

    .song-rail {
      grid-auto-columns: minmax(155px, 46%);
    }

    .update-log li {
      display: block;
    }
  }
</style>
