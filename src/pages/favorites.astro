---
// 推し曲コーナー(CONTENTS_PLAN.md 2-3)。
// Supabase(favorite_postsテーブル)に接続し、実際に投稿・閲覧・いいねができる。
// 投稿は承認なしの即時公開(CONTENTS_PLAN.md 5章の方針)。
// 曲リストと画像は discography.ts(ビルド時に確定するデータ)から、
// 投稿内容だけはブラウザ側でSupabaseから取得する(即時反映のため)。
import Layout from "../layouts/Layout.astro";
import { tracks } from "../data/discography";

const trackOptions = tracks
  .filter((t) => t.slug)
  .map((t) => ({ slug: t.slug as string, title: t.title, image: t.image ?? "" }))
  .sort((a, b) => a.title.localeCompare(b.title, "ja"));
---

<Layout title="推し曲コーナー | オーイシマサヨシ非公式ファンサイト">
  <h1>推し曲コーナー</h1>
  <p class="note">
    好きな曲の魅力を自分の言葉で紹介するコーナーです。どなたでも投稿できます。
    投稿は承認なしですぐに公開されるため、歌詞の転載や誹謗中傷など不適切な内容は
    お控えください(発見次第、運営が削除します)。
  </p>

  <section class="post-form">
    <h2>推し曲を投稿する</h2>
    <form id="favorite-form">
      <label>
        曲名
        <select name="trackSlug" id="track-select" required>
          <option value="" disabled selected>曲を選んでください</option>
          {trackOptions.map((t) => <option value={t.slug}>{t.title}</option>)}
        </select>
      </label>
      <label>
        お名前(ニックネーム可)
        <input type="text" name="author" id="author-input" maxlength="50" required placeholder="例: 014ファン" />
      </label>
      <label>
        コメント
        <textarea name="body" id="body-input" rows="3" maxlength="500" required placeholder="好きな理由を自由に書いてください(歌詞の転載はご遠慮ください)"></textarea>
      </label>
      <!-- ハニーポット: 通常は非表示。ボットが埋めてしまう欄なので、値が入っていたら投稿を弾く -->
      <label class="honeypot" aria-hidden="true">
        Webサイト
        <input type="text" name="website" id="website-input" tabindex="-1" autocomplete="off" />
      </label>
      <button type="submit" id="submit-button">投稿する</button>
      <p class="form-message" id="form-message" role="status"></p>
    </form>
  </section>

  <section class="post-list">
    <h2>投稿一覧</h2>
    <p class="loading-message" id="loading-message">読み込み中...</p>
    <ul id="post-list"></ul>
  </section>

  <script type="application/json" id="track-options-data" set:html={JSON.stringify(trackOptions)} />
</Layout>

<script>
  import { supabase } from "../lib/supabase";

  type FavoritePost = {
    id: string;
    track_slug: string;
    author: string;
    body: string;
    likes: number;
    created_at: string;
  };
  type TrackOption = { slug: string; title: string; image: string };

  const trackOptionsData: TrackOption[] = JSON.parse(
    document.getElementById("track-options-data")!.textContent!
  );
  const trackMap = new Map(trackOptionsData.map((t) => [t.slug, t]));

  const form = document.getElementById("favorite-form") as HTMLFormElement;
  const trackSelect = document.getElementById("track-select") as HTMLSelectElement;
  const authorInput = document.getElementById("author-input") as HTMLInputElement;
  const bodyInput = document.getElementById("body-input") as HTMLTextAreaElement;
  const websiteInput = document.getElementById("website-input") as HTMLInputElement;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
  const formMessage = document.getElementById("form-message") as HTMLParagraphElement;
  const postList = document.getElementById("post-list") as HTMLUListElement;
  const loadingMessage = document.getElementById("loading-message") as HTMLParagraphElement;

  function renderPost(post: FavoritePost) {
    const track = trackMap.get(post.track_slug);
    const li = document.createElement("li");
    li.className = "post-card";

    const trackLink = document.createElement("a");
    trackLink.className = "post-track";
    trackLink.href = track ? `/works/${track.slug}` : "#";

    const cover = document.createElement("div");
    cover.className = "cover placeholder";
    cover.setAttribute("aria-hidden", "true");
    cover.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/></svg>';
    trackLink.appendChild(cover);

    const trackTitle = document.createElement("span");
    trackTitle.textContent = track ? track.title : post.track_slug;
    trackLink.appendChild(trackTitle);

    const body = document.createElement("div");
    body.className = "post-body";
    body.innerHTML = `
      <p class="post-author"></p>
      <p class="post-text"></p>
      <button class="like-button" type="button">👍 <span class="like-count">${post.likes}</span></button>
    `;
    (body.querySelector(".post-author") as HTMLElement).textContent = post.author;
    (body.querySelector(".post-text") as HTMLElement).textContent = post.body;

    const likedKey = `funsite-liked-${post.id}`;
    const likeButton = body.querySelector(".like-button") as HTMLButtonElement;
    if (localStorage.getItem(likedKey)) {
      likeButton.disabled = true;
      likeButton.classList.add("liked");
    }
    likeButton.addEventListener("click", async () => {
      if (localStorage.getItem(likedKey)) return;
      likeButton.disabled = true;
      const { error } = await supabase.rpc("increment_favorite_likes", { post_id: post.id });
      if (error) {
        likeButton.disabled = false;
        alert("いいねに失敗しました。時間をおいて再度お試しください。");
        return;
      }
      localStorage.setItem(likedKey, "1");
      likeButton.classList.add("liked");
      const countEl = likeButton.querySelector(".like-count") as HTMLElement;
      countEl.textContent = String(Number(countEl.textContent) + 1);
    });

    li.appendChild(trackLink);
    li.appendChild(body);
    return li;
  }

  async function loadPosts() {
    loadingMessage.style.display = "";
    const { data, error } = await supabase
      .from("favorite_posts")
      .select("*")
      .order("created_at", { ascending: false });

    loadingMessage.style.display = "none";

    if (error) {
      loadingMessage.textContent = "投稿の読み込みに失敗しました。時間をおいて再度お試しください。";
      loadingMessage.style.display = "";
      return;
    }

    postList.innerHTML = "";
    if (!data || data.length === 0) {
      const empty = document.createElement("li");
      empty.className = "loading-message empty-message";
      empty.textContent = "まだ投稿がありません。最初の推し曲を投稿してみませんか?";
      postList.appendChild(empty);
      return;
    }
    for (const post of data as FavoritePost[]) {
      postList.appendChild(renderPost(post));
    }
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (websiteInput.value.trim() !== "") {
      // ハニーポットに入力があったら何もせず終了(ボット対策)。
      return;
    }

    const trackSlug = trackSelect.value;
    const author = authorInput.value.trim();
    const body = bodyInput.value.trim();

    if (!trackSlug || !author || !body) {
      formMessage.textContent = "曲・お名前・コメントをすべて入力してください。";
      return;
    }

    submitButton.disabled = true;
    formMessage.textContent = "";

    const { error } = await supabase.from("favorite_posts").insert({
      track_slug: trackSlug,
      author,
      body,
    });

    submitButton.disabled = false;

    if (error) {
      formMessage.textContent = "投稿に失敗しました。時間をおいて再度お試しください。";
      return;
    }

    form.reset();
    formMessage.textContent = "投稿しました。ありがとうございます!";
    await loadPosts();
  });

  loadPosts();
</script>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  h2 {
    font-size: 1.1rem;
    margin: 2rem 0 1rem;
  }

  .post-form {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--color-surface);
  }

  .post-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .post-form input,
  .post-form select,
  .post-form textarea {
    font-family: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    resize: vertical;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .post-form button[type="submit"] {
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    font-family: inherit;
    cursor: pointer;
  }

  .post-form button[type="submit"]:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .form-message {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .loading-message {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    background: var(--color-surface);
  }

  @media (max-width: 480px) {
    .post-card {
      grid-template-columns: 1fr;
    }
  }

  .post-track {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.75rem;
    text-align: center;
  }

  .post-track:hover {
    color: var(--color-accent);
  }

  .cover.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    background: linear-gradient(135deg, #e5ded3, #cfc3af);
    color: var(--color-surface);
  }

  .cover.placeholder svg {
    width: 30%;
    height: 30%;
    opacity: 0.7;
  }

  .post-author {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .post-text {
    margin: 0 0 0.75rem;
    line-height: 1.8;
    white-space: pre-wrap;
  }

  .like-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .like-button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .like-button.liked {
    border-color: var(--color-accent);
    color: var(--color-accent);
    cursor: default;
  }

  .like-button:disabled {
    opacity: 0.7;
  }
</style>
