---
// 推し曲コーナー(CONTENTS_PLAN.md 2-3)。
// 訪問者投稿・高評価機能はデザイン確認のためUIのみ用意している段階。
// バックエンド(投稿の保存先)が未整備なため、投稿フォーム送信・いいねボタンは
// 実際には保存されず、「準備中です」という案内を表示するだけになっている
// (押しても何も起きないふりをするのではなく、はっきり伝える設計)。
import Layout from "../layouts/Layout.astro";
import TrackCover from "../components/TrackCover.astro";
import { favoritePosts, trackFor } from "../data/favorites";
---

<Layout title="推し曲コーナー | オーイシマサヨシ非公式ファンサイト">
  <h1>推し曲コーナー</h1>
  <p class="note">
    好きな曲の魅力を自分の言葉で紹介するコーナーです。将来的には、サイトに訪れた方も
    投稿・高評価できるようにしたいと考えています。現在表示されている投稿は
    <strong>デザイン確認用のサンプル</strong>で、実際の投稿ではありません。
  </p>

  <section class="post-form">
    <h2>推し曲を投稿する</h2>
    <p class="pending-note">投稿機能は準備中です。公開まで今しばらくお待ちください。</p>
    <form id="favorite-form">
      <label>
        曲名
        <input type="text" placeholder="例: 君じゃなきゃダメみたい" disabled />
      </label>
      <label>
        コメント
        <textarea rows="3" placeholder="好きな理由を自由に書いてください(歌詞の転載はご遠慮ください)" disabled></textarea>
      </label>
      <button type="submit">投稿する</button>
    </form>
  </section>

  <section class="post-list">
    <h2>投稿一覧(サンプル)</h2>
    <ul>
      {favoritePosts.map((post) => {
        const track = trackFor(post.trackSlug);
        return (
          <li class="post-card">
            {track && (
              <a class="post-track" href={`/works/${track.slug}`}>
                <TrackCover image={track.image} title={track.title} />
                <span>{track.title}</span>
              </a>
            )}
            <div class="post-body">
              <p class="post-author">
                {post.author}
                {post.isSample && <span class="sample-badge">サンプル</span>}
              </p>
              <p class="post-text">{post.body}</p>
              <button class="like-button" type="button" data-count={post.likes}>
                👍 <span class="like-count">{post.likes}</span>
              </button>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>

<script>
  const form = document.getElementById("favorite-form") as HTMLFormElement;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    alert("投稿機能は準備中です。もうしばらくお待ちください。");
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>(".like-button")) {
    btn.addEventListener("click", () => {
      alert("評価機能は準備中です。もうしばらくお待ちください。");
    });
  }
</script>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  h2 {
    font-size: 1.1rem;
    margin: 2rem 0 1rem;
  }

  .post-form {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--color-surface);
  }

  .pending-note {
    color: var(--color-accent);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .post-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .post-form input,
  .post-form textarea {
    font-family: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    resize: vertical;
  }

  .post-form button[type="submit"] {
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    font-family: inherit;
    cursor: pointer;
  }

  .post-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    background: var(--color-surface);
  }

  @media (max-width: 480px) {
    .post-card {
      grid-template-columns: 1fr;
    }
  }

  .post-track {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.75rem;
    text-align: center;
  }

  .post-track:hover {
    color: var(--color-accent);
  }

  .post-author {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sample-badge {
    font-size: 0.7rem;
    background: #f4e8de;
    color: #a3663f;
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
  }

  .post-text {
    margin: 0 0 0.75rem;
    line-height: 1.8;
  }

  .like-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .like-button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
