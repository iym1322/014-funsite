---
// ミニゲームのハブページ(CONTENTS_PLAN.md C.遊び・エンタメ系のバックログ外追加)。
// 個別のミニゲームは src/pages/minigames/ 以下に増やしていく想定で、
// ここにカードを追加するだけで一覧に出る。
import Layout from "../../layouts/Layout.astro";

const games = [
  {
    href: "/minigames/slot",
    label: "オーイシマサヨシスロット",
    desc: "7つのリールをそろえて「オーイシマサヨシ」を完成させるミニゲーム。3種類のデザインから選べます。",
  },
];
---

<Layout title="ミニゲーム | 014 BASE">
  <h1>ミニゲーム</h1>
  <p class="note">
    息抜きに遊べるミニゲームのコーナーです。今後も少しずつ追加していく予定です。
  </p>

  <ul class="game-grid">
    {games.map((game) => (
      <li>
        <a href={game.href}>
          <h2>{game.label}</h2>
          <p>{game.desc}</p>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .game-grid a {
    display: block;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
    box-sizing: border-box;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .game-grid a:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }

  .game-grid h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .game-grid p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
