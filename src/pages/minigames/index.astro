---
// ミニゲームのハブページ(CONTENTS_PLAN.md C.遊び・エンタメ系のバックログ外追加)。
// 個別のミニゲームは src/pages/minigames/ 以下に増やしていく想定で、
// ここにカードを追加するだけで一覧に出る。
import Layout from "../../layouts/Layout.astro";

// icon = カードの絵文字バッジ、tint = 背景の淡い色(名義ページ等と同じ手法)。
const games = [
  {
    href: "/quiz",
    icon: "📝",
    tint: "#f3e1e2",
    label: "オーイシ検定",
    desc: "オーイシに関する四択クイズ全50問。スコアに応じた称号ももらえます。",
  },
  {
    href: "/minigames/slot",
    icon: "🎰",
    tint: "#e2ead9",
    label: "オーイシマサヨシスロット",
    desc: "7つのリールをそろえて「オーイシマサヨシ」を完成させるミニゲーム。3種類のデザインから選べます。",
  },
  {
    href: "/minigames/my-pick",
    icon: "🎵",
    tint: "#f6e6d8",
    label: "MY PICK オーイシ",
    desc: "5つの名義×3つのお題のマスに好きな曲を選んで、画像を生成・シェアできる企画です。",
  },
];
---

<Layout title="ミニゲーム | 014 BASE">
  <p class="page-eyebrow">GAME CENTER</p>
  <h1>ミニゲーム</h1>
  <p class="note">
    息抜きに遊べるミニゲームのコーナーです。今後も少しずつ追加していく予定です。
  </p>

  <ul class="game-grid">
    {games.map((game) => (
      <li>
        <a href={game.href} style={`--card-tint: ${game.tint}`}>
          <span class="game-icon" aria-hidden="true">{game.icon}</span>
          <h2>{game.label}</h2>
          <p>{game.desc}</p>
          <span class="game-cta">あそぶ <span class="game-cta-arrow">→</span></span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .page-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .game-grid a {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem 1.5rem 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: linear-gradient(160deg, var(--card-tint, var(--color-surface)) 0%, var(--color-surface) 65%);
    text-decoration: none;
    color: var(--color-text);
    box-sizing: border-box;
    box-shadow: 0 2px 10px rgba(47, 44, 40, 0.05);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .game-grid a:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 10px 24px rgba(47, 44, 40, 0.12);
  }

  .game-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.9rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    font-size: 1.3rem;
    box-shadow: inset 0 0 0 1px rgba(47, 44, 40, 0.06);
  }

  .game-grid h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .game-grid p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .game-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1.1rem;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .game-cta-arrow {
    display: inline-block;
    transition: transform 180ms ease;
  }

  .game-grid a:hover .game-cta-arrow {
    transform: translateX(4px);
  }
</style>
