---
// シングルあてゲーム(ミニゲーム)。
// Wordle/Loldleのクラシックモードに近い形式: ランダムに選ばれた1曲(正解)を、
// 曲名を予想するたびに属性を比較して一致度をヒントとして出し、6回以内に
// 正解にたどり着くゲーム。アキネーターのような質問形式ではなく、
// 「予想→一致した部分を見て絞り込む」方式(ユーザー要望に基づく)。
// MY PICKと同様、サーバー側には何も保存せずブラウザ内だけで完結する。
import Layout from "../../layouts/Layout.astro";
import { tracks, getAlbumCoverImages, liveShows, liveRecordedOverrides } from "../../data/discography";
import { resolveTrackCoverSrc } from "../../lib/trackCover";

// 出題・回答候補はシングルのみ(ユーザー要望)。slugが無い曲は個別ページも
// ジャケットも用意できないので対象外にする。
const singleTracks = tracks.filter((t) => t.type === "シングル" && t.slug);

// 「アルバム収録」は曲データ自身には無いフィールドなので、全曲のアルバムの
// tracklistを走査してこの曲が登場するかを逆引きする。TrackRefにslugが
// あればslugで、無ければタイトル完全一致で判定する。
const albumSlugs = new Set<string>();
const albumTitles = new Set<string>();

for (const t of tracks) {
  if (t.type === "アルバム" && t.tracklist) {
    for (const ref of t.tracklist) {
      if (ref.slug) albumSlugs.add(ref.slug);
      else albumTitles.add(ref.title);
    }
  }
}

function hasAppearance(slug: string | undefined, title: string, slugSet: Set<string>, titleSet: Set<string>): boolean {
  return (!!slug && slugSet.has(slug)) || titleSet.has(title);
}

// 「ライブ収録」は回数で見る(ユーザー要望)。公式にBlu-ray/DVD化された
// 映像作品(isLive)のsetlist/setlistsと、liveShows(LiveFans等で個別に
// 調査したライブ記録)の両方を走査して、この曲が何回登場したかを数える。
// liveRecordedOverridesに明示的な記録があるslugは、その回数をそのまま使う
// (無ければ0回として扱う。中間の「収録はされているが正確な回数は未集計」
// というケースは現状存在しない)。
const liveCountBySlug = new Map<string, number>();
const liveCountByTitle = new Map<string, number>();

function bump(map: Map<string, number>, key: string) {
  map.set(key, (map.get(key) ?? 0) + 1);
}

for (const t of tracks) {
  if (t.isLive) {
    const refs = [...(t.setlist ?? []), ...(t.setlists?.flatMap((g) => g.tracks) ?? [])];
    for (const ref of refs) {
      if (ref.slug) bump(liveCountBySlug, ref.slug);
      else bump(liveCountByTitle, ref.title);
    }
  }
}
for (const show of liveShows) {
  for (const ref of show.setlist) {
    if (ref.slug) bump(liveCountBySlug, ref.slug);
    else bump(liveCountByTitle, ref.title);
  }
}

function liveCountOf(slug: string | undefined, title: string): number {
  // liveRecordedOverridesはtrue/falseの「収録実績があるかどうか」フラグだが、
  // falseが明示されている(=調査済みで0回と確認済み)場合は0回扱いにする。
  if (slug && slug in liveRecordedOverrides && liveRecordedOverrides[slug] === false) return 0;
  return (slug ? liveCountBySlug.get(slug) : undefined) ?? liveCountByTitle.get(title) ?? 0;
}

// 回数の0/1/2〜4/5以上という段階表示(ユーザー要望: 0,1,3,5以上)はクライアント側
// (liveBucketLabel)で行う。比較のヒント自体は丸める前の実数(liveCount)を使う。

// タイアップは「アニメ」「アニメ以外」「なし」の3カテゴリで比較する
// (ユーザー要望)。tieInの文章だけでは判定しきれない曲があるため、
// 1曲ずつ確認した結果をslugキーの辞書として持つ(新しいタイアップ付き
// シングルを追加したときはこの辞書への追記を忘れないこと)。
// 判定根拠: 各曲のdescriptionやdiscography.tsの記載(「TVアニメ」「Webアニメ」
