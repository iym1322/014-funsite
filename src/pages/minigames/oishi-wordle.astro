};

type TieInCategory = "anime" | "other" | "none";

function tieInCategoryOf(slug: string, tieIn: string | null): TieInCategory {
  if (!tieIn) return "none";
  if (slug in tieInAnimeOverrides) return tieInAnimeOverrides[slug];
  // 上の辞書に無い(=未確認の)新しいタイアップ曲は、文中に「アニメ」の
  // 文字列があるかどうかで簡易判定する(正確な分類ではないフォールバック)。
  return tieIn.includes("アニメ") ? "anime" : "other";
}

type GameTrack = {
  slug: string;
  title: string;
  group: string;
  date: string;
  year: number;
  tieIn: string | null;
  tieInCategory: TieInCategory;
  charCount: number;
  hasMV: boolean;
  inAlbum: boolean;
  liveCount: number;
  coverSrc: string | null;
};

const gameTracks: GameTrack[] = singleTracks
  .map((t) => ({
    slug: t.slug!,
    title: t.title,
    group: t.group,
    date: t.date,
    year: Number(t.sortDate.slice(0, 4)),
    tieIn: t.tieIn ?? null,
    tieInCategory: tieInCategoryOf(t.slug!, t.tieIn ?? null),
    // 文字数は見た目の長さのヒントなので、空白(全角・半角とも)は数えない
    // (ユーザー要望)。
    charCount: t.title.replace(/[\s　]/g, "").length,
    hasMV: Boolean(t.youtube) && !t.youtubeAudioOnly,
    inAlbum: hasAppearance(t.slug, t.title, albumSlugs, albumTitles),
    liveCount: liveCountOf(t.slug, t.title),
    coverSrc: resolveTrackCoverSrc(t.image, t.title, getAlbumCoverImages(t), t.preferAlbumCover),
  }))
  .sort((a, b) => a.title.localeCompare(b.title, "ja"));

const MAX_GUESSES = 6;
---

<Layout title="シングルあてゲーム | 014 BASE">
  <div class="wordle-hero">
    <p class="wordle-hero-eyebrow">予想して、答えに近づこう</p>
    <h1 class="wordle-hero-title">シングル<span>あてゲーム</span></h1>
    <p class="wordle-hero-lead">
      ランダムに選ばれたオーイシのシングル1曲を、曲名を予想しながら当てるゲームです。<br />
      予想するたびに「名義」「発売年」「タイアップ」など7つの項目で正解との一致度が表示されるので、<br />
      そのヒントを手がかりに次の予想を絞り込んでいきましょう。予想できるのは{MAX_GUESSES}回までです。
    </p>
    <p class="wordle-hero-note">
      出題対象はシングルリリースされた曲のみです(アルバム収録曲・提供曲・映像作品は対象外)。<br />
      進行状況はこのページの中だけで完結し、サーバーには保存されません(ページを閉じると消えます)。
    </p>
  </div>

  <div class="wordle-panel">
    <div class="wordle-status">
      <span class="wordle-status-count" id="wordle-count">のこり {MAX_GUESSES}/{MAX_GUESSES}回</span>
      <button type="button" class="wordle-new-button" id="wordle-new-button">別の曲で遊び直す</button>
    </div>

    <div class="guess-field">
      <svg class="guess-search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input type="search" id="guess-input" placeholder="曲名で検索して予想..." autocomplete="off" aria-label="曲名で予想する" />
      <ul class="guess-suggestions" id="guess-suggestions" hidden></ul>
    </div>

    <div class="result-wrap" id="result-grid"></div>

    <div class="wordle-end" id="wordle-end" hidden>
      <img class="wordle-end-cover" id="wordle-end-cover" alt="" />
      <div class="wordle-end-body">
        <p class="wordle-end-message" id="wordle-end-message"></p>
        <p class="wordle-end-title" id="wordle-end-title"></p>
        <a class="wordle-end-link" id="wordle-end-link" href="#">曲ページを見る →</a>
      </div>
    </div>
  </div>

  <script type="application/json" id="wordle-data" set:html={JSON.stringify({ gameTracks, maxGuesses: MAX_GUESSES })} />
</Layout>

<script>
  type TieInCategory = "anime" | "other" | "none";
  type GameTrack = {
    slug: string;
    title: string;
    group: string;
    date: string;
    year: number;
    tieIn: string | null;
    tieInCategory: TieInCategory;
    charCount: number;
    hasMV: boolean;
    inAlbum: boolean;
    liveCount: number;
    coverSrc: string | null;
  };

  const data: { gameTracks: GameTrack[]; maxGuesses: number } = JSON.parse(
    document.getElementById("wordle-data")!.textContent!
  );
  const { gameTracks, maxGuesses } = data;

  // ライブ収録回数の段階表示(ユーザー要望: 0,1,3,5以上)。比較のヒント自体は
  // 丸める前の実数(liveCount)を使い、表示だけこのラベルに変換する。
  const LIVE_BUCKET_LABELS = ["0回", "1回", "2〜4回", "5回以上"] as const;
  function liveBucketIndex(count: number): 0 | 1 | 2 | 3 {
    if (count <= 0) return 0;
    if (count === 1) return 1;
    if (count <= 4) return 2;
    return 3;
  }
  function liveBucketLabel(count: number): string {
    return LIVE_BUCKET_LABELS[liveBucketIndex(count)];
  }
  const TIE_IN_CATEGORY_LABELS: Record<TieInCategory, string> = {
    anime: "アニメ",
    other: "アニメ以外",
    none: "タイアップなし",
  };

  const countEl = document.getElementById("wordle-count") as HTMLSpanElement;
  const newButton = document.getElementById("wordle-new-button") as HTMLButtonElement;
  const input = document.getElementById("guess-input") as HTMLInputElement;
  const suggestionsEl = document.getElementById("guess-suggestions") as HTMLUListElement;
  const resultGrid = document.getElementById("result-grid") as HTMLDivElement;
  const endPanel = document.getElementById("wordle-end") as HTMLDivElement;
  const endCover = document.getElementById("wordle-end-cover") as HTMLImageElement;
  const endMessage = document.getElementById("wordle-end-message") as HTMLParagraphElement;
  const endTitle = document.getElementById("wordle-end-title") as HTMLParagraphElement;
  const endLink = document.getElementById("wordle-end-link") as HTMLAnchorElement;

  let target: GameTrack;
  let guessedSlugs: string[] = [];
  let gameOver = false;
  let highlightIndex = -1;

  function randomTrack(excludeSlug?: string): GameTrack {
    const pool = excludeSlug ? gameTracks.filter((t) => t.slug !== excludeSlug) : gameTracks;
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function escapeHtml(str: string): string {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  function startGame(excludeSlug?: string) {
    target = randomTrack(excludeSlug);
    guessedSlugs = [];
    gameOver = false;
    highlightIndex = -1;
    input.value = "";
    input.disabled = false;
    closeSuggestions();
    endPanel.hidden = true;
    resultGrid.innerHTML = "";
    updateCount();

    // 最初の1回はプレイヤーではなくシステム側がランダムに予想を出す
    // (ユーザー要望)。正解そのものを出すと即終了してしまうので、
    // 正解を除いた中からランダムに選ぶ。
    applyGuess(randomTrack(target.slug));
  }

  function updateCount() {
    const remaining = maxGuesses - guessedSlugs.length;
    countEl.textContent = gameOver ? `${guessedSlugs.length}/${maxGuesses}回使用` : `のこり ${remaining}/${maxGuesses}回`;
  }

  // ===== 予想の検索・サジェスト =====
  function closeSuggestions() {
    suggestionsEl.hidden = true;
    suggestionsEl.innerHTML = "";
    highlightIndex = -1;
  }

  function renderSuggestions(query: string) {
    const q = query.trim().toLowerCase();
    if (!q) {
      closeSuggestions();
      return;
    }
    const matches = gameTracks
      .filter((t) => t.title.toLowerCase().includes(q) || (t.tieIn ?? "").toLowerCase().includes(q))
      .slice(0, 8);

    if (matches.length === 0) {
      suggestionsEl.innerHTML = `<li class="guess-suggestion-empty">該当する曲が見つかりませんでした。</li>`;
      suggestionsEl.hidden = false;
      highlightIndex = -1;
      return;
    }

    suggestionsEl.innerHTML = matches
      .map((t, i) => {
        const already = guessedSlugs.includes(t.slug);
        return `
          <li>
            <button type="button" class="guess-suggestion-item${already ? " is-disabled" : ""}" data-slug="${t.slug}" data-index="${i}" ${already ? "disabled" : ""}>
              ${
                t.coverSrc
                  ? `<img class="guess-suggestion-cover" src="${t.coverSrc}" alt="" loading="lazy" />`
                  : `<span class="guess-suggestion-cover guess-suggestion-cover-placeholder" aria-hidden="true">♪</span>`
              }
              <span class="guess-suggestion-body">
                <span class="guess-suggestion-title">${escapeHtml(t.title)}</span>
                <span class="guess-suggestion-date">${escapeHtml(t.date)}</span>
              </span>
              ${already ? `<span class="guess-suggestion-tag">予想済み</span>` : ""}
            </button>
          </li>
        `;
      })
      .join("");
    suggestionsEl.hidden = false;
    highlightIndex = -1;

    suggestionsEl.querySelectorAll<HTMLButtonElement>(".guess-suggestion-item").forEach((button) => {
      button.addEventListener("click", () => {
        if (button.disabled) return;
        submitGuess(button.dataset.slug!);
      });
    });
  }

  input.addEventListener("input", () => {
    if (gameOver) return;
    renderSuggestions(input.value);
  });

  input.addEventListener("keydown", (event) => {
    if (gameOver) return;
    const items = Array.from(suggestionsEl.querySelectorAll<HTMLButtonElement>(".guess-suggestion-item:not(:disabled)"));
    if (event.key === "ArrowDown") {
      event.preventDefault();
      if (items.length === 0) return;
      highlightIndex = (highlightIndex + 1) % items.length;
      items.forEach((it, i) => it.classList.toggle("is-highlighted", i === highlightIndex));
      items[highlightIndex].scrollIntoView({ block: "nearest" });
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      if (items.length === 0) return;
      highlightIndex = (highlightIndex - 1 + items.length) % items.length;
      items.forEach((it, i) => it.classList.toggle("is-highlighted", i === highlightIndex));
      items[highlightIndex].scrollIntoView({ block: "nearest" });
    } else if (event.key === "Enter") {
      event.preventDefault();
      if (highlightIndex >= 0 && items[highlightIndex]) {
        submitGuess(items[highlightIndex].dataset.slug!);
      } else if (items.length === 1) {
        submitGuess(items[0].dataset.slug!);
      }
    } else if (event.key === "Escape") {
      closeSuggestions();
    }
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (!input.contains(event.target) && !suggestionsEl.contains(event.target)) closeSuggestions();
  });

  // ===== 予想の判定・結果表示 =====
  type NumericCmp = "match" | "up" | "down"; // up = 正解はもっと大きい、down = 正解はもっと小さい

  function cmpNumeric(guessVal: number, targetVal: number): NumericCmp {
    if (guessVal === targetVal) return "match";
    return guessVal < targetVal ? "up" : "down";
  }

  function renderResultRow(guess: GameTrack) {
    const groupMatch = guess.group === target.group;
    const yearCmp = cmpNumeric(guess.year, target.year);
    const tieInMatch = guess.tieInCategory === target.tieInCategory;
    const charCmp = cmpNumeric(guess.charCount, target.charCount);
    const mvMatch = guess.hasMV === target.hasMV;
    const albumMatch = guess.inAlbum === target.inAlbum;
    const liveCmp = cmpNumeric(guess.liveCount, target.liveCount);
    // ライブ収録は0/1/2〜4/5以上の段階(0〜3)で「近さ」を見る。
    const liveBucketCmp = cmpNumeric(liveBucketIndex(guess.liveCount), liveBucketIndex(target.liveCount));

    const card = document.createElement("div");
    card.className = "pg-card";

    card.innerHTML = `
      <div class="pg-card-header">
        ${
          guess.coverSrc
            ? `<img class="pg-card-cover" src="${guess.coverSrc}" alt="" loading="lazy" />`
            : `<span class="pg-card-cover pg-card-cover-placeholder" aria-hidden="true">♪</span>`
        }
        <span class="pg-card-title">${escapeHtml(guess.title)}</span>
      </div>
    `;

    const grid = document.createElement("div");
    grid.className = "pg-card-grid";
    card.appendChild(grid);

    // state: "match"(緑/的中) "close"(黄/惜しい) "miss"(グレー/不一致)
    // wide: 1マス分広く使うタイル(名義など情報量が多い項目向け)
    function addTile(label: string, state: "match" | "close" | "miss", text: string, arrow?: "up" | "down", wide = false) {
      const tile = document.createElement("div");
      tile.className = `pg-tile pg-tile-${state}${wide ? " pg-tile-wide" : ""}`;
      tile.innerHTML = `
        <span class="pg-tile-label">${escapeHtml(label)}</span>
        <span class="pg-tile-value">${escapeHtml(text)}${arrow ? `<i class="pg-arrow pg-arrow-${arrow}" aria-hidden="true"></i>` : ""}</span>
      `;
      grid.appendChild(tile);
    }

    // 数値系は「近い(黄)」か「遠い(グレー)」かも見せる。ユーザーが段階を
    // 把握しやすいよう、しきい値はそれぞれの項目の尺度に合わせて決めている。
    function numericState(cmp: NumericCmp, diff: number, closeWithin: number): "match" | "close" | "miss" {
      if (cmp === "match") return "match";
      return diff <= closeWithin ? "close" : "miss";
    }

    addTile("名義", groupMatch ? "match" : "miss", guess.group, undefined, true);
    addTile(
      "発売年",
      numericState(yearCmp, Math.abs(guess.year - target.year), 2),
      String(guess.year),
      yearCmp === "match" ? undefined : yearCmp
    );
    addTile("タイアップ", tieInMatch ? "match" : "miss", TIE_IN_CATEGORY_LABELS[guess.tieInCategory]);
    addTile(
      "文字数",
      numericState(charCmp, Math.abs(guess.charCount - target.charCount), 2),
      `${guess.charCount}文字`,
      charCmp === "match" ? undefined : charCmp
    );
    addTile("MV", mvMatch ? "match" : "miss", guess.hasMV ? "MVあり" : "MVなし");
    addTile("アルバム収録", albumMatch ? "match" : "miss", guess.inAlbum ? "収録あり" : "収録なし");
    addTile(
      "ライブ収録",
      numericState(liveBucketCmp, Math.abs(liveBucketIndex(guess.liveCount) - liveBucketIndex(target.liveCount)), 1),
      liveBucketLabel(guess.liveCount),
      liveCmp === "match" ? undefined : liveCmp
    );

    resultGrid.appendChild(card);
  }

  function endGame(won: boolean) {
    gameOver = true;
    input.disabled = true;
    closeSuggestions();
    updateCount();

    endPanel.hidden = false;
    endMessage.textContent = won
      ? `正解です！${guessedSlugs.length}回目で当てました 🎉`
      : `残念、${maxGuesses}回以内に当てられませんでした。正解は…`;
    endTitle.textContent = target.title;
    endLink.href = `/works/${target.slug}`;
    if (target.coverSrc) {
      endCover.src = target.coverSrc;
      endCover.hidden = false;
    } else {
      endCover.hidden = true;
    }
  }

  // 予想を1件確定させて結果行を描画し、勝敗判定まで行う共通処理。
  // 手入力の予想(submitGuess)と、初回にシステムが自動で出す予想の両方から呼ぶ。
  function applyGuess(guess: GameTrack) {
    guessedSlugs.push(guess.slug);
    renderResultRow(guess);
    updateCount();

    if (guess.slug === target.slug) {
      endGame(true);
    } else if (guessedSlugs.length >= maxGuesses) {
      endGame(false);
    }
  }

  function submitGuess(slug: string) {
    if (gameOver || guessedSlugs.includes(slug)) return;
    const guess = gameTracks.find((t) => t.slug === slug);
    if (!guess) return;

    applyGuess(guess);
    input.value = "";
    closeSuggestions();
    if (!gameOver) input.focus();
  }

  newButton.addEventListener("click", () => startGame(target?.slug));

  startGame();
</script>

