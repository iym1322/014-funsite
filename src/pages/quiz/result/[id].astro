---
// オーイシ検定の結果シェア用ページ。ランキングに記録した人だけが固有URLを
// 得られる(ランキング未記録の場合はテキストのみのシェアにフォールバックする)。
// スコア等の実データはSupabaseへ問い合わせず、URLのクエリパラメータから
// そのまま描画する(このページ自体は軽量な表示専用で、[id]はシェアURLを
// 一意にするためだけに使っている)。
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";

const { id } = Astro.params;

const score = Math.max(0, Math.floor(Number(Astro.url.searchParams.get("score") ?? "0")));
const total = Math.max(1, Math.floor(Number(Astro.url.searchParams.get("total") ?? "1")));
const timeSec = Math.max(0, Number(Astro.url.searchParams.get("time") ?? "0"));
const nickname = (Astro.url.searchParams.get("nickname") ?? "名無し").slice(0, 20);
const rank = (Astro.url.searchParams.get("rank") ?? "").slice(0, 20);
const isPerfect = score === total;

const ogImageParams = new URLSearchParams({
  score: String(score),
  total: String(total),
  time: timeSec.toFixed(1),
  nickname,
  rank,
});
const ogImage = new URL(`/api/quiz-og-image?${ogImageParams.toString()}`, Astro.site).toString();

const pageTitle = `${nickname}さんの結果: ${score}/${total}問正解(${timeSec.toFixed(1)}秒) | オーイシ検定`;
const pageDescription =
  "オーイシマサヨシ／大石昌良に関する四択クイズ「オーイシ検定」の結果です。あなたも挑戦してみませんか？";
---

<Layout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <h1>オーイシ検定の結果</h1>
  <p class="note">「{nickname}」さんがオーイシ検定に挑戦した記録です(ID: {id})。</p>

  <img
    class:list={["result-share-image", { "is-perfect": isPerfect }]}
    src={ogImage}
    width="1200"
    height="630"
    alt={`${nickname}さんの結果: ${score}/${total}問正解(${timeSec.toFixed(1)}秒)`}
  />

  <a class="cta-button" href="/quiz">自分も挑戦してみる →</a>
</Layout>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .result-share-image {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .result-share-image.is-perfect {
    border: 2px solid #e6b93d;
    box-shadow: 0 0 28px rgba(230, 185, 61, 0.4), 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .cta-button {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    text-decoration: none;
    font-weight: 700;
  }
</style>
