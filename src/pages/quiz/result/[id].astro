---
// オーイシ検定の結果シェア用ページ。ランキングに記録した人だけが固有URLを
// 得られる(ランキング未記録の場合はテキストのみのシェアにフォールバックする)。
// スコア等の実データはSupabaseへ問い合わせず、URLのクエリパラメータから
// そのまま描画する(このページ自体は軽量な表示専用で、[id]はシェアURLを
// 一意にするためだけに使っている)。
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";

const { id } = Astro.params;

const score = Math.max(0, Math.floor(Number(Astro.url.searchParams.get("score") ?? "0")));
const total = Math.max(1, Math.floor(Number(Astro.url.searchParams.get("total") ?? "1")));
const timeSec = Math.max(0, Number(Astro.url.searchParams.get("time") ?? "0"));
const nickname = (Astro.url.searchParams.get("nickname") ?? "名無し").slice(0, 20);
const rank = (Astro.url.searchParams.get("rank") ?? "").slice(0, 20);
const isPerfect = score === total;

const ogImageParams = new URLSearchParams({
  score: String(score),
  total: String(total),
  time: timeSec.toFixed(1),
  nickname,
  rank,
});
const ogImage = new URL(`/api/quiz-og-image?${ogImageParams.toString()}`, Astro.site).toString();

const pageTitle = `${nickname}さんの結果: ${score}/${total}問正解(${timeSec.toFixed(1)}秒) | オーイシ検定`;
const pageDescription =
  "オーイシマサヨシ／大石昌良に関する四択クイズ「オーイシ検定」の結果です。あなたも挑戦してみませんか？";
---

<Layout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <h1>オーイシ検定の結果</h1>
  <p class="note">「{nickname}」さんがオーイシ検定に挑戦した記録です(ID: {id})。</p>

  <div class:list={["result-share-card", { "is-perfect": isPerfect }]}>
    {rank && <p class="rank">{rank}</p>}
    <p class="score">{score} / {total} 問正解</p>
    <p class="time">平均解答タイム {timeSec.toFixed(1)}秒</p>
    <p class="nickname">記録者: {nickname}</p>
  </div>

  <a class="cta-button" href="/quiz">自分も挑戦してみる →</a>
</Layout>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .result-share-card {
    margin: 1.5rem 0;
    padding: 2rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    text-align: center;
  }

  .result-share-card.is-perfect {
    border: 2px solid #e6b93d;
    background: linear-gradient(160deg, var(--color-surface), #fff6da 60%, #ffe9a8);
    box-shadow: 0 0 28px rgba(230, 185, 61, 0.4), 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .rank {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.3rem 1.1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--color-bg);
    color: var(--color-text-muted);
  }

  .is-perfect .rank {
    background: linear-gradient(90deg, #f0b429, #ffdf7e);
    color: #5c3d00;
  }

  .score {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 700;
  }

  .time {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
  }

  .nickname {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .cta-button {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    text-decoration: none;
    font-weight: 700;
  }
</style>
