---
// 曲ごとの個別ページ。discography.ts で slug を持つ曲だけが生成される。
// (design確認のため、現時点ではslugを設定した3曲のみが対象)
import Layout from "../../layouts/Layout.astro";
import TrackCover from "../../components/TrackCover.astro";
import { tracks } from "../../data/discography";
import { favoritePosts } from "../../data/favorites";

export function getStaticPaths() {
  return tracks
    .filter((t) => t.slug)
    .map((t) => ({ params: { slug: t.slug }, props: { track: t } }));
}

const { track } = Astro.props;

// 埋め込みは公式チャンネルの動画であることを確認済みのtrack.youtubeがある場合のみ表示する
// (YouTubeの埋め込み機能自体が投稿者=権利者が許可した範囲の利用のため著作権上問題ない)。
function getYouTubeId(url?: string): string | null {
  if (!url) return null;
  const match = url.match(/(?:v=|youtu\.be\/)([\w-]{11})/);
  return match ? match[1] : null;
}
const youtubeId = getYouTubeId(track.youtube);

// 個別ページを持つ曲を一覧ページと同じ並び順(リリース日が新しい順)に揃え、前後の曲への導線を出す。
const navigable = tracks.filter((t) => t.slug).sort((a, b) => b.sortDate.localeCompare(a.sortDate));
const currentIndex = navigable.findIndex((t) => t.slug === track.slug);
const prevTrack = currentIndex > 0 ? navigable[currentIndex - 1] : null;
const nextTrack = currentIndex >= 0 && currentIndex < navigable.length - 1 ? navigable[currentIndex + 1] : null;

// この曲が歌われたライブ映像(セットリストにこの曲のslugが含まれるもの)を逆引きする。
const relatedLives = tracks.filter(
  (t) => t.type === "映像" && t.isLive && t.setlist?.some((s) => s.slug === track.slug)
);

// この曲への推し曲コーナー投稿を逆引きする(現状はサンプル投稿のみ)。
const relatedFavorites = favoritePosts.filter((p) => p.trackSlug === track.slug);
---

<Layout title={`${track.title} | ディスコグラフィー | オーイシマサヨシ非公式ファンサイト`}>
  <a class="back-link" href="/works">← ディスコグラフィー一覧に戻る</a>

  <article class="track-detail">
    <div class="cover-col">
      <TrackCover image={track.image} title={track.title} />
    </div>

    <div class="info-col">
      <p class="meta">{track.group} ・ {track.type} ・ {track.date}</p>
      <h1>{track.title}</h1>

      {track.tieIn && (
        <p class="tie-in">{track.tieIn}</p>
      )}

      {track.note && <p class="note">{track.note}</p>}

      {track.description && (
        <section class="description">
          <h2>楽曲について</h2>
          <p>{track.description}</p>
        </section>
      )}

      {relatedLives.length > 0 && (
        <section class="related-lives">
          <h2>関連ライブ映像</h2>
          <ul>
            {relatedLives.map((live) => (
              <li><a href={`/works/${live.slug}`}>{live.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      {track.type === "アルバム" && (
        <section class="tracklist">
          <h2>収録曲</h2>
          {track.tracklist && track.tracklist.length > 0 ? (
            <ol>
              {track.tracklist.map((t) => (
                <li>{t.slug ? <a href={`/works/${t.slug}`}>{t.title}</a> : t.title}</li>
              ))}
            </ol>
          ) : (
            <p class="pending">収録曲情報は準備中です。</p>
          )}
        </section>
      )}

      {track.type === "映像" && track.isLive && (
        <section class="tracklist">
          <h2>セットリスト</h2>
          {track.setlist && track.setlist.length > 0 ? (
            <ol>
              {track.setlist.map((t) => (
                <li>{t.slug ? <a href={`/works/${t.slug}`}>{t.title}</a> : t.title}</li>
              ))}
            </ol>
          ) : (
            <p class="pending">セットリストは準備中です。</p>
          )}
        </section>
      )}

      {track.type === "シングル" && (
        <section class="links">
          <h2>各種リンク</h2>
          <ul>
            {track.youtube && (
              <li><a href={track.youtube} target="_blank" rel="noopener noreferrer">YouTube で見る</a></li>
            )}
            {track.appleMusic && (
              <li><a href={track.appleMusic} target="_blank" rel="noopener noreferrer">Apple Music で聴く</a></li>
            )}
            {track.spotify && (
              <li><a href={track.spotify} target="_blank" rel="noopener noreferrer">Spotify で聴く</a></li>
            )}
            {!track.youtube && !track.appleMusic && !track.spotify && (
              <li class="no-link">リンク準備中</li>
            )}
          </ul>
        </section>
      )}

      <section class="favorites-preview">
        <h2>みんなの推しコメント</h2>
        {relatedFavorites.length > 0 ? (
          <ul>
            {relatedFavorites.map((post) => (
              <li>
                <p class="favorite-body">{post.body}</p>
                <p class="favorite-author">
                  {post.author}
                  {post.isSample && <span class="sample-badge">サンプル</span>}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="pending">この曲へのコメントはまだありません。</p>
        )}
        <a class="favorites-cta" href="/favorites">推し曲コーナーを見る →</a>
      </section>

      <section class="vote-preview">
        <h2>この曲に投票する</h2>
        <p class="pending-note">投票機能は準備中です。人気ランキングは今後追加予定です。</p>
        <button class="vote-button" type="button">👍 投票する(準備中)</button>
      </section>

      {youtubeId && (
        <section class="video">
          <h2>MV</h2>
          <div class="video-frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
              title={`${track.title} MV`}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )}
    </div>
  </article>

  <nav class="track-pager">
    {prevTrack ? (
      <a class="pager-link prev" href={`/works/${prevTrack.slug}`}>
        <span class="pager-label">← 前の曲</span>
        <span class="pager-title">{prevTrack.title}</span>
      </a>
    ) : <span />}
    {nextTrack ? (
      <a class="pager-link next" href={`/works/${nextTrack.slug}`}>
        <span class="pager-label">次の曲 →</span>
        <span class="pager-title">{nextTrack.title}</span>
      </a>
    ) : <span />}
  </nav>
</Layout>

<script>
  document.querySelector(".vote-button")?.addEventListener("click", () => {
    alert("投票機能は準備中です。もうしばらくお待ちください。");
  });
</script>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .track-detail {
    display: grid;
    grid-template-columns: minmax(0, 18rem) 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .track-detail {
      grid-template-columns: 1fr;
    }
    .cover-col {
      max-width: 16rem;
      margin: 0 auto;
    }
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
  }

  .tie-in {
    color: var(--color-accent);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .video h2,
  .description h2,
  .tracklist h2,
  .links h2 {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0 0.5rem;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .description p {
    line-height: 1.9;
  }

  .tracklist ol {
    margin: 0;
    padding-left: 1.4rem;
    line-height: 2;
  }

  .tracklist a {
    color: var(--color-text);
  }

  .tracklist a:hover {
    color: var(--color-accent);
  }

  .pending {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .links a {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .no-link {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .related-lives h2 {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0 0.5rem;
  }

  .related-lives ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-lives a {
    color: var(--color-text);
  }

  .related-lives a:hover {
    color: var(--color-accent);
  }

  .favorites-preview h2,
  .vote-preview h2 {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0 0.5rem;
  }

  .favorites-preview ul {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .favorites-preview li {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  .favorite-body {
    margin: 0 0 0.4rem;
    line-height: 1.7;
  }

  .favorite-author {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sample-badge {
    font-size: 0.7rem;
    background: #f4e8de;
    color: #a3663f;
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
  }

  .favorites-cta {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .pending-note {
    color: var(--color-accent);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }

  .vote-button {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .vote-button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .track-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text);
    min-width: 0;
  }

  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-link:hover {
    border-color: var(--color-accent);
  }

  .pager-link:hover .pager-title {
    color: var(--color-accent);
  }

  .pager-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .pager-title {
    font-size: 0.95rem;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
</style>
