---
// 曲ごとの個別ページ。discography.ts で slug を持つ曲だけが生成される。
// (design確認のため、現時点ではslugを設定した3曲のみが対象)
import Layout from "../../layouts/Layout.astro";
import TrackCover from "../../components/TrackCover.astro";
import { tracks } from "../../data/discography";
import { rankingQuestions, resolveRankingChoices } from "../../data/ranking";

export function getStaticPaths() {
  return tracks
    .filter((t) => t.slug)
    .map((t) => ({ params: { slug: t.slug }, props: { track: t } }));
}

const { track } = Astro.props;

// 埋め込みは公式チャンネルの動画であることを確認済みのtrack.youtubeがある場合のみ表示する
// (YouTubeの埋め込み機能自体が投稿者=権利者が許可した範囲の利用のため著作権上問題ない)。
function getYouTubeId(url?: string): string | null {
  if (!url) return null;
  const match = url.match(/(?:v=|youtu\.be\/)([\w-]{11})/);
  return match ? match[1] : null;
}
const youtubeId = getYouTubeId(track.youtube);
const linkArtist = track.group === "楽曲提供" ? (track.subject ?? "大石昌良") : track.group;
const searchQuery = encodeURIComponent(`${linkArtist} ${track.title}`);
const youtubeSearchUrl = `https://www.youtube.com/results?search_query=${searchQuery}`;
const appleMusicSearchUrl = `https://music.apple.com/jp/search?term=${searchQuery}`;
const spotifySearchUrl = `https://open.spotify.com/search/${searchQuery}`;

// 個別ページを持つ曲を一覧ページと同じ並び順(リリース日が新しい順)に揃え、前後の曲への導線を出す。
const navigable = tracks.filter((t) => t.slug).sort((a, b) => b.sortDate.localeCompare(a.sortDate));
const currentIndex = navigable.findIndex((t) => t.slug === track.slug);
const prevTrack = currentIndex > 0 ? navigable[currentIndex - 1] : null;
const nextTrack = currentIndex >= 0 && currentIndex < navigable.length - 1 ? navigable[currentIndex + 1] : null;

// この曲が歌われたライブ映像(セットリストにこの曲のslugが含まれるもの)を逆引きする。
const relatedLives = tracks.filter(
  (t) =>
    t.type === "映像" &&
    t.isLive &&
    (t.setlist?.some((s) => s.slug === track.slug) ||
      t.setlists?.some((group) => group.tracks.some((s) => s.slug === track.slug)))
);

const relatedAlbums = tracks.filter(
  (t) => t.type === "アルバム" && t.tracklist?.some((s) => s.slug === track.slug)
);

// この曲が候補になっている「勝手にランキング」のお題を逆引きする。
const relatedRankingQuestions = rankingQuestions.filter((q) =>
  resolveRankingChoices(q).some((c) => c.trackSlug === track.slug)
);
const relatedRankingQuestionsForClient = relatedRankingQuestions.map((q) => ({
  id: q.id,
  question: q.question,
  choiceSlugs: resolveRankingChoices(q).map((c) => c.trackSlug),
}));
---

<Layout title={`${track.title} | ディスコグラフィー | 014 BASE`}>
  <a class="back-link" href="/works">← ディスコグラフィー一覧に戻る</a>

  <article class="track-detail">
    <div class="cover-col">
      <TrackCover image={track.image} title={track.title} />
    </div>

    <div class="info-col">
      <p class="meta">{track.group} ・ {track.type} ・ {track.date}</p>
      <h1>{track.title}</h1>

      {track.tieIn && (
        <p class="tie-in">{track.tieIn}</p>
      )}

      {track.note && <p class="note">{track.note}</p>}

      <ul class="rank-badges" id="rank-badges" hidden></ul>

      {track.description && (
        <section class="description">
          <h2>楽曲について</h2>
          <p>{track.description}</p>
        </section>
      )}

      {relatedLives.length > 0 && (
        <section class="related-lives">
          <h2>関連ライブ映像</h2>
          <ul>
            {relatedLives.map((live) => (
              <li><a href={`/works/${live.slug}`}>{live.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      {relatedAlbums.length > 0 && (
        <section class="related-lives">
          <h2>収録アルバム</h2>
          <ul>
            {relatedAlbums.map((album) => (
              <li><a href={`/works/${album.slug}`}>{album.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      {track.type === "アルバム" && (
        <section class="tracklist">
          <h2>収録曲</h2>
          {track.tracklist && track.tracklist.length > 0 ? (
            <ol>
              {track.tracklist.map((t) => (
                <li>{t.slug ? <a href={`/works/${t.slug}`}>{t.title}</a> : t.title}</li>
              ))}
            </ol>
          ) : (
            <p class="pending">収録曲情報は準備中です。</p>
          )}
        </section>
      )}

      {track.type === "映像" && track.isLive && (
        <section class="tracklist">
          <h2>セットリスト</h2>
          {track.setlists && track.setlists.length > 0 ? (
            <div class="setlist-groups">
              {track.setlists.map((group) => (
                <section class="setlist-group">
                  <h3>{group.title}</h3>
                  <ol>
                    {group.tracks.map((t) => (
                      <li>{t.slug ? <a href={`/works/${t.slug}`}>{t.title}</a> : t.title}</li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          ) : track.setlist && track.setlist.length > 0 ? (
            <ol>
              {track.setlist.map((t) => (
                <li>{t.slug ? <a href={`/works/${t.slug}`}>{t.title}</a> : t.title}</li>
              ))}
            </ol>
          ) : (
            <p class="pending">セットリストは準備中です。</p>
          )}
        </section>
      )}

      {(track.type === "シングル" || track.type === "提供曲") && (
        <section class="links">
          <h2>各種リンク</h2>
          <ul>
            <li>
              <a href={track.youtube ?? youtubeSearchUrl} target="_blank" rel="noopener noreferrer">
                {track.youtube ? "YouTube で見る" : "YouTube で検索"}
              </a>
            </li>
            <li>
              <a href={track.appleMusic ?? appleMusicSearchUrl} target="_blank" rel="noopener noreferrer">
                {track.appleMusic ? "Apple Music で聴く" : "Apple Music で検索"}
              </a>
            </li>
            <li>
              <a href={track.spotify ?? spotifySearchUrl} target="_blank" rel="noopener noreferrer">
                {track.spotify ? "Spotify で聴く" : "Spotify で検索"}
              </a>
            </li>
          </ul>
          {(!track.youtube || !track.appleMusic || !track.spotify) && (
            <p class="link-note">直接リンク未確認のサービスは、名義と曲名による検索結果を開きます。</p>
          )}
        </section>
      )}

      <section class="favorites-preview">
        <h2>みんなの推しコメント</h2>
        <p class="pending" id="favorites-loading">読み込み中...</p>
        <ul id="favorites-list"></ul>
        <a class="favorites-cta" href="/favorites">推し曲コーナーで投稿する →</a>
      </section>

      {relatedRankingQuestions.length > 0 && (
        <section class="vote-preview">
          <h2>関連するランキング</h2>
          <ul class="ranking-links">
            {relatedRankingQuestions.map((q) => (
              <li><a href={`/ranking/${q.id}`}>「{q.question}」に投票する →</a></li>
            ))}
          </ul>
        </section>
      )}

      <script
        type="application/json"
        id="ranking-questions-data"
        set:html={JSON.stringify(relatedRankingQuestionsForClient)}
      />

      {youtubeId && (
        <section class="video">
          <h2>MV</h2>
          <div class="video-frame">
            <iframe
              src={`https://www.youtube.com/embed/${youtubeId}`}
              title={`${track.title} MV`}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      )}
    </div>
  </article>

  <nav class="track-pager">
    {prevTrack ? (
      <a class="pager-link prev" href={`/works/${prevTrack.slug}`}>
        <span class="pager-label">← 前の曲</span>
        <span class="pager-title">{prevTrack.title}</span>
      </a>
    ) : <span />}
    {nextTrack ? (
      <a class="pager-link next" href={`/works/${nextTrack.slug}`}>
        <span class="pager-label">次の曲 →</span>
        <span class="pager-title">{nextTrack.title}</span>
      </a>
    ) : <span />}
  </nav>
</Layout>

<script define:vars={{ trackSlug: track.slug }}>
  window.__trackSlugForFavorites = trackSlug;
</script>
<script>
  import { supabase } from "../../lib/supabase";

  type FavoritePost = {
    id: string;
    author: string;
    body: string;
    likes: number;
  };

  const trackSlug = (window as any).__trackSlugForFavorites as string;
  const loading = document.getElementById("favorites-loading") as HTMLParagraphElement;
  const list = document.getElementById("favorites-list") as HTMLUListElement;

  // 高評価は月ごとにリセットする("YYYY-MM"が変われば再度いいね可能)。
  function currentMonthKey(): string {
    return new Date().toISOString().slice(0, 7);
  }

  function renderPost(post: FavoritePost) {
    const li = document.createElement("li");
    li.innerHTML = `
      <p class="favorite-body"></p>
      <p class="favorite-author"></p>
      <button class="like-button" type="button">👍 <span class="like-count">${post.likes}</span></button>
    `;
    (li.querySelector(".favorite-body") as HTMLElement).textContent = post.body;
    (li.querySelector(".favorite-author") as HTMLElement).textContent = post.author;

    const likedKey = `funsite-liked-${post.id}`;
    const likeButton = li.querySelector(".like-button") as HTMLButtonElement;
    if (localStorage.getItem(likedKey) === currentMonthKey()) {
      likeButton.disabled = true;
      likeButton.classList.add("liked");
    }
    likeButton.addEventListener("click", async () => {
      if (localStorage.getItem(likedKey) === currentMonthKey()) return;
      likeButton.disabled = true;
      const { error } = await supabase.rpc("increment_favorite_likes", { post_id: post.id });
      if (error) {
        likeButton.disabled = false;
        return;
      }
      localStorage.setItem(likedKey, currentMonthKey());
      likeButton.classList.add("liked");
      const countEl = likeButton.querySelector(".like-count") as HTMLElement;
      countEl.textContent = String(Number(countEl.textContent) + 1);
    });

    return li;
  }

  async function loadFavorites() {
    const { data, error } = await supabase
      .from("favorite_posts")
      .select("*")
      .eq("track_slug", trackSlug)
      .order("created_at", { ascending: false });

    loading.style.display = "none";

    if (error || !data || data.length === 0) {
      const empty = document.createElement("li");
      empty.className = "pending";
      empty.textContent = "この曲へのコメントはまだありません。";
      list.appendChild(empty);
      return;
    }
    for (const post of data as FavoritePost[]) {
      list.appendChild(renderPost(post));
    }
  }

  loadFavorites();

  type RelatedRankingQuestion = { id: string; question: string; choiceSlugs: string[] };

  const relatedRankingQuestions: RelatedRankingQuestion[] = JSON.parse(
    document.getElementById("ranking-questions-data")!.textContent!
  );
  const rankBadgesEl = document.getElementById("rank-badges") as HTMLUListElement;

  async function loadRankBadges() {
    if (relatedRankingQuestions.length === 0) return;

    const { data } = await supabase
      .from("ranking_results")
      .select("*")
      .in("question_id", relatedRankingQuestions.map((q) => q.id));

    const countsByQuestion = new Map<string, Map<string, number>>();
    for (const row of (data ?? []) as { question_id: string; track_slug: string; votes: number }[]) {
      if (!countsByQuestion.has(row.question_id)) countsByQuestion.set(row.question_id, new Map());
      countsByQuestion.get(row.question_id)!.set(row.track_slug, row.votes);
    }

    const rankMedals = ["🥇", "🥈", "🥉"];
    const badges: { id: string; question: string; rank: number; votes: number }[] = [];

    for (const q of relatedRankingQuestions) {
      const counts = countsByQuestion.get(q.id) ?? new Map<string, number>();
      const ranked = q.choiceSlugs
        .map((slug) => ({ slug, votes: counts.get(slug) ?? 0 }))
        .sort((a, b) => b.votes - a.votes);
      const index = ranked.findIndex((r) => r.slug === trackSlug);
      if (index === -1 || index >= 3) continue;
      const votes = ranked[index].votes;
      if (votes <= 0) continue;
      badges.push({ id: q.id, question: q.question, rank: index + 1, votes });
    }

    if (badges.length === 0) return;

    rankBadgesEl.innerHTML = "";
    for (const badge of badges) {
      const li = document.createElement("li");
      const link = document.createElement("a");
      link.href = `/ranking/${badge.id}`;
      link.textContent = `${rankMedals[badge.rank - 1] ?? `${badge.rank}位`} 「${badge.question}」${badge.rank}位(${badge.votes}票)`;
      li.appendChild(link);
      rankBadgesEl.appendChild(li);
    }
    rankBadgesEl.hidden = false;
  }

  loadRankBadges();
</script>

<style is:global>
  /* is:global: 「みんなの推しコメント」等をブラウザ側JSで動的生成しているため、
     Astroのスコープ付きCSSでは動的要素に適用されない(data-astro-cid-*が付与されないため)。 */
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .track-detail {
    display: grid;
    grid-template-columns: minmax(0, 18rem) 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .track-detail {
      grid-template-columns: 1fr;
    }
    .cover-col {
      max-width: 16rem;
      margin: 0 auto;
    }
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
  }

  .tie-in {
    color: var(--color-accent);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .rank-badges {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .rank-badges a {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    background: #fbf3ea;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .rank-badges a:hover {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .video h2,
  .description h2,
  .tracklist h2,
  .links h2 {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0 0.5rem;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .description p {
    line-height: 1.9;
  }

  .tracklist ol {
    margin: 0;
    padding-left: 1.4rem;
    line-height: 2;
  }

  .setlist-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .setlist-group {
    margin: 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .setlist-group h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .tracklist a {
    color: var(--color-text);
  }

  .tracklist a:hover {
    color: var(--color-accent);
  }

