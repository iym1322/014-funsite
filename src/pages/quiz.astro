    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .quiz-start {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .start-lead {
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .count-picker {
    margin: 0 0 1.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .count-picker legend {
    padding: 0 0.35rem;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .count-option {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .count-option input {
    width: auto;
  }

  .difficulty-picker {
    margin: 0 0 1.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .difficulty-picker legend {
    padding: 0 0.35rem;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .difficulty-option {
