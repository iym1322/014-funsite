---
// オーイシ検定(CONTENTS_PLAN.md C-27「クイズコーナー」)。
// 静的な四択クイズで、投稿・投票のようなSupabase連携は不要(全問クライアント内で完結)。
// 問題順・選択肢順は毎回シャッフルし、周回プレイでも新鮮に楽しめるようにしている。
import Layout from "../layouts/Layout.astro";
import { quizQuestions } from "../data/quiz_fun";

// 出題数の候補ライン。総問題数を上回るものはJS側で非表示にする。
const countBreakpoints = [10, 20, 50, 100];

// みんなの投稿問題は一時的に非表示(コードは残し、フォーム・一覧の表示と
// 出題プールへの合流だけ止めている)。復活させる際はこれをtrueに戻すだけでよい。
// script側の SUBMISSIONS_ENABLED と必ず合わせること。
const submissionsVisible = false;

// ジャンル(categories)は問題データから動的に抽出する(固定の選択肢にすると
// 問題を追加するたびにページ側の修正が必要になってしまうため)。1問が複数
// ジャンルにまたがることもあるため flatMap で展開してから重複を除く。
// 出現順(=quiz.ts内の並び順)をそのままジャンルの表示順にする。
const categories = [...new Set(quizQuestions.flatMap((q) => q.categories))];
---

<Layout title="オーイシ検定 | 014 BASE">
  <h1>オーイシ検定</h1>
  <p class="note">
    オーイシマサヨシ／大石昌良に関する四択クイズです。全{quizQuestions.length}問、
    間違えても大丈夫。1問ごとに解説つきなので、クイズを通して知識を深められます。
    内容が事実と違うと思ったら、解説の下にある通報ボタンからお知らせください。
  </p>

  <div class="quiz-start" id="quiz-start">
    <p class="start-lead">出題数を選んでスタートしてください。</p>
    <fieldset class="count-picker">
      <legend>出題数</legend>
      {countBreakpoints.map((n) => (
        <label class="count-option" data-breakpoint={n}>
          <input type="radio" name="quiz-count" value={String(n)} />
          <span class="count-label"></span>
        </label>
      ))}
      <label class="count-option" data-breakpoint="all">
        <input type="radio" name="quiz-count" value="all" checked />
        <span class="count-label"></span>
      </label>
      <p class="field-help" id="count-lock-note" hidden>
        100問・全部を選んだ場合、出題数を確保するためジャンル・難易度は「すべて」に固定されます。
      </p>
    </fieldset>
    <fieldset class="difficulty-picker">
      <legend>難易度</legend>
      <label class="difficulty-option">
        <input type="radio" name="quiz-difficulty" value="all" checked />
        すべて
      </label>
      <label class="difficulty-option">
        <input type="radio" name="quiz-difficulty" value="初級" />
        初級
      </label>
      <label class="difficulty-option">
        <input type="radio" name="quiz-difficulty" value="中級" />
        中級
      </label>
      <label class="difficulty-option">
        <input type="radio" name="quiz-difficulty" value="上級" />
        上級
      </label>
      <p class="field-help">
        みんなの正答率が一定数たまった問題だけ難易度で絞り込まれます。データが少ない問題はどの難易度でも出題されます。
        初級・上級を選ぶと、橋渡しとして中級の問題も2割ほど混ざります。
      </p>
    </fieldset>
    <fieldset class="genre-picker">
      <legend>ジャンル(複数選択可)</legend>
      <label class="genre-option">
        <input type="checkbox" name="quiz-genre" value="all" data-all checked />
        すべて
        <span class="genre-count"></span>
      </label>
      {categories.map((c) => (
        <label class="genre-option">
          <input type="checkbox" name="quiz-genre" value={c} checked />
          {c}
          <span class="genre-count"></span>
        </label>
      ))}
    </fieldset>
    <button type="button" class="start-button" id="start-button">検定をはじめる</button>
  </div>

  <div class="quiz-panel" id="quiz-panel" hidden>
    <p class="quiz-progress" id="quiz-progress"></p>
    <div class="quiz-meta-row">
      <span class="difficulty-badge" id="difficulty-badge" hidden></span>
      <div class="quiz-category-list" id="quiz-category"></div>
    </div>
    <h2 class="quiz-question" id="quiz-question"></h2>

    <div class="quiz-choices">
      <button type="button" class="choice-button" data-index="0">
        <span class="choice-letter">A</span><span class="choice-text"></span>
      </button>
      <button type="button" class="choice-button" data-index="1">
        <span class="choice-letter">B</span><span class="choice-text"></span>
      </button>
      <button type="button" class="choice-button" data-index="2">
        <span class="choice-letter">C</span><span class="choice-text"></span>
      </button>
      <button type="button" class="choice-button" data-index="3">
        <span class="choice-letter">D</span><span class="choice-text"></span>
      </button>
    </div>

    <div class="quiz-explanation" id="quiz-explanation" hidden>
      <div class="verdict-row">
        <p class="quiz-verdict" id="quiz-verdict"></p>
        <button type="button" class="next-button" id="next-button"></button>
      </div>
      <p class="quiz-explanation-text" id="quiz-explanation-text"></p>
      <a class="related-link" id="related-link" href="#" hidden>関連ページを見る →</a>
      <div class="explanation-footer">
        <button type="button" class="flag-button" id="flag-button">⚠ この解説、事実と違うかも</button>
      </div>
    </div>
  </div>

  <div class="quiz-result" id="quiz-result" hidden>
    <p class="result-rank" id="result-rank"></p>
    <p class="result-score" id="result-score"></p>
    <p class="result-time" id="result-time"></p>
    <p class="result-message" id="result-message"></p>

    <div class="result-ranking" id="result-ranking" hidden>
      <p class="field-help">
        難易度・ジャンルをどちらも「すべて」で選んだ場合のみ、記録を任意でランキングに残せます。
      </p>
      <form id="ranking-form">
        <label>
          ニックネーム
          <input type="text" id="ranking-nickname" maxlength="20" required placeholder="例: 014ファン" />
        </label>
        <button type="submit" id="ranking-submit-button">ランキングに記録する</button>
        <p class="form-message" id="ranking-form-message" role="status"></p>
      </form>
    </div>

    <div class="result-actions">
      <button type="button" class="share-button" id="share-button" hidden>結果をXでシェア</button>
      <button type="button" class="retry-button" id="retry-button">もう一度挑戦する</button>
    </div>
  </div>

  <section class="quiz-ranking-board">
    <h2>ランキング</h2>
    <p class="note">
      難易度・ジャンルを絞り込まずにプレイし、ランキング掲載を選んだ人の記録です。正解数が多い順、同数の場合は平均解答タイムが速い順に表示しています。
    </p>
    <div class="ranking-tabs">
      <button type="button" class="ranking-tab is-active" id="ranking-tab-10" data-mode="10">10問</button>
      <button type="button" class="ranking-tab" id="ranking-tab-20" data-mode="20">20問</button>
      <button type="button" class="ranking-tab" id="ranking-tab-50" data-mode="50">50問</button>
      <button type="button" class="ranking-tab" id="ranking-tab-100" data-mode="100">100問</button>
      <button type="button" class="ranking-tab" id="ranking-tab-all" data-mode="all">全部</button>
    </div>
    <div class="ranking-table-wrap">
      <table class="ranking-board-table">
        <thead>
          <tr>
            <th class="col-rank">順位</th>
            <th class="col-nickname">ニックネーム</th>
            <th class="col-score">正解数</th>
            <th class="col-time">タイム</th>
          </tr>
        </thead>
        <tbody id="ranking-board-list">
          <tr>
            <td class="loading-message" colspan="4">読み込み中...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="submission-list" hidden={!submissionsVisible}>
    <h2>みんなの投稿問題</h2>
    <p class="note">
      ファンのみなさんが投稿したオリジナル問題です。内容の確認は事後確認となります
      (内容の正確性は投稿者の責任となります)。不適切な内容は発見次第削除します。
      投稿された問題は、この一覧に加えて上の検定本編でも「投稿問題」バッジ付きで
      出題されることがあります。内容が事実と違うと思ったら、通報ボタンからお知らせください。
    </p>
    <p class="loading-message" id="submission-loading">読み込み中...</p>
    <ul id="submission-items"></ul>
  </section>

  <section class="submission-form" hidden={!submissionsVisible}>
    <h2>問題を投稿する</h2>
    <form id="submission-form">
      <label>
        カテゴリ
        <input type="text" name="category" id="submission-category" maxlength="30" required placeholder="例: プロフィール、OxT" />
      </label>
      <label>
        問題文
        <textarea name="question" id="submission-question" rows="2" maxlength="200" required placeholder="例: オーイシマサヨシの出身地はどこ？"></textarea>
      </label>
      <div class="choice-inputs">
        <label>
          選択肢A
          <input type="text" id="submission-choice-0" maxlength="60" required />
        </label>
        <label>
          選択肢B
          <input type="text" id="submission-choice-1" maxlength="60" required />
        </label>
        <label>
          選択肢C
          <input type="text" id="submission-choice-2" maxlength="60" required />
        </label>
        <label>
          選択肢D
          <input type="text" id="submission-choice-3" maxlength="60" required />
        </label>
      </div>
      <fieldset class="answer-picker">
        <legend>正解</legend>
        <label class="answer-option"><input type="radio" name="submission-answer" value="0" checked /> A</label>
        <label class="answer-option"><input type="radio" name="submission-answer" value="1" /> B</label>
        <label class="answer-option"><input type="radio" name="submission-answer" value="2" /> C</label>
        <label class="answer-option"><input type="radio" name="submission-answer" value="3" /> D</label>
      </fieldset>
      <label>
        解説
        <textarea name="explanation" id="submission-explanation" rows="3" maxlength="400" required placeholder="正解の根拠や豆知識を書いてください"></textarea>
      </label>
      <label>
        お名前(ニックネーム可)
        <input type="text" name="author" id="submission-author" maxlength="50" required placeholder="例: 014ファン" />
      </label>
      <!-- ハニーポット: ボット対策 -->
      <label class="honeypot" aria-hidden="true">
        Webサイト
        <input type="text" name="website" id="submission-website-input" tabindex="-1" autocomplete="off" />
      </label>
      <button type="submit" id="submission-submit-button">投稿する</button>
      <p class="form-message" id="submission-form-message" role="status"></p>
    </form>
  </section>

  <script type="application/json" id="quiz-data" set:html={JSON.stringify(quizQuestions)} />
</Layout>

<script>
  import { supabase } from "../lib/supabase";
  import { generateOwnerToken, hashOwnerToken, saveOwnerToken, getOwnerToken, removeOwnerToken } from "../lib/postOwnership";

  type QuizQuestion = {
    id: string;
    categories: string[];
    question: string;
    choices: string[];
    answerIndex: number;
    explanation: string;
    relatedHref?: string;
    relatedLabel?: string;
    isSubmitted?: boolean;
    difficulty?: "初級" | "中級" | "上級";
  };

  type ShuffledQuestion = {
    id: string;
    categories: string[];
    question: string;
    choices: string[];
    answerIndex: number;
    explanation: string;
    relatedHref?: string;
    relatedLabel?: string;
    isSubmitted?: boolean;
    difficulty: "初級" | "中級" | "上級" | null;
  };

  type Difficulty = "初級" | "中級" | "上級";

  const allQuestions: QuizQuestion[] = JSON.parse(document.getElementById("quiz-data")!.textContent!);
  // みんなの投稿問題は一時的に無効化中(コードは残す)。復活させる際はtrueに戻す。
  // src/pages/quiz.astro frontmatterの submissionsVisible と必ず合わせること。
  const SUBMISSIONS_ENABLED = false;
  // ユーザーが投稿した問題(未検証)。読み込み後、検定本編の出題プールにも合流させる
  // (「投稿問題」バッジで見分けられるようにした上で、混ぜてよいという方針にしたため)。
  let submittedQuestions: QuizQuestion[] = [];

  function playableQuestions(): QuizQuestion[] {
    return SUBMISSIONS_ENABLED ? [...allQuestions, ...submittedQuestions] : allQuestions;
  }

  // 難易度は「みんなの正答率」から動的に決める。サンプル数が少ない質問は
  // 判定を保留し、どの難易度を選んでも出題対象になる(データが無いのに
  // いきなり上級/初級に固定されてしまうのを避けるため)。
  const MIN_SAMPLES = 20;
  const EASY_RATE = 0.7;
  const HARD_RATE = 0.4;
  let statsByQuestionId = new Map<string, { correct: number; total: number }>();

  async function loadStats() {
    const { data, error } = await supabase.from("quiz_stats").select("question_id, correct_count, total_count");
    if (error || !data) return;
    statsByQuestionId = new Map(
      data.map((row: { question_id: string; correct_count: number; total_count: number }) => [
        row.question_id,
        { correct: row.correct_count, total: row.total_count },
      ])
    );
  }

  // サンプル不足の質問は、データ側にあらかじめ設定したdifficulty(仮の難易度)を
  // 使う。それも無ければnullを返し(呼び出し側で「どの難易度でも対象」として扱う)、
  // 20件以上たまったらみんなの正答率による判定に切り替える。
  function computedDifficulty(question: QuizQuestion): Difficulty | null {
    const stats = statsByQuestionId.get(question.id);
    if (!stats || stats.total < MIN_SAMPLES) return question.difficulty ?? null;
    const rate = stats.correct / stats.total;
    if (rate >= EASY_RATE) return "初級";
    if (rate >= HARD_RATE) return "中級";
    return "上級";
  }

  const quizStart = document.getElementById("quiz-start") as HTMLDivElement;
  const startButton = document.getElementById("start-button") as HTMLButtonElement;
  const countOptions = Array.from(document.querySelectorAll<HTMLLabelElement>(".count-option"));
  const quizPanel = document.getElementById("quiz-panel") as HTMLDivElement;
  const progressEl = document.getElementById("quiz-progress") as HTMLParagraphElement;
  const categoryEl = document.getElementById("quiz-category") as HTMLDivElement;
  const difficultyBadge = document.getElementById("difficulty-badge") as HTMLSpanElement;
  const questionEl = document.getElementById("quiz-question") as HTMLHeadingElement;
  const choiceButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".choice-button"));
  const explanationPanel = document.getElementById("quiz-explanation") as HTMLDivElement;
  const verdictEl = document.getElementById("quiz-verdict") as HTMLParagraphElement;
  const explanationTextEl = document.getElementById("quiz-explanation-text") as HTMLParagraphElement;
  const relatedLink = document.getElementById("related-link") as HTMLAnchorElement;
  const nextButton = document.getElementById("next-button") as HTMLButtonElement;
  const flagButton = document.getElementById("flag-button") as HTMLButtonElement;
  const FLAG_BUTTON_DEFAULT_TEXT = "⚠ この解説、事実と違うかも";
  const resultPanel = document.getElementById("quiz-result") as HTMLDivElement;
  const resultRankEl = document.getElementById("result-rank") as HTMLParagraphElement;
  const resultScoreEl = document.getElementById("result-score") as HTMLParagraphElement;
  const resultTimeEl = document.getElementById("result-time") as HTMLParagraphElement;
  const resultMessageEl = document.getElementById("result-message") as HTMLParagraphElement;
  const retryButton = document.getElementById("retry-button") as HTMLButtonElement;
  const resultRanking = document.getElementById("result-ranking") as HTMLDivElement;
  const rankingForm = document.getElementById("ranking-form") as HTMLFormElement;
  const rankingNicknameInput = document.getElementById("ranking-nickname") as HTMLInputElement;
  const rankingSubmitButton = document.getElementById("ranking-submit-button") as HTMLButtonElement;
  const rankingFormMessage = document.getElementById("ranking-form-message") as HTMLParagraphElement;
  const shareButton = document.getElementById("share-button") as HTMLButtonElement;
  const rankingBoardList = document.getElementById("ranking-board-list") as HTMLTableSectionElement;
  const rankingTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".ranking-tab"));
  const countLockNote = document.getElementById("count-lock-note") as HTMLParagraphElement;

  let questions: ShuffledQuestion[] = [];
  let currentIndex = 0;
  let score = 0;
  let answered = false;
  let answerTimes: number[] = [];
  let questionStartTime = 0;
  let questionRevealTimer: ReturnType<typeof setInterval> | null = null;
  let lastAverageTimeMs = 0;
  let lastRankingMode: string | null = null;
  let lastTierRank = "";
  // ランキングに記録した直後だけ、OGPカード付きのシェア用固有URLが手に入る。
  let lastShareRecordId: string | null = null;
  let lastShareNickname = "名無し";

  function shuffle<T>(items: T[]): T[] {
    const arr = [...items];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  // 出題数の選択肢は、選ばれた難易度で絞り込んだ後の問題数に応じて動的に出し分ける
  // (例えば絞り込み後が10問しか無ければ「10問」と「全部」は同じ結果になり
  // 意味が無いため、その数を下回る候補だけを表示する)。
  function setupCountOptions(total: number) {
    for (const option of countOptions) {
      const breakpoint = option.dataset.breakpoint;
      const labelEl = option.querySelector(".count-label") as HTMLElement;
      if (breakpoint === "all") {
        labelEl.textContent = `全部(${total}問)`;
        option.hidden = false;
      } else {
        const n = Number(breakpoint);
        labelEl.textContent = `${n}問`;
        option.hidden = n >= total;
      }
    }
  }

  function selectedCount(poolSize: number): number {
    const checked = document.querySelector<HTMLInputElement>('input[name="quiz-count"]:checked');
    const value = checked?.value ?? "all";
    return value === "all" ? poolSize : Math.min(Number(value), poolSize);
  }

  function selectedDifficulty(): Difficulty | "all" {
    const checked = document.querySelector<HTMLInputElement>('input[name="quiz-difficulty"]:checked');
    return (checked?.value as Difficulty | "all") ?? "all";
  }

  // 初級・上級を選んだ場合は、橋渡しとして中級の問題も2割ほど混ぜる
  // (初級⇔上級の難易度差が急すぎないようにするため)。中級を選んだ場合は
  // 中級のみで絞り込む。データ不足(判定null)の質問は「どの難易度でも出題対象」
  // として、選んだ難易度に関わらず含める。
  const MID_DIFFICULTY_MIX_RATIO = 0.2;

  function filterByDifficulty(pool: QuizQuestion[], difficulty: Difficulty | "all"): QuizQuestion[] {
    if (difficulty === "all") return pool;

    const matchesLevel = (q: QuizQuestion, level: Difficulty) => {
      const l = computedDifficulty(q);
      return l === null || l === level;
    };

    const target = pool.filter((q) => matchesLevel(q, difficulty));
    if (difficulty === "中級") return target;

    // 中級ちょうどの質問(判定null除く)だけを混ぜる候補にする。
    const midCandidates = pool.filter((q) => computedDifficulty(q) === "中級");
    const mixCount = Math.round((target.length * MID_DIFFICULTY_MIX_RATIO) / (1 - MID_DIFFICULTY_MIX_RATIO));
    const mixedIn = shuffle(midCandidates).slice(0, mixCount);
    return [...target, ...mixedIn];
  }

  // ジャンルは「すべて」チェックボックスと個別ジャンルのチェックボックスを
  // 相互連動させる(全部チェック⇔「すべて」チェックが常に一致するようにする)。
  const genreAllInput = document.querySelector<HTMLInputElement>('input[name="quiz-genre"][data-all]')!;
  const genreItemInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="quiz-genre"]:not([data-all])')
  );

  function selectedGenres(): string[] {
    return genreItemInputs.filter((input) => input.checked).map((input) => input.value);
  }

  function filterByGenre(pool: QuizQuestion[], genres: string[]): QuizQuestion[] {
    if (genres.length === 0 || genres.length === genreItemInputs.length) return pool;
    const set = new Set(genres);
    return pool.filter((q) => q.categories.some((c) => set.has(c)));
  }

  genreAllInput.addEventListener("change", () => {
    genreItemInputs.forEach((input) => (input.checked = genreAllInput.checked));
    refreshCountOptions();
  });

  genreItemInputs.forEach((input) => {
    input.addEventListener("change", () => {
      genreAllInput.checked = genreItemInputs.every((i) => i.checked);
      refreshCountOptions();
    });
  });

  // ジャンルごとの問題数を表示する。現在選ばれている難易度で絞り込んだ数を出す
  // (どのジャンルにチェックが入っているかには依存させない=「これを選んだら何問か」がわかるようにする)。
  function updateGenreCounts() {
    const basePool = filterByDifficulty(playableQuestions(), selectedDifficulty());
    const allCountEl = genreAllInput.closest("label")?.querySelector(".genre-count") as HTMLElement | null;
    if (allCountEl) allCountEl.textContent = `(${basePool.length}問)`;
    genreItemInputs.forEach((input) => {
      const countEl = input.closest("label")?.querySelector(".genre-count") as HTMLElement | null;
      if (!countEl) return;
      const n = basePool.filter((q) => q.categories.includes(input.value)).length;
      countEl.textContent = `(${n}問)`;
    });
  }

  function buildQuestions(count: number, pool: QuizQuestion[]): ShuffledQuestion[] {
    return shuffle(pool)
      .slice(0, count)
      .map((q) => {
        const order = shuffle(q.choices.map((_, i) => i));
        return {
          id: q.id,
          categories: q.categories,
          question: q.question,
          choices: order.map((i) => q.choices[i]),
          answerIndex: order.indexOf(q.answerIndex),
          explanation: q.explanation,
          relatedHref: q.relatedHref,
          relatedLabel: q.relatedLabel,
          isSubmitted: q.isSubmitted,
          difficulty: computedDifficulty(q),
        };
      });
  }

  // 問題文を一文字ずつ表示する演出。表示が始まった瞬間を解答タイムの起点にする。
  const QUESTION_REVEAL_MS_PER_CHAR = 45;

  function revealQuestionText(text: string) {
    if (questionRevealTimer !== null) {
      clearInterval(questionRevealTimer);
      questionRevealTimer = null;
    }
    questionEl.textContent = "";
    questionStartTime = performance.now();
    let shown = 0;
    questionRevealTimer = setInterval(() => {
      shown++;
      questionEl.textContent = text.slice(0, shown);
      if (shown >= text.length && questionRevealTimer !== null) {
        clearInterval(questionRevealTimer);
        questionRevealTimer = null;
      }
    }, QUESTION_REVEAL_MS_PER_CHAR);
  }

  function showQuestion() {
    answered = false;
    const q = questions[currentIndex];
    progressEl.textContent = `問 ${currentIndex + 1} / ${questions.length}`;
    categoryEl.innerHTML = "";
    for (const category of q.categories) {
      const badge = document.createElement("span");
      badge.className = "quiz-category";
      badge.textContent = category;
      categoryEl.appendChild(badge);
    }
    if (q.difficulty) {
      difficultyBadge.hidden = false;
      difficultyBadge.textContent = q.difficulty;
      difficultyBadge.dataset.level = q.difficulty;
    } else {
      difficultyBadge.hidden = true;
    }
    revealQuestionText(q.question);
    choiceButtons.forEach((button, i) => {
      const textEl = button.querySelector(".choice-text") as HTMLElement;
      textEl.textContent = q.choices[i] ?? "";
      button.disabled = false;
      button.className = "choice-button";
    });
    explanationPanel.hidden = true;
    flagButton.disabled = false;
    flagButton.textContent = FLAG_BUTTON_DEFAULT_TEXT;
  }

  function handleChoice(index: number) {
    if (answered) return;
    answered = true;
    const q = questions[currentIndex];

    // 表示演出の途中で解答された場合は、残りを即座に全文表示にしてから計測を締める。
    if (questionRevealTimer !== null) {
      clearInterval(questionRevealTimer);
      questionRevealTimer = null;
      questionEl.textContent = q.question;
    }
    answerTimes.push(performance.now() - questionStartTime);

    const correct = index === q.answerIndex;
    if (correct) score++;

    choiceButtons.forEach((button, i) => {
      button.disabled = true;
      if (i === q.answerIndex) button.classList.add("correct");
      else if (i === index) button.classList.add("incorrect");
    });

    // 集計は失敗しても体験に影響しないよう、結果を待たずに投げっぱなしにする。
    void supabase.rpc("record_quiz_answer", { q_id: q.id, was_correct: correct });

    verdictEl.textContent = correct ? "⭕ 正解！" : "❌ 不正解";
    verdictEl.className = `quiz-verdict ${correct ? "is-correct" : "is-incorrect"}`;
    explanationTextEl.textContent = q.explanation;
    if (q.relatedHref) {
      relatedLink.href = q.relatedHref;
      relatedLink.textContent = q.relatedLabel ? `${q.relatedLabel} →` : "関連ページを見る →";
      relatedLink.hidden = false;
    } else {
      relatedLink.hidden = true;
    }
    nextButton.textContent = currentIndex + 1 < questions.length ? "次の問題へ" : "結果を見る";
    explanationPanel.hidden = false;
  }

  type ResultTier = { key: string; rank: string; message: string };

  function resultTier(correctCount: number, total: number): ResultTier {
    const rate = correctCount / total;
    if (rate === 1) {
      return { key: "s", rank: "オーイシマサヨシ級", message: "パーフェクト！あなたは立派なオーイシ博士です🎓" };
    }
    if (rate >= 0.7) {
      return { key: "a", rank: "量産型オーイシ級", message: "なかなかやりますね。これはかなりのオーイシ通！" };
    }
    if (rate >= 0.4) {
      return { key: "b", rank: "オーマイゴシゴシ級", message: "まずまず！オーイシ沼にはまれるチャンス！" };
    }
    return { key: "c", rank: "一般オタク級", message: "まだまだこれから！あなたの知らないオーイシがたくさんいますよ！" };
  }

  function showResult() {
    quizPanel.hidden = true;
    resultPanel.hidden = false;
    resultScoreEl.textContent = `${questions.length}問中 ${score}問正解！`;

    const tier = resultTier(score, questions.length);
    resultPanel.dataset.tier = tier.key;
    resultRankEl.textContent = tier.rank;
    resultMessageEl.textContent = tier.message;
    lastTierRank = tier.rank;
    lastShareRecordId = null;
    // シェアはランキングに記録してからだけ可能にする(記録するまでは非表示)。
    shareButton.hidden = true;

    lastAverageTimeMs =
      answerTimes.length > 0 ? answerTimes.reduce((a, b) => a + b, 0) / answerTimes.length : 0;
    resultTimeEl.textContent = `平均解答タイム: ${(lastAverageTimeMs / 1000).toFixed(1)}秒`;

    // ランキングは、出題数を問わず「難易度・ジャンルどちらも絞り込んでいない」場合のみ対象。
    // 絞り込みがあると回答者ごとに問題プールが変わってしまい、タイム比較が公平でなくなるため。
    const countValue = document.querySelector<HTMLInputElement>('input[name="quiz-count"]:checked')?.value ?? "all";
    const rankingEligible = selectedDifficulty() === "all" && genreAllInput.checked;
    lastRankingMode = rankingEligible ? countValue : null;
    resultRanking.hidden = lastRankingMode === null;
    rankingForm.reset();
    rankingSubmitButton.disabled = false;
    rankingFormMessage.textContent = "";
  }

  function showStart() {
    quizStart.hidden = false;
    quizPanel.hidden = true;
    resultPanel.hidden = true;
  }

  // ジャンル→難易度の順で問題プールを絞り込む(順序による結果の違いはない)。
  function filteredPool(): QuizQuestion[] {
    const genrePool = filterByGenre(playableQuestions(), selectedGenres());
    return filterByDifficulty(genrePool, selectedDifficulty());
  }

  function startQuiz() {
    const pool = filteredPool();
    const count = selectedCount(pool.length);
    questions = buildQuestions(count, pool);
    currentIndex = 0;
    score = 0;
    answerTimes = [];
    quizStart.hidden = true;
    quizPanel.hidden = false;
    resultPanel.hidden = true;
    showQuestion();
  }

  choiceButtons.forEach((button, i) => {
    button.addEventListener("click", () => handleChoice(i));
  });

  nextButton.addEventListener("click", () => {
    if (currentIndex + 1 < questions.length) {
      currentIndex++;
      showQuestion();
    } else {
      showResult();
    }
  });

  // 通報件数はユーザーには見せない(運営がSupabaseダッシュボードで確認するだけ)ので、
  // ここでは押した本人への「送りました」フィードバックだけ返す。
  flagButton.addEventListener("click", async () => {
    const q = questions[currentIndex];
    flagButton.disabled = true;
    flagButton.textContent = "報告しました。ありがとうございます";
    const { error } = await supabase.rpc("flag_quiz_question", { q_id: q.id });
    if (error) {
      flagButton.disabled = false;
      flagButton.textContent = FLAG_BUTTON_DEFAULT_TEXT;
    }
  });

  startButton.addEventListener("click", startQuiz);
  retryButton.addEventListener("click", showStart);

  // 難易度を切り替えたら、出題数の選択肢(「全部」の件数表示など)も
  // 絞り込み後の件数に合わせて更新する。
  const difficultyInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="quiz-difficulty"]'));
  difficultyInputs.forEach((input) => {
    input.addEventListener("change", refreshCountOptions);
  });

  function refreshCountOptions() {
    setupCountOptions(filteredPool().length);
    updateGenreCounts();
  }

  loadStats().then(refreshCountOptions);
  setupCountOptions(allQuestions.length);
  updateGenreCounts();
  showStart();

  // 出題数で「100問」「全部」を選んだ場合は、出題数を確保するためジャンル・
  // 難易度の絞り込みを不可能にする(選択肢を強制的に「すべて」に戻す)。
  const countInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="quiz-count"]'));

  function updatePickerLock() {
    const checked = document.querySelector<HTMLInputElement>('input[name="quiz-count"]:checked');
    const value = checked?.value ?? "all";
    const shouldLock = value === "100" || value === "all";
    countLockNote.hidden = !shouldLock;

    difficultyInputs.forEach((input) => {
      input.disabled = shouldLock;
    });
    genreAllInput.disabled = shouldLock;
    genreItemInputs.forEach((input) => {
      input.disabled = shouldLock;
    });

    if (shouldLock) {
      const allDifficultyInput = difficultyInputs.find((input) => input.value === "all");
      if (allDifficultyInput) allDifficultyInput.checked = true;
      genreAllInput.checked = true;
      genreItemInputs.forEach((input) => (input.checked = true));
    }
    refreshCountOptions();
  }

  countInputs.forEach((input) => {
    input.addEventListener("change", updatePickerLock);
  });
  updatePickerLock();

  // =========================================
  // ランキング(難易度・ジャンルとも「すべて」の場合のみ、任意記録)
  // =========================================
  rankingForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!lastRankingMode) return;
    const nickname = rankingNicknameInput.value.trim();
    if (!nickname) {
      rankingFormMessage.textContent = "ニックネームを入力してください。";
      return;
    }
    rankingSubmitButton.disabled = true;
    const { data, error } = await supabase
      .from("quiz_ranking")
      .insert({
        mode: lastRankingMode,
        nickname,
        score,
        total_questions: questions.length,
        average_time_ms: Math.round(lastAverageTimeMs),
      })
      .select("id")
      .single();
    if (error) {
      rankingFormMessage.textContent = "記録に失敗しました。時間をおいて試してください。";
      rankingSubmitButton.disabled = false;
      return;
    }
    // ランキングに記録できた場合だけ、OGPカード付きのシェア用固有URLを発行できる。
    lastShareRecordId = data?.id ?? null;
    lastShareNickname = nickname;
    shareButton.hidden = false;
    rankingFormMessage.textContent = "ランキングに記録しました！ありがとうございます。";
    await loadRankingBoard(lastRankingMode);
  });

  function escapeHtml(str: string): string {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  async function loadRankingBoard(mode: string) {
    rankingTabs.forEach((tab) => tab.classList.toggle("is-active", tab.dataset.mode === mode));
    rankingBoardList.innerHTML = `<tr><td class="loading-message" colspan="4">読み込み中...</td></tr>`;
    // 正解数が多い順を優先し、同数の場合は平均解答タイムが速い順に並べる。
    const { data, error } = await supabase
      .from("quiz_ranking")
      .select("nickname, score, total_questions, average_time_ms")
      .eq("mode", mode)
      .order("score", { ascending: false })
      .order("average_time_ms", { ascending: true })
      .limit(20);
    if (error || !data) {
      rankingBoardList.innerHTML = `<tr><td class="loading-message" colspan="4">読み込みに失敗しました。</td></tr>`;
      return;
    }
    if (data.length === 0) {
      rankingBoardList.innerHTML = `<tr><td class="loading-message" colspan="4">まだ記録がありません。最初の記録者になりませんか？</td></tr>`;
      return;
    }
    rankingBoardList.innerHTML = "";
    data.forEach(
      (row: { nickname: string; score: number; total_questions: number; average_time_ms: number }, index: number) => {
        const rank = index + 1;
        const tr = document.createElement("tr");
        tr.className = "ranking-row";
        if (rank <= 3) tr.classList.add(`is-rank-${rank}`);
        const avgSec = (row.average_time_ms / 1000).toFixed(1);
        const medal = rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : `${rank}`;
        tr.innerHTML = `
          <td class="col-rank"><span class="ranking-position">${medal}</span></td>
          <td class="col-nickname">${escapeHtml(row.nickname)}</td>
          <td class="col-score">${row.score}/${row.total_questions}</td>
          <td class="col-time">${avgSec}秒</td>
        `;
        rankingBoardList.appendChild(tr);
      }
    );
  }

  rankingTabs.forEach((tab) => {
    tab.addEventListener("click", () => loadRankingBoard(tab.dataset.mode ?? "10"));
  });

  loadRankingBoard("10");

  // =========================================
  // Xでのシェア
  // =========================================
  // ランキングに記録済みなら、OGPカードが展開される専用の結果ページへのリンクを
  // 使う。未記録(または絞り込みありで記録対象外)の場合はテキストのみで共有する。
  shareButton.addEventListener("click", () => {
    if (!lastShareRecordId) return;
    const avgSec = (lastAverageTimeMs / 1000).toFixed(1);
    const params = new URLSearchParams({
      score: String(score),
      total: String(questions.length),
      time: avgSec,
      nickname: lastShareNickname,
      rank: lastTierRank,
    });
    const shareUrl = `https://014-funsite.vercel.app/quiz/result/${lastShareRecordId}?${params.toString()}`;
    // URLは本文中に直接埋め込む(intentの&url=は使わない。使うと本文の末尾に
    // 二重でURLが付いてしまうため)。
    const shareText = [
      `${score}/${questions.length}問正解｜${avgSec}秒`,
      "",
      "オーイシマサヨシ/大石昌良に関する検定、あなたは何問わかる？",
      "あなたも挑戦",
      shareUrl,
      "",
      "#オーイシ検定 #オーイシマサヨシ",
    ].join("\n");

    const intentUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}`;
    window.open(intentUrl, "_blank", "noopener,noreferrer");
  });

  // =========================================
  // みんなの投稿問題
  // =========================================
  const SUBMISSION_OWNER_NS = "quiz_submissions";
  const ANSWER_LETTERS = ["A", "B", "C", "D"];

  type QuizSubmission = {
    id: string;
    category: string;
    question: string;
    choices: string[];
    answer_index: number;
    explanation: string;
    author: string;
    created_at: string;
  };

  const submissionList = document.getElementById("submission-items") as HTMLUListElement;
  const submissionLoading = document.getElementById("submission-loading") as HTMLParagraphElement;
  const submissionForm = document.getElementById("submission-form") as HTMLFormElement;
  const submissionCategoryInput = document.getElementById("submission-category") as HTMLInputElement;
  const submissionQuestionInput = document.getElementById("submission-question") as HTMLTextAreaElement;
  const submissionChoiceInputs = [0, 1, 2, 3].map(
    (i) => document.getElementById(`submission-choice-${i}`) as HTMLInputElement
  );
  const submissionExplanationInput = document.getElementById("submission-explanation") as HTMLTextAreaElement;
  const submissionAuthorInput = document.getElementById("submission-author") as HTMLInputElement;
  const submissionWebsiteInput = document.getElementById("submission-website-input") as HTMLInputElement;
  const submissionSubmitButton = document.getElementById("submission-submit-button") as HTMLButtonElement;
  const submissionFormMessage = document.getElementById("submission-form-message") as HTMLParagraphElement;

  // あなたのセットリスト/イベントレポートと同様、カードはクリックで開閉するアコーディオン形式。
  function renderSubmission(item: QuizSubmission) {
    const li = document.createElement("li");
    li.className = "submission-card";

    const summary = document.createElement("button");
    summary.type = "button";
    summary.className = "submission-summary";
    summary.setAttribute("aria-expanded", "false");
    summary.innerHTML = `
      <span class="submission-summary-text">
        <span class="submission-category"></span>
        <span class="submission-question"></span>
      </span>
      <span class="submission-toggle-icon" aria-hidden="true">▼</span>
    `;
    (summary.querySelector(".submission-category") as HTMLElement).textContent = item.category;
    (summary.querySelector(".submission-question") as HTMLElement).textContent = item.question;
    li.appendChild(summary);

    const details = document.createElement("div");
    details.className = "submission-details";
    details.hidden = true;

    summary.addEventListener("click", () => {
      const expanded = summary.getAttribute("aria-expanded") === "true";
      summary.setAttribute("aria-expanded", String(!expanded));
      details.hidden = expanded;
    });

    const choicesEl = document.createElement("ul");
    choicesEl.className = "submission-choices";
    item.choices.forEach((choice, i) => {
      const choiceLi = document.createElement("li");
      choiceLi.className = i === item.answer_index ? "submission-choice is-answer" : "submission-choice";
      choiceLi.textContent = `${ANSWER_LETTERS[i]}. ${choice}`;
      choicesEl.appendChild(choiceLi);
    });
    details.appendChild(choicesEl);

    const explanation = document.createElement("p");
    explanation.className = "submission-explanation";
    explanation.textContent = item.explanation;
    details.appendChild(explanation);

    const author = document.createElement("p");
    author.className = "submission-author";
    author.textContent = item.author;
    details.appendChild(author);

    const flagButton = document.createElement("button");
    flagButton.type = "button";
    flagButton.className = "flag-button";
    flagButton.textContent = "⚠ この問題、事実と違うかも";
    flagButton.addEventListener("click", async () => {
      flagButton.disabled = true;
      flagButton.textContent = "報告しました。ありがとうございます";
      const { error } = await supabase.rpc("flag_quiz_question", { q_id: item.id });
      if (error) {
        flagButton.disabled = false;
        flagButton.textContent = "⚠ この問題、事実と違うかも";
      }
    });
    details.appendChild(flagButton);

    const ownerToken = getOwnerToken(SUBMISSION_OWNER_NS, item.id);
    if (ownerToken) {
      const actions = document.createElement("div");
      actions.className = "submission-actions";
      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "delete-button";
      deleteButton.textContent = "削除";
      deleteButton.addEventListener("click", async () => {
        if (!confirm("この投稿問題を削除しますか？元に戻せません。")) return;
        deleteButton.disabled = true;
        const { error } = await supabase.rpc("delete_quiz_submission", {
          submission_id: item.id,
          token: ownerToken,
        });
        if (error) {
          alert("削除に失敗しました。時間をおいて再度お試しください。");
          deleteButton.disabled = false;
          return;
        }
        removeOwnerToken(SUBMISSION_OWNER_NS, item.id);
        li.remove();
      });
      actions.appendChild(deleteButton);
      details.appendChild(actions);
    }

    li.appendChild(details);
    return li;
  }

  async function loadSubmissions() {
    submissionLoading.style.display = "";
    const { data, error } = await supabase
      .from("quiz_submissions")
      .select("*")
      .order("created_at", { ascending: false });

    submissionLoading.style.display = "none";

    if (error) {
      submissionLoading.textContent = "問題の読み込みに失敗しました。時間をおいて再度お試しください。";
      submissionLoading.style.display = "";
      return;
    }

    const rows = (data ?? []) as QuizSubmission[];

    // 投稿問題は「投稿問題」バッジ付きで検定本編の出題プールにも合流させる。
    submittedQuestions = rows.map((item) => ({
      id: item.id,
      categories: [item.category],
      question: item.question,
      choices: item.choices,
      answerIndex: item.answer_index,
      explanation: item.explanation,
      isSubmitted: true,
    }));
    refreshCountOptions();

    submissionList.innerHTML = "";
    if (rows.length === 0) {
      const empty = document.createElement("li");
      empty.className = "loading-message empty-message";
      empty.textContent = "まだ投稿がありません。最初の問題を投稿してみませんか?";
      submissionList.appendChild(empty);
      return;
    }
    for (const item of rows) {
      submissionList.appendChild(renderSubmission(item));
    }
  }

  submissionForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (submissionWebsiteInput.value.trim() !== "") {
      return;
    }

    const category = submissionCategoryInput.value.trim();
    const question = submissionQuestionInput.value.trim();
    const choices = submissionChoiceInputs.map((input) => input.value.trim());
    const explanation = submissionExplanationInput.value.trim();
    const author = submissionAuthorInput.value.trim();
    const answerIndex = Number(
      (document.querySelector('input[name="submission-answer"]:checked') as HTMLInputElement | null)?.value ?? "0"
    );

    if (!category || !question || choices.some((c) => !c) || !explanation || !author) {
      submissionFormMessage.textContent = "すべての項目を入力してください。";
      return;
    }

    submissionSubmitButton.disabled = true;
    submissionFormMessage.textContent = "";

    const ownerToken = generateOwnerToken();
    const ownerTokenHash = await hashOwnerToken(ownerToken);
    const { data, error } = await supabase
      .from("quiz_submissions")
      .insert({
        category,
        question,
        choices,
        answer_index: answerIndex,
        explanation,
        author,
        owner_token_hash: ownerTokenHash,
      })
      .select("id")
      .single();

    submissionSubmitButton.disabled = false;

    if (error) {
      submissionFormMessage.textContent = "投稿に失敗しました。時間をおいて再度お試しください。";
      return;
    }

    if (data) saveOwnerToken(SUBMISSION_OWNER_NS, data.id, ownerToken);

    submissionForm.reset();
    submissionFormMessage.textContent = "投稿しました。ありがとうございます!";
    await loadSubmissions();
  });

  if (SUBMISSIONS_ENABLED) loadSubmissions();
</script>

<style>
