---
// 勝手にランキング 一覧ページ(CONTENTS_PLAN.md 2-6)。
// ここではお題ごとのTOP3だけを表示し、投票および全順位の閲覧は
// 詳細ページ(/ranking/[id])で行う。
import Layout from "../../layouts/Layout.astro";
import { rankingQuestions, resolveRankingChoices } from "../../data/ranking";
import { tracks } from "../../data/discography";

function trackFor(slug: string) {
  return tracks.find((t) => t.slug === slug);
}

const questionsForClient = rankingQuestions.map((q) => ({
  id: q.id,
  question: q.question,
  choices: resolveRankingChoices(q)
    .map((c) => {
      const track = trackFor(c.trackSlug);
      return track ? { trackSlug: c.trackSlug, title: track.title } : null;
    })
    .filter((c): c is { trackSlug: string; title: string } => c !== null),
}));
---

<Layout title="勝手にランキング | オーイシマサヨシ非公式ファンサイト">
  <h1>勝手にランキング</h1>
  <p class="note">
    運営が用意したお題の投票結果をTOP3まで見られる一覧です。
    投票や全順位の確認は、各お題の詳細ページから行えます。
  </p>

  <div id="questions"></div>

  <script type="application/json" id="questions-data" set:html={JSON.stringify(questionsForClient)} />
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  type Choice = { trackSlug: string; title: string };
  type Question = { id: string; question: string; choices: Choice[] };

  const questions: Question[] = JSON.parse(document.getElementById("questions-data")!.textContent!);
  const container = document.getElementById("questions") as HTMLDivElement;
  const rankMedals = ["🥇", "🥈", "🥉"];

  function coverEl(): HTMLDivElement {
    const cover = document.createElement("div");
    cover.className = "cover placeholder";
    cover.setAttribute("aria-hidden", "true");
    cover.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/></svg>';
    return cover;
  }

  async function fetchVoteCounts(questionIds: string[]): Promise<Map<string, Map<string, number>>> {
    const { data, error } = await supabase
      .from("ranking_results")
      .select("*")
      .in("question_id", questionIds);

    const byQuestion = new Map<string, Map<string, number>>();
    if (error || !data) return byQuestion;
    for (const row of data as { question_id: string; track_slug: string; votes: number }[]) {
      if (!byQuestion.has(row.question_id)) byQuestion.set(row.question_id, new Map());
      byQuestion.get(row.question_id)!.set(row.track_slug, row.votes);
    }
    return byQuestion;
  }

  async function renderQuestions() {
    container.innerHTML = '<p class="loading-message">読み込み中...</p>';
    const voteCounts = await fetchVoteCounts(questions.map((q) => q.id));
    container.innerHTML = "";

    for (const q of questions) {
      const counts = voteCounts.get(q.id) ?? new Map<string, number>();
      const ranked = [...q.choices]
        .map((c) => ({ ...c, votes: counts.get(c.trackSlug) ?? 0 }))
        .sort((a, b) => b.votes - a.votes)
        .slice(0, 3);
      const totalVotes = [...counts.values()].reduce((sum, v) => sum + v, 0);

      const section = document.createElement("section");
      section.className = "question";

      const heading = document.createElement("h2");
      heading.textContent = q.question;
      section.appendChild(heading);

      const totalEl = document.createElement("p");
      totalEl.className = "total-votes";
      totalEl.textContent = `総投票数: ${totalVotes}票`;
      section.appendChild(totalEl);

      const list = document.createElement("ol");
      list.className = "rank-list";

      ranked.forEach((choice, index) => {
        const li = document.createElement("li");
        li.className = "rank-item";

        const medal = document.createElement("span");
        medal.className = "rank-medal";
        medal.textContent = rankMedals[index] ?? `${index + 1}位`;
        li.appendChild(medal);

        const trackLink = document.createElement("a");
        trackLink.className = "rank-track";
        trackLink.href = `/works/${choice.trackSlug}`;
        trackLink.appendChild(coverEl());
        li.appendChild(trackLink);

        const bodyDiv = document.createElement("div");
        bodyDiv.className = "rank-body";
        const titleLink = document.createElement("a");
        titleLink.className = "rank-title";
        titleLink.href = `/works/${choice.trackSlug}`;
        titleLink.textContent = choice.title;
        bodyDiv.appendChild(titleLink);
        const votesP = document.createElement("p");
        votesP.className = "rank-votes";
        votesP.textContent = `${choice.votes}票`;
        bodyDiv.appendChild(votesP);
        li.appendChild(bodyDiv);

        list.appendChild(li);
      });

      section.appendChild(list);

      const detailLink = document.createElement("a");
      detailLink.className = "detail-link";
      detailLink.href = `/ranking/${q.id}`;
      detailLink.textContent = "全順位を見る・投票する →";
      section.appendChild(detailLink);

      container.appendChild(section);
    }
  }

  renderQuestions();
</script>

<style is:global>
  /* is:global: お題・ランキング項目をブラウザ側JSで動的生成しているため、
     Astroのスコープ付きCSSでは動的要素に適用されない(data-astro-cid-*が付与されないため)。 */
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .loading-message {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .question {
    margin-top: 3rem;
  }

  .question h2 {
    margin-bottom: 0.25rem;
  }

  .total-votes {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin: 0 0 1rem;
  }

  .rank-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rank-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
  }

  .rank-medal {
    flex: none;
    width: 2.5rem;
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .rank-track {
    flex: none;
    width: 3.5rem;
    display: block;
  }

  .cover.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    background: linear-gradient(135deg, #e5ded3, #cfc3af);
    color: var(--color-surface);
  }

  .cover.placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.7;
  }

  .rank-body {
    flex: 1;
    min-width: 0;
  }

  .rank-title {
    display: block;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rank-title:hover {
    color: var(--color-accent);
  }

  .rank-votes {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .detail-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .detail-link:hover {
    text-decoration: underline;
  }
</style>
