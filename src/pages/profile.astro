---
import Layout from "../layouts/Layout.astro";
import TrackCover from "../components/TrackCover.astro";
import { tracks, getAlbumCoverImages } from "../data/discography";

// おすすめ楽曲(手動選定・表示順固定)。掲載順にslugを並べる。
const recommendedSlugs = [
  "kimi-janakya-dame-mitai",
  "uni-verse",
  "namara-menkoi-gal",
  "youkoso-japari-park-kariuta",
  "sign-wa-b",
  "fire-oishi",
  "triangle-oishi",
  "clattanoia",
  "union-oxt",
  "peter-pan-syndrome",
];
const recommendedTracks = recommendedSlugs
  .map((slug) => tracks.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const basicInfo = [
  { label: "名前", value: "大石昌良（おおいし まさよし）" },
  { label: "アニソン名義", value: "オーイシマサヨシ" },
  { label: "生年月日", value: "1980年1月5日" },
  { label: "出身地", value: "愛媛県宇和島市" },
  { label: "血液型", value: "A型" },
  { label: "主な役割", value: "シンガーソングライター／作詞家／作曲家／編曲家" },
];

const identities = [
  { name: "大石昌良", tag: "弾き語り・ソロ", description: "アコースティックギターと歌を軸に、自身の言葉と演奏を届ける名義。繊細な物語性と、一本のギターでバンドのような厚みを生む演奏が魅力。", href: "/works?group=大石昌良" },
  { name: "オーイシマサヨシ", tag: "アニメ・ゲーム", description: "アニメやゲームに寄り添う楽曲を、自ら歌って届ける名義。作品の世界観を短い時間で鮮やかに描き、ライブでは観客を巻き込むエンターテインメントへ変える。", href: "/works?group=オーイシマサヨシ" },
  { name: "Sound Schedule", tag: "スリーピースバンド", description: "ボーカル・ギターを務めるロックバンド。2001年のメジャーデビュー以降、活動休止と再始動を経ながらライブと作品発表を続けている。", href: "/works?group=Sound+Schedule" },
  { name: "OxT", tag: "デジタルロックユニット", description: "サウンドプロデューサーTom-H@ckとのユニット。強靭なロックサウンドとハイトーンボーカルで、数々のアニメ主題歌を担当。", href: "/works?group=OxT" },
];

const timeline = [
  { year: "2001", event: "Sound Scheduleのボーカル・ギターとしてメジャーデビュー。" },
  { year: "2006", event: "Sound Scheduleがいったん解散。ソロ活動へ歩みを進める。" },
  { year: "2008", event: "「大石昌良」名義でソロデビュー。弾き語りを軸に活動を開始。" },
  { year: "2011", event: "Sound Scheduleが再結成。以降、ソロとバンドの活動を並行する。" },
  { year: "2013", event: "TVアニメ『ダイヤのA』主題歌の制作を担当し、アニメ音楽での活動を広げる。" },
  { year: "2014", event: "「君じゃなきゃダメみたい」でオーイシマサヨシ名義の活動を開始。" },
  { year: "2015", event: "Tom-H@ckとOxTを結成。" },
  { year: "2017", event: "作詞・作曲・編曲を担当した「ようこそジャパリパークへ」が広く親しまれる。セルフカバーアルバム『仮歌』も発表。" },
  { year: "2024", event: "オーイシマサヨシ名義で日本武道館ワンマンライブを開催。" },
  { year: "2025", event: "さいたまスーパーアリーナで2日間のワンマンライブ「オーイシSSA」を開催。" },
  { year: "2026", event: "オーイシマサヨシと大石昌良、それぞれの名義で日本武道館公演を予定。" },
];

const stats = [
  { value: tracks.filter((track) => track.group === "大石昌良").length, label: "大石昌良" },
  { value: tracks.filter((track) => track.group === "オーイシマサヨシ").length, label: "オーイシマサヨシ" },
  { value: tracks.filter((track) => track.group === "Sound Schedule").length, label: "Sound Schedule" },
  { value: tracks.filter((track) => track.group === "OxT").length, label: "OxT" },
  { value: tracks.filter((track) => track.group === "楽曲提供").length, label: "楽曲提供" },
];

const strengths = [
  { title: "歌とギター", body: "透明感と力強さを行き来する歌声、ベース音・コード・リズムを同時に鳴らすギター奏法。弾き語りでも音楽の景色を大きく広げます。" },
  { title: "作品を読み解く作曲", body: "物語やキャラクターの魅力をつかみ、作品を知らない人にも届くポップソングへ落とし込む構成力が特徴です。" },
  { title: "作詞・作曲・編曲", body: "自身の歌唱曲だけでなく、アーティスト、声優、アニメ・ゲーム作品へ多数の楽曲を提供。セルフカバーでも別の表情を見せます。" },
  { title: "ライブとトーク", body: "高い演奏力に加え、客席との掛け合いやユーモアを含めて一つのショーを作る、ライブエンターテイナーとしての魅力があります。" },
];

const sources = [
  { href: "https://www.014014.jp/biography", label: "大石昌良／オーイシマサヨシ 公式サイト BIOGRAPHY" },
  { href: "https://www.014014.jp/schedule/live", label: "公式サイト LIVE／EVENTスケジュール" },
  { href: "https://www.jvcmusic.co.jp/-/Profile/A026071.html", label: "ビクターエンタテインメント公式プロフィール" },
];
---

<Layout title="プロフィール | 014 BASE">
  <header class="profile-hero">
    <p class="eyebrow">WHO IS MASAYOSHI OISHI?</p>
    <h1>ひとりの音楽家、<br /><span>いくつもの顔。</span></h1>
    <p class="lead">大石昌良／オーイシマサヨシは、歌い手であり、ギタリストであり、作品を支えるソングライター。弾き語り、バンド、アニソン、楽曲提供——活動の形が変わっても、耳に残るメロディと人を楽しませる音楽を届け続けています。</p>
    <div class="hero-links">
      <a class="primary-link" href="/works">楽曲をたどる</a>
      <a href="/calendar">これからの予定を見る</a>
    </div>
  </header>

  <section class="section-block">
    <div class="section-heading"><p>ACTIVITY</p><h2>4つの活動軸</h2></div>
    <div class="identity-grid">
      {identities.map((identity) => <article class="identity-card">
        <span>{identity.tag}</span><h3>{identity.name}</h3><p>{identity.description}</p>
        <a href={identity.href}>この名義の作品を見る →</a>
      </article>)}
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading"><p>PICK UP</p><h2>まず聴いてほしい10曲</h2></div>
    <div class="recommend-grid">
      {recommendedTracks.map((track) => (
        <a class="recommend-card" href={`/works/${track.slug}`}>
          <TrackCover image={track.image} fallbackImages={getAlbumCoverImages(track)} title={track.title} />
          <div class="recommend-body">
            <p class="recommend-title">{track.title}</p>
            <p class="recommend-meta">{track.group} ・ {track.date}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block profile-facts">
    <div class="section-heading"><p>PROFILE</p><h2>基本情報</h2></div>
    <dl class="info-list">
      {basicInfo.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </section>

  <section class="section-block">
    <div class="section-heading"><p>WHY WE LOVE HIS MUSIC</p><h2>音楽の魅力</h2></div>
    <div class="strength-grid">
      {strengths.map((strength, index) => <article><span>0{index + 1}</span><h3>{strength.title}</h3><p>{strength.body}</p></article>)}
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading"><p>HISTORY</p><h2>活動の歩み</h2></div>
    <ol class="timeline">
      {timeline.map((item) => <li><time>{item.year}</time><p>{item.event}</p></li>)}
    </ol>
  </section>

  <section class="section-block archive-section">
    <div class="section-heading"><p>014 BASE ARCHIVE</p><h2>このサイトでたどれる記録</h2></div>
    <p>登録数はアルバム・映像作品を含みます。情報確認を続けながら更新しています。</p>
    <div class="stats-grid">{stats.map((stat) => <a href="/works"><strong>{stat.value}</strong><span>{stat.label}</span></a>)}</div>
  </section>

  <section class="section-block next-step">
    <div><p class="eyebrow">EXPLORE 014 BASE</p><h2>どこから聴いてみる？</h2><p>作品を探すだけでなく、ファンの言葉やランキングから新しい一曲に出会えます。</p></div>
    <nav><a href="/works">ディスコグラフィー</a><a href="/favorites">みんなの推し曲</a><a href="/ranking">勝手にランキング</a></nav>
  </section>

  <section class="sources">
    <h2>参照元・出典</h2><p>プロフィールと年表は、公開されている一次情報をもとに独自の文章で要約しています。</p>
    <ul>{sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul>
  </section>
</Layout>

<style>
  .profile-hero { padding: clamp(2rem, 6vw, 5rem) 0; max-width: 58rem; }
  .eyebrow, .section-heading > p { margin: 0; color: var(--color-accent); font-size: .75rem; font-weight: 700; letter-spacing: .14em; }
  .profile-hero h1 { margin: .4rem 0 1.25rem; font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: 1.05; letter-spacing: -.04em; }
  .profile-hero h1 span { color: var(--color-accent); }
  .lead { max-width: 48rem; color: var(--color-text-muted); font-size: clamp(1rem, 2vw, 1.15rem); line-height: 2; }
  .hero-links { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .hero-links a { border: 1px solid var(--color-border); border-radius: 999px; padding: .7rem 1.2rem; color: var(--color-text); text-decoration: none; }
  .hero-links .primary-link { border-color: var(--color-accent); background: var(--color-accent); color: white; }
  .section-block { padding: 3rem 0; border-top: 1px solid var(--color-border); }
  .section-heading { margin-bottom: 1.5rem; }
  .section-heading h2 { margin: .25rem 0 0; font-size: clamp(1.6rem, 4vw, 2.4rem); }
  .identity-grid, .strength-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .identity-card { border: 1px solid var(--color-border); border-radius: 12px; padding: 1.4rem; background: var(--color-surface); }
  .identity-card > span { color: var(--color-accent); font-size: .7rem; }
  .identity-card h3 { margin: .3rem 0 .65rem; font-size: 1.3rem; }
  .identity-card p, .strength-grid p { color: var(--color-text-muted); line-height: 1.8; }
  .identity-card a { color: var(--color-accent); font-size: .85rem; text-decoration: none; }
  .recommend-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.25rem; }
  .recommend-card { display: block; text-decoration: none; color: var(--color-text); }
  .recommend-body { padding-top: 0.6rem; }
  .recommend-title { margin: 0; font-weight: 700; font-size: 0.9rem; line-height: 1.4; }
  .recommend-meta { margin: 0.2rem 0 0; color: var(--color-text-muted); font-size: 0.75rem; }
  .recommend-card:hover .recommend-title { color: var(--color-accent); }
  .info-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; margin: 0; }
  .info-list div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--color-border); }
  .info-list dt { color: var(--color-text-muted); font-size: .85rem; }
  .info-list dd { margin: 0; }
  .strength-grid article { padding: 1.5rem 0; }
  .strength-grid article > span { color: var(--color-accent); font-size: .7rem; }
  .strength-grid h3 { margin: .35rem 0; }
  .strength-grid p { margin: 0; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 5rem 1fr; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
  .timeline time { color: var(--color-accent); font-weight: 700; }
  .timeline p { margin: 0; line-height: 1.7; }
  .archive-section > p, .next-step p, .sources { color: var(--color-text-muted); }
  .stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .6rem; margin-top: 1.25rem; }
  .stats-grid a { border: 1px solid var(--color-border); border-radius: 10px; padding: 1rem .5rem; color: var(--color-text); text-align: center; text-decoration: none; }
  .stats-grid strong, .stats-grid span { display: block; }
  .stats-grid strong { color: var(--color-accent); font-size: 1.8rem; }
  .stats-grid span { margin-top: .25rem; font-size: .72rem; }
  .next-step { display: grid; grid-template-columns: 1.2fr .8fr; gap: 2rem; align-items: center; }
  .next-step nav { display: flex; flex-direction: column; }
  .next-step nav a { border-bottom: 1px solid var(--color-border); padding: .8rem 0; color: var(--color-text); text-decoration: none; }
  .next-step nav a::after { content: " →"; color: var(--color-accent); }
  .sources { padding: 2rem 0; font-size: .82rem; }
  .sources h2 { color: var(--color-text); font-size: 1rem; }
  .sources a { color: var(--color-text-muted); }
  @media (max-width: 960px) {
    .recommend-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .identity-grid, .strength-grid, .info-list, .next-step { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .info-list div { grid-template-columns: 6rem 1fr; }
    .timeline li { grid-template-columns: 3.5rem 1fr; gap: .75rem; }
    .recommend-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
