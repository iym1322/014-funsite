---
// イベントレポート(CONTENTS_PLAN.md 2-4)。
// 推し曲コーナーと同じ方針で、投稿機能はデザイン確認用のUIのみ用意している段階。
import Layout from "../layouts/Layout.astro";
import { liveReports } from "../data/live-reports";
import { schedule } from "../data/schedule";
---

<Layout title="イベントレポート | オーイシマサヨシ非公式ファンサイト">
  <h1>イベントレポート</h1>
  <p class="note">
    参戦したライブ・イベントの感想を記録するコーナーです。将来的には、サイトに訪れた方も
    レポートを共有できるようにしたいと考えています。現在表示されているレポートは
    <strong>デザイン確認用のサンプル</strong>で、実際の投稿ではありません。
  </p>

  <section class="post-form">
    <h2>レポートを投稿する</h2>
    <p class="pending-note">投稿機能は準備中です。公開まで今しばらくお待ちください。</p>
    <form id="report-form">
      <label>
        イベント名
        <input type="text" placeholder="例: オーイシ武道館 Vol.2" disabled />
      </label>
      <label>
        感想
        <textarea rows="3" placeholder="参戦した感想を自由に書いてください(セトリの丸写しはご遠慮ください)" disabled></textarea>
      </label>
      <button type="submit">投稿する</button>
    </form>
  </section>

  <section class="post-list">
    <h2>レポート一覧(サンプル)</h2>
    <ul>
      {liveReports.map((report) => {
        const scheduleEvent = report.scheduleDate ? schedule.find((e) => e.date === report.scheduleDate) : undefined;
        return (
          <li class="report-card">
            <p class="report-title">{report.eventTitle}</p>
            <p class="report-meta">
              {report.venue && <span>{report.venue}</span>}
              {scheduleEvent && <a class="calendar-link" href="/calendar">カレンダーで見る →</a>}
            </p>
            <p class="report-author">
              {report.author}
              {report.isSample && <span class="sample-badge">サンプル</span>}
            </p>
            <p class="report-text">{report.body}</p>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>

<script>
  const form = document.getElementById("report-form") as HTMLFormElement;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    alert("投稿機能は準備中です。もうしばらくお待ちください。");
  });
</script>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  h2 {
    font-size: 1.1rem;
    margin: 2rem 0 1rem;
  }

  .post-form {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--color-surface);
  }

  .pending-note {
    color: var(--color-accent);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .post-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .post-form input,
  .post-form textarea {
    font-family: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    resize: vertical;
  }

  .post-form button[type="submit"] {
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    font-family: inherit;
    cursor: pointer;
  }

  .post-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .report-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--color-surface);
  }

  .report-title {
    margin: 0 0 0.3rem;
    font-weight: 700;
  }

  .report-meta {
    margin: 0 0 0.5rem;
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .calendar-link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .report-author {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sample-badge {
    font-size: 0.7rem;
    background: #f4e8de;
    color: #a3663f;
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
  }

  .report-text {
    margin: 0;
    line-height: 1.8;
  }
</style>
