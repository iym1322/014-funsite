---
// イベントレポート(CONTENTS_PLAN.md 2-4)。
// Supabase(live_reportsテーブル)に接続し、実際に投稿・閲覧ができる。
// 投稿は承認なしの即時公開(CONTENTS_PLAN.md 5章の方針)。
import Layout from "../layouts/Layout.astro";
import ScrollToFormButton from "../components/ScrollToFormButton.astro";
import { schedule } from "../data/schedule";

const scheduleOptions = schedule
  .filter((e) => e.type === "live" || e.type === "event")
  .map((e) => ({ date: e.date, title: e.title, note: e.note ?? "", type: e.type }));

const scheduleMonths = [...new Set(scheduleOptions.map((e) => e.date.slice(0, 7)))];
---

<Layout title="イベントレポート | 014 BASE">
  <h1>イベントレポート</h1>
  <p class="note">
    参戦したライブ・イベントの感想を記録するコーナーです。どなたでも投稿できます。
    投稿は承認なしですぐに公開されるため、セトリの丸写しや誹謗中傷など不適切な内容は
    お控えください(発見次第、運営が削除します)。
  </p>

  <section class="post-list">
    <h2>レポート一覧</h2>
    <p class="loading-message" id="loading-message">読み込み中...</p>
    <ul id="post-list"></ul>
  </section>

  <section class="post-form">
    <h2>レポートを投稿する</h2>
    <form id="report-form">
      <fieldset class="event-picker">
        <legend>カレンダーの予定から選ぶ（任意）</legend>
        <p class="field-help">月やキーワードで絞り込めます。予定にないイベントは、下のイベント名に直接入力してください。</p>
        <div class="event-filters">
          <label>
            開催月
            <select id="event-month-filter">
              <option value="">すべての月</option>
              {scheduleMonths.map((value) => {
                const [year, month] = value.split("-");
                return <option value={value}>{year}年{Number(month)}月</option>;
              })}
            </select>
          </label>
          <label>
            イベントを検索
            <input id="event-search-input" type="search" placeholder="例: 武道館、Sound Schedule" autocomplete="off" />
          </label>
        </div>
        <label>
          絞り込み結果
          <select id="event-select">
            <option value="">予定を選択してください</option>
          </select>
        </label>
        <p id="event-result-count" class="field-help" aria-live="polite"></p>
      </fieldset>
      <label>
        イベント名
        <input type="text" name="eventTitle" id="event-title-input" maxlength="100" required placeholder="例: オーイシ武道館 Vol.2" />
      </label>
      <label>
        会場(任意)
        <input type="text" name="venue" id="venue-input" maxlength="100" placeholder="例: 日本武道館" />
      </label>
      <label>
        お名前(ニックネーム可)
        <input type="text" name="author" id="author-input" maxlength="50" required placeholder="例: 014ファン" />
      </label>
      <label>
        感想
        <textarea name="body" id="body-input" rows="4" maxlength="800" required placeholder="参戦した感想を自由に書いてください(セトリの丸写しはご遠慮ください)"></textarea>
      </label>
      <!-- ハニーポット: ボット対策 -->
      <label class="honeypot" aria-hidden="true">
        Webサイト
        <input type="text" name="website" id="website-input" tabindex="-1" autocomplete="off" />
      </label>
      <button type="submit" id="submit-button">投稿する</button>
      <p class="form-message" id="form-message" role="status"></p>
    </form>
  </section>

  <ScrollToFormButton label="レポートを投稿する" />
  <script type="application/json" id="schedule-options-data" set:html={JSON.stringify(scheduleOptions)} />
</Layout>

<script>
  import { supabase } from "../lib/supabase";
  import { generateOwnerToken, hashOwnerToken, saveOwnerToken, getOwnerToken, removeOwnerToken } from "../lib/postOwnership";

  const OWNER_NS = "live_reports";

  type LiveReport = {
    id: string;
    event_title: string;
    schedule_date: string | null;
    venue: string | null;
    author: string;
    body: string;
    created_at: string;
  };

  const eventSelect = document.getElementById("event-select") as HTMLSelectElement;
  const eventMonthFilter = document.getElementById("event-month-filter") as HTMLSelectElement;
  const eventSearchInput = document.getElementById("event-search-input") as HTMLInputElement;
  const eventResultCount = document.getElementById("event-result-count") as HTMLParagraphElement;
  const scheduleOptions = JSON.parse(document.getElementById("schedule-options-data")!.textContent!) as Array<{
    date: string;
    title: string;
    note: string;
    type: "live" | "event";
  }>;
  const eventTitleInput = document.getElementById("event-title-input") as HTMLInputElement;
  const venueInput = document.getElementById("venue-input") as HTMLInputElement;
  const form = document.getElementById("report-form") as HTMLFormElement;
  const authorInput = document.getElementById("author-input") as HTMLInputElement;
  const bodyInput = document.getElementById("body-input") as HTMLTextAreaElement;
  const websiteInput = document.getElementById("website-input") as HTMLInputElement;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
  const formMessage = document.getElementById("form-message") as HTMLParagraphElement;
  const postList = document.getElementById("post-list") as HTMLUListElement;
  const loadingMessage = document.getElementById("loading-message") as HTMLParagraphElement;

  let selectedScheduleDate = "";

  function formatScheduleDate(date: string) {
    const [, month, day] = date.split("-");
    return `${Number(month)}月${Number(day)}日`;
  }

  function updateEventOptions() {
    const month = eventMonthFilter.value;
    const query = eventSearchInput.value.trim().toLocaleLowerCase("ja");
    const currentValue = eventSelect.value;
    const filtered = scheduleOptions.filter((event) => {
      const matchesMonth = !month || event.date.startsWith(month);
      const target = `${event.title} ${event.note}`.toLocaleLowerCase("ja");
      return matchesMonth && (!query || target.includes(query));
    });

    eventSelect.replaceChildren(new Option(filtered.length ? "予定を選択してください" : "該当する予定がありません", ""));
    for (const event of filtered) {
      const venue = event.note ? `｜${event.note}` : "";
      const option = new Option(`${formatScheduleDate(event.date)}｜${event.title}${venue}`, JSON.stringify(event));
      eventSelect.add(option);
    }
    if ([...eventSelect.options].some((option) => option.value === currentValue)) eventSelect.value = currentValue;
    eventResultCount.textContent = `${filtered.length}件の予定を表示しています`;
  }

  eventMonthFilter.addEventListener("change", updateEventOptions);
  eventSearchInput.addEventListener("input", updateEventOptions);
  updateEventOptions();

  eventSelect.addEventListener("change", () => {
    if (!eventSelect.value) {
      selectedScheduleDate = "";
      return;
    }
    const selected = JSON.parse(eventSelect.value) as { date: string; title: string; note: string };
    selectedScheduleDate = selected.date;
    eventTitleInput.value = selected.title;
    venueInput.value = selected.note;
  });

  function renderReport(report: LiveReport) {
    const li = document.createElement("li");
    li.className = "report-card";

    const title = document.createElement("p");
    title.className = "report-title";
    title.textContent = report.event_title;
    li.appendChild(title);

    const meta = document.createElement("p");
    meta.className = "report-meta";
    if (report.venue) {
      const venueSpan = document.createElement("span");
      venueSpan.textContent = report.venue;
      meta.appendChild(venueSpan);
    }
    if (report.schedule_date) {
      const link = document.createElement("a");
      link.className = "calendar-link";
      link.href = "/calendar";
      link.textContent = "カレンダーで見る →";
      meta.appendChild(link);
    }
    li.appendChild(meta);

    const author = document.createElement("p");
    author.className = "report-author";
    author.textContent = report.author;
    li.appendChild(author);

    const body = document.createElement("p");
    body.className = "report-text";
    body.textContent = report.body;
    li.appendChild(body);

    // 自分が投稿したもの(localStorageにトークンが残っているもの)にだけ削除ボタンを出す。
    const ownerToken = getOwnerToken(OWNER_NS, report.id);
    if (ownerToken) {
      const actions = document.createElement("div");
      actions.className = "report-actions";
      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "delete-button";
      deleteButton.textContent = "削除";
      deleteButton.addEventListener("click", async () => {
        if (!confirm("このレポートを削除しますか？元に戻せません。")) return;
        deleteButton.disabled = true;
        const { error } = await supabase.rpc("delete_live_report", { report_id: report.id, token: ownerToken });
        if (error) {
          alert("削除に失敗しました。時間をおいて再度お試しください。");
          deleteButton.disabled = false;
          return;
        }
        removeOwnerToken(OWNER_NS, report.id);
        li.remove();
      });
      actions.appendChild(deleteButton);
      li.appendChild(actions);
    }

    return li;
  }

  async function loadReports() {
    loadingMessage.style.display = "";
    const { data, error } = await supabase
      .from("live_reports")
      .select("*")
      .order("created_at", { ascending: false });

    loadingMessage.style.display = "none";

    if (error) {
      loadingMessage.textContent = "レポートの読み込みに失敗しました。時間をおいて再度お試しください。";
      loadingMessage.style.display = "";
      return;
    }

    postList.innerHTML = "";
    if (!data || data.length === 0) {
      const empty = document.createElement("li");
      empty.className = "loading-message empty-message";
      empty.textContent = "まだレポートがありません。最初のレポートを投稿してみませんか?";
      postList.appendChild(empty);
      return;
    }
    for (const report of data as LiveReport[]) {
      postList.appendChild(renderReport(report));
    }
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (websiteInput.value.trim() !== "") {
      return;
    }

    const eventTitle = eventTitleInput.value.trim();
    const venue = venueInput.value.trim();
    const author = authorInput.value.trim();
    const body = bodyInput.value.trim();

    if (!eventTitle || !author || !body) {
      formMessage.textContent = "イベント名・お名前・感想をすべて入力してください。";
      return;
    }

    submitButton.disabled = true;
    formMessage.textContent = "";

    const ownerToken = generateOwnerToken();
    const ownerTokenHash = await hashOwnerToken(ownerToken);
    const { data, error } = await supabase
      .from("live_reports")
      .insert({
        event_title: eventTitle,
        schedule_date: selectedScheduleDate || null,
        venue: venue || null,
        author,
        body,
        owner_token_hash: ownerTokenHash,
      })
      .select("id")
      .single();

    submitButton.disabled = false;

    if (error) {
      formMessage.textContent = "投稿に失敗しました。時間をおいて再度お試しください。";
      return;
    }

    if (data) saveOwnerToken(OWNER_NS, data.id, ownerToken);

    form.reset();
    selectedScheduleDate = "";
    formMessage.textContent = "投稿しました。ありがとうございます!";
    await loadReports();
  });

  loadReports();
</script>

<style is:global>
  /* is:global: レポート一覧をブラウザ側JSで動的生成しているため、
     Astroのスコープ付きCSSでは動的要素に適用されない(data-astro-cid-*が付与されないため)。 */
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  h2 {
    font-size: 1.1rem;
    margin: 2rem 0 1rem;
  }

  .post-form {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--color-surface);
  }

  .post-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .event-picker {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .event-picker legend {
    padding: 0 0.35rem;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .event-filters {
    display: grid;
    grid-template-columns: minmax(9rem, 0.7fr) minmax(14rem, 1.3fr);
    gap: 0.75rem;
    margin: 0.75rem 0;
  }

  .field-help {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .post-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .post-form input,
  .post-form select,
  .post-form textarea {
    font-family: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    resize: vertical;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .post-form button[type="submit"] {
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    font-family: inherit;
    cursor: pointer;
  }

  .post-form button[type="submit"]:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .form-message {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .loading-message {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .report-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--color-surface);
  }

  .report-title {
    margin: 0 0 0.3rem;
    font-weight: 700;
  }

  .report-actions {
    margin-top: 0.75rem;
  }

  .delete-button {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: #a3663f;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .delete-button:hover {
    border-color: #a3663f;
  }

  .delete-button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .report-meta {
    margin: 0 0 0.5rem;
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .calendar-link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .report-author {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .report-text {
    margin: 0;
    line-height: 1.8;
    white-space: pre-wrap;
  }

  @media (max-width: 640px) {
    .event-filters {
      grid-template-columns: 1fr;
    }
  }
</style>
