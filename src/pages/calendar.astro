---
// カレンダーページ(CONTENTS_PLAN.md 2-5)。
// まずは静的な月表示から着手し、対象は2026年8月のみ(スケジュールデータが
// 揃い次第、他の月にも拡張する想定)。日付計算はタイムゾーン起因のズレを
// 避けるため常にUTCベースで行う。
import Layout from "../layouts/Layout.astro";
import { schedule } from "../data/schedule";

const year = 2026;
const month = 8; // 1-indexed

const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
const firstWeekday = new Date(Date.UTC(year, month - 1, 1)).getUTCDay(); // 0=日曜

const cells: (number | null)[] = [];
for (let i = 0; i < firstWeekday; i++) cells.push(null);
for (let d = 1; d <= daysInMonth; d++) cells.push(d);
while (cells.length % 7 !== 0) cells.push(null);

const weekdayLabels = ["日", "月", "火", "水", "木", "金", "土"];

function eventsOnDay(day: number) {
  const dateStr = `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
  return schedule.filter((e) => e.date === dateStr);
}

const typeLabels = { release: "リリース", live: "ライブ", event: "イベント" };

// 外部カレンダーへの追加(書き込み不要・静的生成のままで実現できるためCONTENTS_PLAN 2-5の中でも先行実装)。
function toCompactDate(dateStr: string) {
  return dateStr.replaceAll("-", "");
}

function addDays(dateStr: string, days: number) {
  const d = new Date(`${dateStr}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

function googleCalendarUrl(e: (typeof schedule)[number]) {
  const start = toCompactDate(e.date);
  const end = toCompactDate(addDays(e.date, 1)); // Googleの終日イベントは終了日を翌日指定
  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: e.title,
    dates: `${start}/${end}`,
  });
  if (e.note) params.set("location", e.note);
  return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

function icsDataUrl(e: (typeof schedule)[number]) {
  const start = toCompactDate(e.date);
  const end = toCompactDate(addDays(e.date, 1));
  const ics = [
    "BEGIN:VCALENDAR",
    "VERSION:2.0",
    "PRODID:-//oishimasayoshi-funsite//calendar//JA",
    "BEGIN:VEVENT",
    `UID:${e.date}-${e.title}@014-funsite`,
    `DTSTART;VALUE=DATE:${start}`,
    `DTEND;VALUE=DATE:${end}`,
    `SUMMARY:${e.title}`,
    e.note ? `LOCATION:${e.note}` : "",
    "END:VEVENT",
    "END:VCALENDAR",
  ]
    .filter(Boolean)
    .join("\r\n");
  return `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
}
---

<Layout title="カレンダー | 014 BASE">
  <h1>カレンダー</h1>
  <p class="note">
    リリース・ライブ・イベントの予定をまとめています。まだ2026年8月分のみの掲載です。
    公開情報をもとにしていますが、最新情報は公式サイト・公式SNSをご確認ください。
  </p>

  <h2 class="month-title">{year}年{month}月</h2>

  <div class="calendar">
    {weekdayLabels.map((w) => <div class="weekday">{w}</div>)}
    {cells.map((day) => (
      <div class={`cell ${day === null ? "empty" : ""}`}>
        {day !== null && (
          <>
            <span class="day-number">{day}</span>
            <ul class="day-events">
              {eventsOnDay(day).map((e) => (
                <li class={`event-${e.type}`}>
                  {e.href ? <a href={e.href}>{e.title}</a> : <span>{e.title}</span>}
                  {e.note && <span class="event-note">{e.note}</span>}
                  <span class="add-to-calendar">
                    <a href={googleCalendarUrl(e)} target="_blank" rel="noopener noreferrer">Googleカレンダー</a>
                    ・
                    <a href={icsDataUrl(e)} download={`${e.date}-${e.title}.ics`}>ICS</a>
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    ))}
  </div>

  <ul class="legend">
    {Object.entries(typeLabels).map(([key, label]) => (
      <li><span class={`dot event-${key}`}></span>{label}</li>
    ))}
  </ul>
</Layout>

<style>
  .note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .month-title {
    margin: 2rem 0 1rem;
  }

  .calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .weekday {
    background: var(--color-surface);
    text-align: center;
    padding: 0.5rem 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .cell {
    background: var(--color-surface);
    min-height: 6rem;
    padding: 0.4rem;
  }

  .cell.empty {
    background: var(--color-bg);
  }

  .day-number {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .day-events {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .day-events li {
    font-size: 0.75rem;
    line-height: 1.4;
    border-left: 3px solid var(--color-accent);
    padding-left: 0.4rem;
  }

  .day-events a {
    color: var(--color-text);
  }

  .day-events a:hover {
    color: var(--color-accent);
  }

  .event-note {
    display: block;
    color: var(--color-text-muted);
  }

  .add-to-calendar {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.65rem;
  }

  .add-to-calendar a {
    color: var(--color-text-muted);
  }

  .add-to-calendar a:hover {
    color: var(--color-accent);
  }

  .event-release {
    border-left-color: #8a6d5c;
  }

  .event-live {
    border-left-color: #5c7a8a;
  }

  .event-event {
    border-left-color: #8a8a5c;
  }

  .legend {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dot {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
  }

  .dot.event-release {
    background: #8a6d5c;
  }

  .dot.event-live {
    background: #5c7a8a;
  }

  .dot.event-event {
    background: #8a8a5c;
  }

  @media (max-width: 640px) {
    .cell {
      min-height: 4rem;
    }
    .day-events li {
      font-size: 0.65rem;
    }
  }
</style>
