---
import Layout from "../layouts/Layout.astro";
import { schedule, type ScheduleEvent } from "../data/schedule";

const years = [2025, 2026, 2027];
const months = Array.from({ length: 12 }, (_, index) => index + 1);
const weekdayLabels = ["日", "月", "火", "水", "木", "金", "土"];
const typeLabels = { release: "リリース", live: "ライブ", event: "イベント" };

function calendarCells(year: number, month: number) {
  const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
  const firstWeekday = new Date(Date.UTC(year, month - 1, 1)).getUTCDay();
  const cells: (number | null)[] = Array(firstWeekday).fill(null);
  for (let day = 1; day <= daysInMonth; day++) cells.push(day);
  while (cells.length % 7 !== 0) cells.push(null);
  return cells;
}

function eventsOnDay(year: number, month: number, day: number) {
  const date = `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
  return schedule.filter((event) => event.date === date);
}

function toCompactDate(date: string) {
  return date.replaceAll("-", "");
}

function addDays(date: string, days: number) {
  const value = new Date(`${date}T00:00:00Z`);
  value.setUTCDate(value.getUTCDate() + days);
  return value.toISOString().slice(0, 10);
}

function googleCalendarUrl(event: ScheduleEvent) {
  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: event.title,
    dates: `${toCompactDate(event.date)}/${toCompactDate(addDays(event.date, 1))}`,
  });
  if (event.note) params.set("location", event.note);
  return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

function icsDataUrl(event: ScheduleEvent) {
  const lines = [
    "BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//014-base//calendar//JA", "BEGIN:VEVENT",
    `UID:${event.date}-${encodeURIComponent(event.title)}@014-base`,
    `DTSTART;VALUE=DATE:${toCompactDate(event.date)}`,
    `DTEND;VALUE=DATE:${toCompactDate(addDays(event.date, 1))}`,
    `SUMMARY:${event.title.replaceAll(",", "\\,")}`,
    event.note ? `LOCATION:${event.note.replaceAll(",", "\\,")}` : "",
    event.sourceUrl ? `URL:${event.sourceUrl}` : "",
    "END:VEVENT", "END:VCALENDAR",
  ].filter(Boolean);
  return `data:text/calendar;charset=utf-8,${encodeURIComponent(lines.join("\r\n"))}`;
}
---

<Layout title="カレンダー | 014 BASE">
  <header class="calendar-intro">
    <p class="eyebrow">SCHEDULE 2025–2027</p>
    <h1>カレンダー</h1>
    <p>2025年から2027年までの主要リリース、ライブ、イベントを月ごとに確認できます。</p>
    <p class="note">公開情報をもとに掲載しています。変更・追加の可能性があるため、参加前に必ず公式情報をご確認ください。</p>
  </header>

  <nav class="year-nav" aria-label="年を選択">
    {years.map((year) => <button type="button" data-year-button={year}>{year}年</button>)}
  </nav>

  <nav class="month-nav" aria-label="月を選択">
    {months.map((month) => <button type="button" data-month-button={month}>{month}月</button>)}
  </nav>

  {years.flatMap((year) => months.map((month) => (
    <section class="month-panel" data-year-panel={year} data-month-panel={month} hidden>
      <div class="month-heading">
        <button class="month-arrow" type="button" data-month-move="-1" disabled={month === 1} aria-label="前の月">←</button>
        <h2>{year}年{month}月</h2>
        <button class="month-arrow" type="button" data-month-move="1" disabled={month === 12} aria-label="次の月">→</button>
      </div>

      <div class="calendar" role="grid" aria-label={`${year}年${month}月`}>
        {weekdayLabels.map((weekday) => <div class="weekday" role="columnheader">{weekday}</div>)}
        {calendarCells(year, month).map((day) => (
          <div class:list={["cell", { empty: day === null, "has-events": day !== null && eventsOnDay(year, month, day).length > 0 }]} role="gridcell">
            {day !== null && <>
              <span class="day-number">{day}</span>
              <ul class="day-events">
                {eventsOnDay(year, month, day).map((event) => (
                  <li class={`event-${event.type}`}>
                    <span class="event-kind">{typeLabels[event.type]}</span>
                    {event.href ? <a class="event-title" href={event.href}>{event.title}</a> : <span class="event-title">{event.title}</span>}
                    {event.note && <span class="event-note">{event.note}</span>}
                    <span class="event-actions">
                      {event.sourceUrl && <a href={event.sourceUrl} target="_blank" rel="noopener noreferrer">公式情報</a>}
                      <a href={googleCalendarUrl(event)} target="_blank" rel="noopener noreferrer">Google</a>
                      <a href={icsDataUrl(event)} download={`${event.date}-${event.title}.ics`}>ICS</a>
                    </span>
                  </li>
                ))}
              </ul>
            </>}
          </div>
        ))}
      </div>

      {schedule.every((event) => !event.date.startsWith(`${year}-${String(month).padStart(2, "0")}`)) &&
        <p class="empty-month">現在、掲載予定はありません。</p>}
    </section>
  )))}

  <ul class="legend">
    {Object.entries(typeLabels).map(([key, label]) => <li><span class={`dot event-${key}`}></span>{label}</li>)}
  </ul>
</Layout>

<script>
  const yearButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-year-button]")];
  const monthButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-month-button]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-month-panel]")];
  const currentYear = new Date().getFullYear();
  let selectedYear = currentYear >= 2025 && currentYear <= 2027 ? currentYear : 2026;
  let selectedMonth = currentYear === selectedYear ? new Date().getMonth() + 1 : 1;

  function showDate(year: number, month: number) {
    selectedYear = Math.min(2027, Math.max(2025, year));
    const safeMonth = Math.min(12, Math.max(1, month));
    selectedMonth = safeMonth;
    panels.forEach((panel) => {
      panel.hidden = Number(panel.dataset.yearPanel) !== selectedYear || Number(panel.dataset.monthPanel) !== safeMonth;
    });
    yearButtons.forEach((button) => {
      const active = Number(button.dataset.yearButton) === selectedYear;
      button.classList.toggle("active", active);
      button.setAttribute("aria-current", active ? "date" : "false");
    });
    monthButtons.forEach((button) => {
      const active = Number(button.dataset.monthButton) === safeMonth;
      button.classList.toggle("active", active);
      button.setAttribute("aria-current", active ? "date" : "false");
    });
    history.replaceState(null, "", `#${selectedYear}-${safeMonth}`);
  }

  yearButtons.forEach((button) => button.addEventListener("click", () => showDate(Number(button.dataset.yearButton), selectedMonth)));
  monthButtons.forEach((button) => button.addEventListener("click", () => showDate(selectedYear, Number(button.dataset.monthButton))));
  document.querySelectorAll<HTMLButtonElement>("[data-month-move]").forEach((button) => {
    button.addEventListener("click", () => {
      const panel = button.closest<HTMLElement>("[data-month-panel]");
      showDate(Number(panel?.dataset.yearPanel), Number(panel?.dataset.monthPanel) + Number(button.dataset.monthMove));
    });
  });

  const hashMatch = location.hash.match(/^#(2025|2026|2027)-(\d{1,2})$/);
  if (hashMatch) {
    selectedYear = Number(hashMatch[1]);
    selectedMonth = Number(hashMatch[2]);
  }
  showDate(selectedYear, selectedMonth);
</script>

<style>
  .calendar-intro { margin-bottom: 1.5rem; }
  .calendar-intro h1 { margin: 0.15rem 0 0.7rem; }
  .eyebrow { margin: 0; color: var(--color-accent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.15em; }
  .note { color: var(--color-text-muted); font-size: 0.88rem; }
  .year-nav, .month-nav { display: flex; gap: 0.35rem; overflow-x: auto; scrollbar-width: thin; }
  .year-nav { margin-bottom: .65rem; }
  .month-nav { padding: 0.25rem 0 0.75rem; }
  .year-nav button, .month-nav button { flex: 0 0 auto; border: 1px solid var(--color-border); border-radius: 999px; padding: 0.5rem 0.8rem; background: var(--color-surface); color: var(--color-text); cursor: pointer; }
  .year-nav button { min-width: 5.5rem; font-weight: 700; }
  .month-nav button { min-width: 3.5rem; }
  .year-nav button.active, .month-nav button.active { border-color: var(--color-accent); background: var(--color-accent); color: white; }
  .month-heading { display: grid; grid-template-columns: 2.5rem 1fr 2.5rem; align-items: center; margin: 1rem 0; }
  .month-heading h2 { margin: 0; text-align: center; }
  .month-arrow { border: 1px solid var(--color-border); border-radius: 50%; width: 2.25rem; height: 2.25rem; background: var(--color-surface); color: var(--color-text); cursor: pointer; }
  .month-arrow:disabled { opacity: 0.3; cursor: default; }
  .calendar { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); border-radius: 10px; overflow: hidden; }
  .weekday { background: var(--color-surface); text-align: center; padding: 0.55rem 0; font-size: 0.78rem; color: var(--color-text-muted); }
  .weekday:first-child { color: #a45c5c; }
  .weekday:nth-child(7) { color: #4f7185; }
  .cell { background: var(--color-surface); min-height: 7rem; padding: 0.45rem; }
  .cell.empty { background: var(--color-bg); }
  .cell.has-events { background: color-mix(in srgb, var(--color-surface) 94%, var(--color-accent)); }
  .day-number { font-size: 0.78rem; color: var(--color-text-muted); }
  .day-events { list-style: none; margin: 0.3rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .day-events li { border-left: 3px solid var(--color-accent); padding-left: 0.4rem; font-size: 0.72rem; line-height: 1.35; }
  .event-kind { display: block; margin-bottom: 0.1rem; color: var(--color-text-muted); font-size: 0.6rem; }
  .event-title { display: block; color: var(--color-text); font-weight: 600; text-decoration: none; }
  a.event-title:hover { color: var(--color-accent); }
  .event-note { display: block; color: var(--color-text-muted); }
  .event-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.2rem; font-size: 0.62rem; }
  .event-actions a { color: var(--color-text-muted); }
  .event-actions a:hover { color: var(--color-accent); }
  .event-release { border-left-color: #9a664f !important; }
  .event-live { border-left-color: #4f788e !important; }
  .event-event { border-left-color: #85854d !important; }
  .empty-month { text-align: center; color: var(--color-text-muted); margin: 1rem 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 1.25rem; list-style: none; margin: 1.25rem 0 0; padding: 0; font-size: 0.82rem; color: var(--color-text-muted); }
  .legend li { display: flex; align-items: center; gap: 0.35rem; }
  .dot { display: inline-block; width: 0.65rem; height: 0.65rem; border-radius: 50%; }
  .dot.event-release { background: #9a664f; }
  .dot.event-live { background: #4f788e; }
  .dot.event-event { background: #85854d; }
  @media (max-width: 720px) {
    .calendar { display: block; border-radius: 8px; }
    .weekday, .cell.empty, .cell:not(.has-events) { display: none; }
    .cell.has-events { min-height: 0; padding: 0.75rem; border-bottom: 1px solid var(--color-border); }
    .cell.has-events:last-child { border-bottom: 0; }
    .day-number { display: block; margin-bottom: 0.35rem; font-size: 0.95rem; font-weight: 700; color: var(--color-text); }
    .day-number::after { content: "日"; }
    .day-events li { font-size: 0.82rem; }
    .event-actions { font-size: 0.72rem; }
  }
</style>
