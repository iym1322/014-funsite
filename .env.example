# Supabaseの接続情報(実際の値は Project Settings → API から取得する)。
# このファイルをコピーして .env を作成し、実際の値を入れること。
# .env はコミットしないこと(.gitignoreで除外済み)。
PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=xxxxx

# YouTube Data API v3のAPIキー(Google Cloud Consoleで発行)。
# 「オーイシ名場面」ページの配信元カルーセル(最新動画の取得)に使う。
# PUBLIC_を付けない = ビルド時にサーバー側でのみ使用し、ブラウザには一切公開しない。
YOUTUBE_API_KEY=xxxxx
